# shell completion for herman (bash)
_herman_projects() {
  local root="${HOME}/.hermes"
  local names="default"
  if [ -d "${root}/profiles" ]; then
    names="${names} $(find "${root}/profiles" -mindepth 1 -maxdepth 1 -type d ! -name '.*' -printf '%f ')"
  fi
  echo "${names}"
}
_herman() {
  local cur prev opts
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev="${COMP_WORDS[COMP_CWORD-1]}"
  opts="-u --use -p --project -l --list -r --remove -i --info -d --doctor -b --backup -x --restore -C --cwd --rename --alias --usage --summary --tidy --logs --audit --unused --status web completion model git access kill stop sync refresh security sec history remove rm delete --stats --delete-message --delete-session --delete-matching --delete-all --session --all --fix --dry-run -y --yes -v --verbose --json -h --help --set --provider --list --refresh --endpoints --endpoint --base-url --probe"
  case "${prev}" in
    -u|--use|-i|--info|-d|--doctor|-r|--remove|-C|--cwd|--usage|--logs|--audit|--alias|remove|rm|delete|history|kill|stop|sync|refresh|security|sec)
      COMPREPLY=( $(compgen -W "$(_herman_projects)" -- "${cur}") ); return 0 ;;
    -b|--backup)
      COMPREPLY=( $(compgen -W "$(_herman_projects) --all" -- "${cur}") ); return 0 ;;
    --delete-message|--delete-session)
      return 0 ;;
    --delete-matching)
      return 0 ;;
    --summary)
      COMPREPLY=( $(compgen -W "usage cache overview $(_herman_projects)" -- "${cur}") ); return 0 ;;
    --endpoint|--base-url|--probe)
      # preset keys come from `herman model <project> --endpoints`; `default` drops base_url
      COMPREPLY=( $(compgen -W "default" -- "${cur}") ); return 0 ;;
    -p|--project|--rename|--from|--alias-name)
      return 0 ;;
  esac
  if [[ "${cur}" == -* ]]; then
    COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") ); return 0
  fi
  COMPREPLY=( $(compgen -W "$(_herman_projects)" -- "${cur}") )
  return 0
}
complete -F _herman herman
