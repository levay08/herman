# ─────────────────────────────── history maintenance ───────────────────────────────
# Deleting history is the only write this tool performs on a Hermes state DB, so it is deliberate:
# it refuses to touch a session that is running right now, takes a WAL-safe backup first, keeps the
# FTS index in step and re-checks integrity before reporting success.


def _live_session_ids(name: str) -> set[str]:
    """Sessions a running process still holds (their transcript must not be rewritten)."""
    live: set[str] = set()
    for path in (profile_home(name) / "runtime" / "active_sessions.json",
                 Path.home() / ".hermes" / "runtime" / "active_sessions.json"):
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        entries = data.get("entries") if isinstance(data, dict) else data
        for e in (entries or []):
            if not isinstance(e, dict):
                continue
            sid = e.get("session_id") or e.get("id")
            pid = e.get("pid")
            try:
                pid = int(pid)
            except (TypeError, ValueError):
                pid = 0
            if sid and pid and _pid_alive(pid):
                live.add(str(sid))
    return live


def history_stats(name: str) -> dict:
    """Counts that describe what a delete would touch."""
    home = profile_home(name)
    out = {"project": name, "db": str(home / "state.db"), "sessions": 0, "messages": 0,
           "usage_rows": 0, "live": sorted(_live_session_ids(name)), "readable": False}
    con = _sqlite_ro(home / "state.db")
    if con is None:
        return out
    try:
        for table, key in (("sessions", "sessions"), ("messages", "messages"),
                           ("session_model_usage", "usage_rows")):
            try:
                out[key] = con.execute(f"select count(*) from {table}").fetchone()[0]
            except sqlite3.Error:
                pass
        out["readable"] = True
    finally:
        con.close()
    return out


def _history_backup(home: Path, label: str = "") -> Path | None:
    """WAL-safe copy of the database before a destructive change (sqlite backup API, never cp).

    Keeps the newest few copies only: these are full database copies, so they add up fast.
    """
    src = _sqlite_ro(home / "state.db")
    if src is None:
        return None
    folder = home / "history-backups"
    label = re.sub(r"[^A-Za-z0-9._-]+", "-", (label or home.name or "default").lstrip(".")) or "default"
    dest = None
    try:
        folder.mkdir(parents=True, exist_ok=True)
        dest = folder / f"{label}-{time.strftime('%Y%m%d-%H%M%S')}.db"
        out = sqlite3.connect(str(dest))
        with out:
            src.backup(out)
        chmod_quiet(dest)              # a full copy of the history: owner only
        out.close()
        keep = sorted(folder.glob(f"{label}-*.db"), key=lambda p: p.stat().st_mtime, reverse=True)[3:]
        for stale in keep:
            try:
                stale.unlink()
            except OSError:
                pass
    except (OSError, sqlite3.Error):
        return None
    finally:
        src.close()
    return dest


def history_delete(name: str, *, message: int | None = None, session: str | None = None,
                   matching: str | None = None, everything: bool = False,
                   dry: bool = False, backup_first: bool = False) -> dict:
    """Delete one message, one session, everything matching a query, or the whole history."""
    home = profile_home(name)
    stats = history_stats(name)
    result: dict = {"project": name, "dry": dry, "deleted": {}, "skipped_live": [],
                    "backup": None, "integrity": None, "db": stats["db"]}
    if not stats["readable"]:
        result["error"] = "state.db is not readable"
        return result
    live = set(stats["live"])
    if backup_first and not dry:
        result["backup"] = _history_backup_pre(name)
        if not result["backup"]:
            result["error"] = "could not write a safety backup"
            return result
    con = sqlite3.connect(str(home / "state.db"), timeout=10)
    con.execute("pragma foreign_keys=on")
    tables = [r[0] for r in con.execute("select name from sqlite_master where type='table'")]
    cols = {t: [r[1] for r in con.execute(f"pragma table_info({t})")] for t in tables}

    def drop_sessions(ids: list[str]) -> int:
        dropped = 0
        for sid in ids:
            if sid in live:
                result["skipped_live"].append(sid)
                continue
            for t, c in cols.items():
                if t == "sessions":
                    continue
                if "session_id" in c:
                    con.execute(f"delete from {t} where session_id=?", (sid,))
                if "parent_session_id" in c:
                    con.execute(f"delete from {t} where parent_session_id=?", (sid,))
            con.execute("update sessions set parent_session_id=null where parent_session_id=?", (sid,))
            n = con.execute("delete from sessions where id=?", (sid,)).rowcount
            dropped += max(n, 0)
        return dropped

    try:
        if message is not None:
            row = con.execute("select session_id from messages where id=?", (message,)).fetchone()
            if row is None:
                result["error"] = f"message {message} not found"
            elif row[0] in live:
                result["error"] = f"session {row[0]} is running now; skip deleting its messages"
            elif dry:
                result["deleted"] = {"messages": 1}
            else:
                con.execute("delete from messages where id=?", (message,))
                if "session_id" in cols.get("messages", []):
                    con.execute("update sessions set message_count ="
                                " (select count(*) from messages where session_id = sessions.id)"
                                " where id = ?", (row[0],))
                result["deleted"] = {"messages": 1}
        elif session:
            if dry:
                result["deleted"] = {"sessions": 1}
            else:
                result["deleted"] = {"sessions": drop_sessions([session])}
        elif matching:
            q = matching.strip()
            ids: list[str] = []
            try:
                ids = [str(r[0]) for r in con.execute(
                    "select distinct m.session_id from messages_fts"
                    " join messages m on m.rowid = messages_fts.rowid"
                    " where messages_fts match ?", ('"' + q.replace('"', ' ') + '"',))]
            except sqlite3.Error:
                ids = [str(r[0]) for r in con.execute(
                    "select distinct session_id from messages where content like ?", (f"%{q}%",))]
            safe = [i for i in ids if i not in live]
            result["skipped_live"] = [i for i in ids if i in live]
            if dry:
                result["deleted"] = {"sessions": len(safe), "would_skip_live": len(result["skipped_live"])}
            else:
                result["deleted"] = {"sessions": drop_sessions(safe)}
        elif everything:
            ids = [str(r[0]) for r in con.execute("select id from sessions")]
            if dry:
                result["deleted"] = {"sessions": len([i for i in ids if i not in live])}
                result["skipped_live"] = [i for i in ids if i in live]
            else:
                result["deleted"] = {"sessions": drop_sessions(ids)}
        else:
            result["error"] = "nothing selected"
        con.commit()
        if not dry and not result.get("error"):
            for tbl in ("messages_fts", "messages_fts_trigram"):
                try:
                    con.execute(f"insert into {tbl}({tbl}) values('rebuild')")
                except sqlite3.Error:
                    pass
            con.commit()
            result["integrity"] = con.execute("pragma integrity_check").fetchone()[0]
            result["fk_violations"] = len(list(con.execute("pragma foreign_key_check")))
    except sqlite3.Error as exc:
        result["error"] = str(exc)
    finally:
        con.close()
    if not dry and not result.get("error"):
        result["after"] = history_stats(name)
    return result


def _history_backup_pre(name: str) -> str | None:
    b = _history_backup(profile_home(name), name)
    return str(b) if b else None


def do_history(name: str, *, stats_only: bool = False, message: int | None = None,
               session: str | None = None, matching: str | None = None,
               everything: bool = False, assume_yes: bool = False, dry: bool = False,
               as_json: bool = False) -> bool:
    """CLI entry point for `herman history`. Returns True when something was deleted."""
    info = history_stats(name)
    if as_json and stats_only:
        print(json.dumps(info, indent=2, ensure_ascii=False))
        return False
    if not stats_only:
        print(dim(f"project {name} · {info['db']}"))
    print(f"history of {bold(name)}: {info['sessions']} sessions · {info['messages']} messages"
          f" · {info['usage_rows']} usage rows")
    for sid in info["live"]:
        print(dim(f"  live session {sid} (never touched)"))
    if stats_only:
        return False
    if not (message is not None or session or matching or everything):
        print(dim("nothing selected: use --delete-message <id>, --delete-session <id>,"
                  " --delete-matching <query> or --delete-all"))
        return False
    if not assume_yes and not dry:
        if not sys.stdin.isatty():
            die("refusing to delete history without --yes (or answer the prompt in a terminal)")
        try:
            answer = input(f"type the project name ({name}) to delete: ").strip()
        except (EOFError, KeyboardInterrupt):
            die("cancelled")
        if answer != name:
            die("cancelled: name did not match")
    res = history_delete(name, message=message, session=session, matching=matching,
                         everything=everything, dry=dry, backup_first=True)
    if as_json:
        print(json.dumps(res, indent=2, ensure_ascii=False))
    else:
        if res.get("error"):
            die(res["error"])
        what = ", ".join(f"{v} {k}" for k, v in (res.get("deleted") or {}).items()) or "nothing"
        print(f"{'would delete' if dry else 'deleted'}: {what}")
        if res.get("skipped_live"):
            print(dim("  skipped (running now): " + ", ".join(res["skipped_live"])))
        if res.get("after"):
            a = res["after"]
            print(dim(f"  now: {a['sessions']} sessions · {a['messages']} messages"))
        if res.get("integrity"):
            print(dim(f"  integrity: {res['integrity']} · fk violations: {res.get('fk_violations')}"))
    return bool(res.get("deleted")) and not res.get("error")



# ───────────────────────────────── sync / refresh ─────────────────────────────────
# herman is a script that reads whatever Hermes installed: after `hermes update` the engine version,
# the data layout, the profiles or the CLI can move underneath it. `herman sync` re-checks every
# assumption herman makes, repairs the harmless ones (state entries, shortcut commands, old files)
# and reports what held, what was synced and what disappeared. Nothing destructive happens without
# --fix, and nothing at all happens when everything already matches.

SYNCED_STATE = ("engine_at_sync", "last_sync", "projects_at_sync")


def _shortcut_body(name: str) -> str:
    return f"#!/bin/sh\nexec {HERMES_BIN} -p {name} \"$@\"\n"


def _required_tables(path: Path) -> dict:
    """Which tables the panel reads exist in a project's state DB."""
    need = {"sessions": False, "messages": False, "session_model_usage": False, "messages_fts": False}
    con = _sqlite_ro(path)
    if con is None:
        return need
    try:
        have = {r[0] for r in con.execute(
            "select name from sqlite_master where type in ('table', 'view')")}
        for k in need:
            need[k] = k in have
    except sqlite3.Error:
        pass
    finally:
        con.close()
    return need


def _panel_pid() -> int:
    """Panel pid from its state file (JSON with pid/port/host) or a bare number."""
    for f in (PID_FILE, HERMAN_CACHE / f"web-{DEFAULT_WEB_PORT}.pid"):
        try:
            raw = f.read_text(encoding="utf-8").strip()
        except OSError:
            continue
        try:
            data = json.loads(raw)
            pid = int(data.get("pid") or 0)
        except (ValueError, AttributeError):
            try:
                pid = int(raw)
            except ValueError:
                pid = 0
        if pid and _pid_alive(pid):
            return pid
    return 0


def sync_report(*, fix: bool = False, dry: bool = False) -> dict:
    """Reconcile herman with the installed Hermes and report what held / moved / is stale."""
    st = load_state()
    projects = list_profiles()
    previous = set(st.get("projects_at_sync") or [])
    engine = engine_version()
    res: dict = {
        "when": time.strftime("%Y-%m-%d %H:%M:%S"), "engine": engine,
        "engine_before": st.get("engine_at_sync") or "", "projects": projects,
        "added": sorted(set(projects) - previous) if previous else [],
        "gone": sorted(previous - set(projects)), "checks": [], "synced": [], "removed": [],
        "warnings": [], "unchanged": [], "fix": fix, "dry": dry,
    }

    before = res["engine_before"]
    if not before:
        res["synced"].append(f"first sync recorded for engine {engine}")
    elif before != engine:
        res["synced"].append(f"engine changed: {before} -> {engine}")
    else:
        res["unchanged"].append(f"engine {engine}")

    # per project: database, tables, skills, memory, config keys
    for nm in projects:
        home = profile_home(nm)
        db = home / "state.db"
        tables = _required_tables(db)
        missing = [k for k, v in tables.items() if not v]
        try:
            skills = len([p for p in (home / "skills").iterdir() if p.is_dir()]) \
                if (home / "skills").is_dir() else 0
        except OSError:
            skills = 0
        try:
            mem = sum(f.stat().st_size for f in (home / "memories").rglob("*") if f.is_file()) \
                if (home / "memories").is_dir() else 0
        except OSError:
            mem = 0
        cfg_keys = [k for k in ("default", "provider", "base_url")
                    if _yaml_scalar(home / "config.yaml", "model", k)]
        res["checks"].append({"project": nm, "home": str(home), "db": db.exists(),
                              "tables_ok": not missing, "missing_tables": missing, "skills": skills,
                              "memory": human_size(mem), "config_keys": cfg_keys})
        if not db.exists():
            res["warnings"].append(f"{nm}: no state.db yet (usage, insights and search stay empty)")
        elif missing:
            res["warnings"].append(f"{nm}: state.db has no {', '.join(missing)}"
                                   " (those panels fall back to empty)")
        if not cfg_keys:
            res["warnings"].append(f"{nm}: config.yaml has no model.* keys (the model board stays empty)")

    # shortcut commands herman relies on (one wrapper per project in ~/.local/bin)
    bin_dir = Path.home() / ".local" / "bin"
    missing_short, retargeted, stale_short, self_named = [], [], [], []
    if bin_dir.is_dir():
        for nm in projects:
            if nm == DEFAULT_HERMES:
                continue          # the root profile is reached through herman itself
            if nm == PROG:
                # A project may carry the tool's own name ("herman"). It must never get a shortcut
                # wrapper: ~/.local/bin/herman is the CLI itself, and writing `hermes -p herman`
                # over it turns every `herman` call into a project session - the tool stops working
                # and only `herman sync --fix` (or ./install.sh) puts the binary back. The panel
                # and every herman subcommand reach that project by name like any other.
                self_named.append(nm)
                continue
            sc = bin_dir / nm
            if not sc.exists():
                missing_short.append(nm)
                continue
            try:
                body = sc.read_text(encoding="utf-8", errors="replace")
            except OSError:
                continue
            if "hermes -p " in body:
                m = re.search(r"exec\s+(\S+)\s+-p\s+" + re.escape(nm), body)
                if m and not Path(m.group(1)).exists():
                    retargeted.append(nm)
        for f in bin_dir.iterdir():
            if not f.is_file() or f.name in projects or f.name in (PROG, "hermes", "hermes-acp"):
                continue
            try:
                body = f.read_text(encoding="utf-8", errors="replace")
                small = f.stat().st_size < 400
            except (OSError, UnicodeDecodeError):
                continue
            if small and "hermes -p " in body:
                stale_short.append(f.name)
    in_box = in_container()
    for nm in missing_short:
        if in_box and not fix:
            res["unchanged"].append(f"shortcut '{nm}' (not needed inside this container)")
            continue
        if fix and not dry:
            try:
                sc = bin_dir / nm
                sc.write_text(_shortcut_body(nm), encoding="utf-8")
                sc.chmod(0o755)
                res["synced"].append(f"shortcut command written for '{nm}'")
                continue
            except OSError as exc:
                res["warnings"].append(f"could not write shortcut for '{nm}': {exc}")
                continue
        res["warnings"].append(f"shortcut command missing for '{nm}' (run `{PROG} sync --fix`)")
    for nm in retargeted:
        if fix and not dry:
            try:
                sc = bin_dir / nm
                sc.write_text(_shortcut_body(nm), encoding="utf-8")
                sc.chmod(0o755)
                res["synced"].append(f"shortcut '{nm}' pointed at a missing engine binary; rewritten")
                continue
            except OSError as exc:
                res["warnings"].append(f"could not rewrite shortcut '{nm}': {exc}")
                continue
        res["warnings"].append(f"shortcut '{nm}' points at a missing engine binary"
                               f" (run `{PROG} sync --fix`)")
    for nm in stale_short:
        if fix and not dry:
            try:
                (bin_dir / nm).unlink()
                res["removed"].append(f"stale shortcut '{nm}' (no such project any more)")
                continue
            except OSError as exc:
                res["warnings"].append(f"could not remove stale shortcut '{nm}': {exc}")
                continue
        res["removed"].append(f"stale shortcut '{nm}' (no such project; `{PROG} sync --fix` removes it)")
    if in_box and (missing_short or retargeted or stale_short):
        res["warnings"] = [w for w in res["warnings"] if "shortcut command missing" not in w]
    if in_container():
        res["unchanged"].append("running from a container image (shortcut wrappers belong to the host)")
    if not (missing_short or retargeted or stale_short):
        res["unchanged"].append(f"shortcut commands "
                                f"({len([p for p in projects if p not in (DEFAULT_HERMES, PROG)])})")
    for nm in self_named:
        res["unchanged"].append(f"project '{nm}' carries the tool's own name: no shortcut wrapper "
                                f"(~/.local/bin/{PROG} must stay the CLI itself)")

    # the tool's own name on PATH must be the herman binary, never a project shortcut
    cli = bin_dir / PROG
    cli_ok = True
    if not cli.exists():
        cli_ok = False
        res["warnings"].append(f"'{PROG}' is not in ~/.local/bin (run ./install.sh from the checkout)")
    else:
        try:
            body = cli.read_text(encoding="utf-8", errors="replace")
            shadowed = cli.stat().st_size < 400 and "hermes -p " in body
        except OSError:
            shadowed = False
        if shadowed:
            cli_ok = False
            if fix and not dry:
                try:
                    shutil.copyfile(THIS_FILE, cli)
                    cli.chmod(0o755)
                    res["synced"].append(f"'{PROG}' on PATH was a project shortcut; the herman binary is back")
                except OSError as exc:
                    res["warnings"].append(f"could not restore the '{PROG}' binary: {exc}")
            else:
                res["warnings"].append(f"'{PROG}' on PATH is a project shortcut, not herman itself"
                                       f" (`{PROG} sync --fix` puts the binary back)")
    if cli_ok:
        res["unchanged"].append(f"'{PROG}' itself on PATH")

    # panel page and the files herman owns
    page = html_path()
    if page.exists():
        res["unchanged"].append("panel page")
        # Run from a checkout: the SERVED page is the installed copy, so a checkout that moved on
        # without ./install.sh would leave the panel behind whatever is committed in the repo.
        src = THIS_FILE.parent / HTML_NAME
        try:
            if src.exists() and src.resolve() != page.resolve():
                if src.read_bytes() != page.read_bytes():
                    res["warnings"].append(f"panel page is older than the checkout ({src}) · "
                                           "run ./install.sh to copy it into place")
                else:
                    res["unchanged"].append("panel page matches the checkout")
        except OSError:
            pass
    else:
        res["warnings"].append(f"panel page missing: {page}")
    for asset, note in (("caduceus.png", "dashboard pattern"), ("models-local.json", "local model catalog")):
        if (HERMAN_SHARE / asset).exists():
            res["unchanged"].append(f"{asset} ({note})")
        elif asset == "caduceus.png":
            res["warnings"].append("caduceus.png missing: the dashboard pattern will not render")
    for legacy in ("models-paas.json", "rod-of-hermes.png"):
        p = HERMAN_SHARE / legacy
        if not p.exists():
            continue
        if fix and not dry:
            try:
                p.unlink()
                res["removed"].append(f"leftover file {legacy} (replaced by a neutral name)")
                continue
            except OSError:
                pass
        res["removed"].append(f"leftover file {legacy} (`{PROG} sync --fix` removes it)")
    res["unchanged"].append("panel token" if (HERMAN_CACHE / "web-token").exists()
                            else "panel token (created by `herman web`)")

    # herman's own saved state: entries for profiles that no longer exist
    dead = sorted({n for n in ([st.get("last")] + list(st.get("history") or []))
                   if n and n not in projects})
    if dead:
        if fix and not dry:
            if st.get("last") in dead:
                st.pop("last", None)
            if st.get("history"):
                st["history"] = [n for n in st["history"] if n in projects]
            if st.get("descriptions"):
                st["descriptions"] = {k: v for k, v in st["descriptions"].items() if k in projects}
            res["removed"].append("saved state entries for removed projects: " + ", ".join(dead))
        else:
            res["removed"].append("saved state entries for removed projects: " + ", ".join(dead)
                                  + f" (`{PROG} sync --fix` clears them)")
    else:
        res["unchanged"].append("saved state")

    # orphaned files: a dead panel's pid file, a cached model list for an endpoint no project uses
    # any more, and temp files an interrupted write left behind. Reported always, removed with --fix.
    orphans: list[tuple[Path, str]] = []
    live_urls = set()
    for nm in projects:
        try:
            live_urls.add(model_endpoint(nm)[1])
        except Exception:
            continue
    for f in sorted(HERMAN_CACHE.glob("web*.pid")):
        pid = 0
        try:
            info = json.loads(f.read_text(encoding="utf-8").strip())
            pid = int((info or {}).get("pid") or 0) if isinstance(info, dict) else int(info or 0)
        except (OSError, ValueError, TypeError):
            pid = 0
        if not (pid and _pid_alive(pid)):
            orphans.append((f, "panel pid file for a process that is gone"))
    cat = HERMAN_CACHE / "models-cache.json"
    if cat.exists():
        try:
            cached = json.loads(cat.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            cached = None
        cached_url = (cached or {}).get("base_url") if isinstance(cached, dict) else None
        if cached_url and cached_url not in live_urls:
            orphans.append((cat, f"cached model list for an endpoint no project uses ({cached_url})"))
    for tmp in sorted(HERMAN_CACHE.glob("*.tmp")):
        orphans.append((tmp, "temp file left by an interrupted write"))
    for path, why in orphans:
        if fix and not dry:
            try:
                path.unlink()
                res["removed"].append(f"{path.name}: {why}")
                continue
            except OSError as exc:
                res["warnings"].append(f"could not remove {path.name}: {exc}")
                continue
        res["removed"].append(f"{path.name}: {why} (`{PROG} sync --fix` clears it)")
    if not orphans:
        res["unchanged"].append("no orphaned files")

    # session leases whose process is gone: Hermes owns that file, so herman reports but never rewrites it
    for nm in projects:
        lease = profile_home(nm) / "runtime" / "active_sessions.json"
        if not lease.exists():
            continue
        try:
            entries = json.loads(lease.read_text(encoding="utf-8")).get("entries") or []
        except (OSError, ValueError, AttributeError):
            continue
        dead = 0
        for e in entries:
            try:
                pid = int((e or {}).get("pid") or 0)
            except (TypeError, ValueError):
                pid = 0
            if not (pid and _pid_alive(pid)):
                dead += 1
        if dead:
            res["warnings"].append(f"{nm}: {dead} stale session lease(s) in runtime/active_sessions.json"
                                   " (Hermes owns that file; herman reports but never rewrites it)")

    # model catalogs: herman asks each project's own endpoint for its LIVE list, so a model added
    # on the provider side is listable, pickable and settable right away instead of waiting for
    # the 12h cache to expire. `sync --fix` writes the refreshed cache and
    # remembers the ids, so the next sync can name exactly what appeared or disappeared.
    seen = st.get("models_at_sync") or {}
    fresh: dict[str, list[str]] = {}
    shared: dict[str, list[str]] = {}
    source: dict[str, str] = {}
    for nm in projects:
        _provider, base, _key = model_endpoint(nm)
        if not base:
            continue
        cat = endpoint_catalog(nm, force=True, persist=(not dry))
        ids = sorted({str(m.get("id") or "") for m in (cat.get("models") or [])
                      if str(m.get("id") or "")})
        if not ids:
            res["warnings"].append(f"{nm}: the endpoint {base} answered no model list"
                                   f" (source: {cat.get('source')}), so the picker only offers the"
                                   " configured model")
            continue
        # Only a LIVE answer may be recorded: a fallback (herman's cache, the engine's cache or the
        # user's own catalog file) is a stale view, and writing it would either hide a new model or
        # report models as gone because the file is behind the endpoint.
        if str(cat.get("source")) != "live":
            res["warnings"].append(f"{nm}: {base} answered no live model list, so this run sees "
                                   f"{len(ids)} ids from {cat.get('source')}; the live list stays "
                                   "authoritative, nothing was recorded or cached")
            continue
        fresh[base] = ids
        source[base] = str(cat.get("source"))
        if nm not in shared.setdefault(base, []):
            shared[base].append(nm)
        # Hermes keeps its own picker cache per profile. herman never writes it (bridge rule):
        # it compares and, when the engine's copy is behind for this endpoint, names the one
        # command that fixes it (the engine refuses that command outside a real terminal).
        eng = profile_home(nm) / "provider_models_cache.json"
        try:
            ecache = json.loads(eng.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        if not isinstance(ecache, dict):
            continue
        host = re.sub(r"^https?://", "", base).split("/")[0]
        behind: list[str] = []
        for fprint, val in ecache.items():
            models = (val or {}).get("models") if isinstance(val, dict) else None
            if not isinstance(models, list) or host not in str(fprint):
                continue          # another provider's list: not this endpoint's business
            have = {str(m) for m in models}
            behind = [i for i in ids if i not in have]
        if behind:
            res["warnings"].append(f"{nm}: Hermes' own picker cache for {host} misses {len(behind)}"
                                   f" of the {len(ids)} live ids (for example {', '.join(behind[:4])});"
                                   f" refresh it in a terminal with `hermes -p {nm} model --refresh`"
                                   " (the engine refuses that command outside a TTY)")

    for base, ids in fresh.items():
        who = ", ".join(shared[base])
        known = list(seen.get(base) or [])
        added = [i for i in ids if i not in known]
        gone = [i for i in known if i not in ids]
        label = f"model list for {who}: {len(ids)} ids from {base} ({source.get(base)})"
        if added or gone:
            bits = []
            if added:
                bits.append(f"+{len(added)} new: " + ", ".join(added[:6])
                            + (" …" if len(added) > 6 else ""))
            if gone:
                bits.append(f"-{len(gone)} gone: " + ", ".join(gone[:6])
                            + (" …" if len(gone) > 6 else ""))
            res["synced"].append(label + " · " + " · ".join(bits))
        elif known:
            res["unchanged"].append(label + " (unchanged)")
        else:
            res["unchanged"].append(label + " (first sync recorded)")

    # runtime facts (reported, never changed from here)
    res["dashboard"] = dashboard_info()
    pid = _panel_pid()
    res["panel"] = {"pid": pid, "running": bool(pid) and _pid_alive(pid), "port": DEFAULT_WEB_PORT,
                    "url": f"http://127.0.0.1:{DEFAULT_WEB_PORT}/"}
    res["hermes_bin"] = HERMES_BIN
    if res["dashboard"]["running"]:
        res["unchanged"].append("dashboard running")

    if not (res["synced"] or res["removed"] or res["warnings"]):
        res["verdict"] = "in sync: nothing changed, every herman function keeps working as it is"
    else:
        bits = []
        if res["synced"]:
            bits.append(f"{len(res['synced'])} synced")
        if res["removed"]:
            bits.append(f"{len(res['removed'])} stale")
        if res["warnings"]:
            bits.append(f"{len(res['warnings'])} to look at")
        res["verdict"] = ", ".join(bits)
    if fix and not dry:
        st["engine_at_sync"] = engine
        st["last_sync"] = time.time()
        st["projects_at_sync"] = projects
        st["models_at_sync"] = fresh
        save_state(st)
    res["catalogs"] = fresh
    return res


def do_sync(*, fix: bool = False, dry: bool = False, as_json: bool = False) -> dict:
    """CLI entry point for `herman sync` (alias: refresh)."""
    res = sync_report(fix=fix, dry=dry)
    if as_json:
        print(json.dumps(res, indent=2, ensure_ascii=False))
        return res
    print(f"{bold('herman sync')} · herman vs the installed Hermes")
    was = res["engine_before"]
    print(f"  engine           {res['engine']}"
          + (f"   (was {was})" if was and was != res["engine"] else "")
          + (f"   · binary {res['hermes_bin']}"))
    print(f"  projects         {len(res['projects'])}: " + ", ".join(res["projects"]))
    if res["added"]:
        print(f"  new since last   " + ", ".join(res["added"]))
    if res["gone"]:
        print(f"  gone since last  " + ", ".join(res["gone"]))
    for c in res["checks"]:
        if "project" not in c:
            continue
        print(f"    {c['project']:<14} state.db {'ok' if c['db'] else 'missing'}"
              f" · tables {'ok' if c['tables_ok'] else 'missing: ' + ','.join(c['missing_tables'])}"
              f" · {c['skills']} skills · memory {c['memory']}"
              f" · model keys {','.join(c['config_keys']) or 'none'}")
    print(dim(f"  dashboard        {'running' if res['dashboard']['running'] else 'stopped'}"
              f" (port {res['dashboard']['port']})"
              f" · panel {'running pid ' + str(res['panel']['pid']) if res['panel']['running'] else 'not running'}"
              f" (port {res['panel']['port']})"))
    for base, ids in (res.get("catalogs") or {}).items():
        print(f"  model list       {len(ids):>4} ids live from {base}"
              + (dim("   (the picker offers them now)") if fix else
                 dim(f"   (`{PROG} sync --fix` caches them for the boards)")))
    for title, key in (("already fine", "unchanged"), ("synced", "synced"),
                       ("stale, removable", "removed"), ("needs attention", "warnings")):
        items = res.get(key) or []
        if not items:
            continue
        print(f"  {title}:")
        for item in items:
            print(dim(f"    - {item}"))
    print(f"  verdict          {res['verdict']}")
    if not fix and (res["removed"] or res["warnings"]):
        print(dim(f"  `{PROG} sync --fix` repairs the harmless ones (shortcuts, stale state, leftover files)"))
    return res


def main(argv: list[str]) -> int:
    if not argv:
        require_hermes()
        do_home()
        return 0

    dry = "--dry-run" in argv
    assume_yes = ("-y" in argv) or ("--yes" in argv)
    verbose = ("-v" in argv) or ("--verbose" in argv)
    as_json = "--json" in argv
    rest = [a for a in argv if a not in
            ("--dry-run", "-y", "--yes", "-v", "--verbose", "--json", "--plain")]

    if not rest:                      # only flags given: show the dashboard
        require_hermes()
        do_home()
        return 0

    def val(flag: str, default=None):
        """Value of a flag. Missing value or another flag ⇒ default (callers decide)."""
        if flag in rest:
            i = rest.index(flag)
            if i + 1 < len(rest):
                nxt = rest[i + 1]
                if nxt == "-" or not nxt.startswith("-"):
                    return nxt
            return default
        return default

    def has(*flags: str) -> bool:
        return any(f in rest for f in flags)

    if rest[0] in ("-h", "--help", "help", "/help", "?"):
        print(HELP)
        return 0
    if rest[0] in ("-V", "--version", "version"):
        print(f"{PROG} {VERSION} · {TAGLINE} · {REPO}")
        return 0
    if rest[0] != "completion":
        require_hermes()          # a manager without the engine cannot do anything

    cmd = rest[0]

    if cmd == "web":
        cmd_web(rest[1:])
        return 0
    if cmd == "completion":
        do_completion(rest[1:])
        return 0

    if cmd in ("remove", "rm", "delete") and len(rest) > 1 and not rest[1].startswith("-"):
        target = rest[1]
        if target not in list_profiles():
            die(f"project '{target}' does not exist (try: {PROG} -l)")
        do_remove(target, assume_yes=assume_yes or dry, dry=dry)
        return 0

    if cmd in ("kill", "stop"):
        args = rest[1:]
        nm = args[0] if args and args[0] in list_profiles() else None
        rest_args = args[1:] if nm else args
        nm = nm or active_profile() or load_state().get("last") or DEFAULT_HERMES
        sid = None
        if rest_args and not rest_args[0].startswith("-"):
            sid = rest_args[0]
        sid = sid or val("--session") or None
        do_kill(nm, session=sid, everything=("--all" in rest), assume_yes=assume_yes,
                dry=dry or ("--dry" in rest), as_json=as_json)
        return 0

    if cmd in ("security", "sec"):
        script = html_path().parent / "security_check.py" if html_path() else None
        if not script or not script.exists():
            die(f"security_check.py is missing next to the panel page (reinstall {PROG})")
        panels = list_panels()
        port = str(panels[0]["port"]) if panels else str(DEFAULT_WEB_PORT)
        argv_sec = [sys.executable, str(script), "--port", port]
        if "--json" in rest or as_json:
            argv_sec.append("--json")
        if "--host" in rest:
            argv_sec += ["--host", rest[rest.index("--host") + 1]]
        return os.spawnv(os.P_WAIT, sys.executable, argv_sec) and 1 or 0

    if cmd in ("sync", "refresh"):
        do_sync(fix=("--fix" in rest), dry=dry or ("--dry" in rest), as_json=as_json)
        return 0

    if cmd == "history":
        args = rest[1:]
        dry = dry or ("--dry" in rest)          # accept both spellings here
        nm = args[0] if args and args[0] in list_profiles() else None
        nm = nm or active_profile() or load_state().get("last") or DEFAULT_HERMES
        try:
            mid = int(val("--delete-message", "0") or 0)
        except TypeError:
            mid = 0
        # A destructive flag must never silently widen its scope: `val()` answers "" when the next
        # token is another flag, so `--delete-matching --delete-all` used to fall through and delete
        # the WHOLE history instead of the matching sessions. Stop and say what is missing.
        matching_arg = val("--delete-matching")
        if "--delete-matching" in rest and (not matching_arg or matching_arg.startswith("-")):
            die("--delete-matching needs a search term (it cannot be empty or look like a flag)")
        session_arg = val("--delete-session")
        if "--delete-session" in rest and (not session_arg or session_arg.startswith("-")):
            die("--delete-session needs a session id (it cannot be empty or look like a flag)")
        do_history(nm, stats_only=("--stats" in rest or not any(
                       k in rest for k in ("--delete-message", "--delete-session",
                                           "--delete-matching", "--delete-all"))),
                   message=mid or None, session=session_arg,
                   matching=matching_arg, everything="--delete-all" in rest,
                   assume_yes=assume_yes, dry=dry, as_json=as_json)
        return 0

    if cmd == "model":
        nm = rest[1] if len(rest) > 1 and not rest[1].startswith("-") else None
        nm = nm or active_profile() or load_state().get("last") or DEFAULT_HERMES
        # --endpoint/--probe take a value that may be absent on purpose (a bare `--probe` tests the
        # endpoint already configured), so the flag and its value are read separately: val() answers
        # the default whenever the next token is another flag, which would look like "no flag".
        ep = next((f for f in ("--endpoint", "--base-url") if f in rest), None)
        do_model(nm, set_model=val("--set"), provider=val("--provider"),
                 list_models="--list" in rest, refresh="--refresh" in rest,
                 list_endpoints=has("--endpoints", "--base-urls"),
                 endpoint=val(ep, "") if ep else None,
                 probe=val("--probe", "") if "--probe" in rest else None,
                 dry=dry)
        return 0

    if cmd == "git":
        args = rest[1:]
        nm = None
        if args and args[0] in list_profiles():
            nm = args[0]
            args = args[1:]
        nm = nm or active_profile() or load_state().get("last") or DEFAULT_HERMES
        sub = args[0] if args and not args[0].startswith("-") else None
        if sub is None and as_json:
            print(json.dumps(git_report(nm), indent=2, ensure_ascii=False))
            return 0
        if sub == "set-workdir":
            do_git(nm, "set-workdir", path=(args[1] if len(args) > 1 else val("--path")), dry=dry)
            return 0
        if sub == "init":
            do_git(nm, "init", dry=dry)
            return 0
        if sub == "set-user":
            do_git(nm, "set-user", user_name=val("--name"), user_email=val("--email"), dry=dry)
            return 0
        if sub == "set-remote":
            do_git(nm, "set-remote",
                   remote_name=(args[1] if len(args) > 1 else val("--remote")),
                   url=(args[2] if len(args) > 2 else val("--url")), dry=dry)
            return 0
        if sub == "rm-remote":
            do_git(nm, "rm-remote",
                   remote_name=(args[1] if len(args) > 1 else val("--remote")), dry=dry)
            return 0
        if sub == "set-helper":
            do_git(nm, "set-helper",
                   helper=(args[1] if len(args) > 1 else val("--helper")), dry=dry)
            return 0
        do_git(nm, None, dry=dry)
        return 0

    if cmd in ("config", "configure", "cfg"):
        args = rest[1:]
        sub = args[0] if args and not args[0].startswith("-") else ""
        area = args[1] if len(args) > 1 and not args[1].startswith("-") else ""
        if not sub or not area:
            # `herman config` reads the active project, `herman config <project>` reads that one:
            # the moment a second word arrives ("chat", "web", "mcp") it is a write, not a read.
            nm = sub if sub in list_profiles() else (active_profile() or load_state().get("last")
                                                     or DEFAULT_HERMES)
            rep = integrations_report(nm)
            if as_json:
                print(json.dumps(rep, indent=2, ensure_ascii=False))
            else:
                print_config_report(rep)
            return 0
        project = sub
        if not profile_exists(project):
            die(f"project '{project}' does not exist (`{PROG} -l` lists them)")
        sets: list[tuple[str, str]] = []
        i = 0
        while i < len(args):
            if args[i] == "--set" and i + 1 < len(args):
                key, eq, raw = args[i + 1].partition("=")
                if not key or not eq:
                    die("--set wants key=value")
                sets.append((key, raw))
                i += 2
                continue
            i += 1
        enable = True if has("--enable") else (False if has("--disable") else None)
        if area == "chat":
            platform = args[2] if len(args) > 2 and not args[2].startswith("-") else ""
            if not platform:
                die(f"usage: {PROG} config {project} chat <platform> "
                    f"--enable|--disable|--token|--set key=value|--clear-token")
            token = secret_input(f"token for {platform}") if has("--token") else ""
            config_chat(project, platform, enable=enable, token=token,
                        clear_token=has("--clear-token"), sets=sets, assume_yes=assume_yes, dry=dry)
            return 0
        if area == "web":
            key = val("--key") or ""
            config_web(project, sets=sets, key=key,
                       key_value=secret_input(f"value for {key}") if key else "",
                       unset_key=val("--unset-key") or "", assume_yes=assume_yes, dry=dry)
            return 0
        if area == "mcp":
            act = args[2] if len(args) > 2 and not args[2].startswith("-") else ""
            if act in ("add", "rm", "enable", "disable"):
                server = args[3] if len(args) > 3 and not args[3].startswith("-") else ""
                if not server:
                    die(f"usage: {PROG} config {project} mcp {act} <server>")
                config_mcp(project, act, server, url=val("--url") or "",
                           command=val("--command") or "", args=val("--args") or "",
                           enable=enable, assume_yes=assume_yes, dry=dry)
                return 0
            die(f"usage: {PROG} config {project} mcp add|rm|enable|disable <server>")
        die(f"unknown area '{area}': chat, web or mcp")

    if cmd == "access":
        args = rest[1:]
        sub = args[0] if args and not args[0].startswith("-") else ""

        def secret(prompt_text: str) -> str:
            val_ = os.environ.pop("HERMAN_SECRET", None)
            if val_:
                return val_
            if sys.stdin.isatty():
                import getpass
                return getpass.getpass(prompt_text + ": ")
            return sys.stdin.read().strip()

        if not sub or sub in list_profiles():
            nm = sub or active_profile() or load_state().get("last") or DEFAULT_HERMES
            rep = access_report(nm)
            if as_json:
                print(json.dumps(rep, indent=2, ensure_ascii=False))
            else:
                print()
                print_access_report(rep)
            return 0
        if sub == "revoke-agent" and len(args) > 1:
            access_revoke("agent", args[1], dry=dry)
            return 0
        if sub == "revoke-key" and len(args) > 1:
            access_revoke("key", args[1], assume_yes=assume_yes, dry=dry)
            return 0
        if sub == "revoke-host" and len(args) > 1:
            access_revoke("host", args[1], assume_yes=assume_yes, dry=dry)
            return 0
        if sub == "unset-env" and len(args) > 2:
            os.environ["HERMAN_ENV_VAR"] = args[2]
            access_revoke("env", args[1], assume_yes=assume_yes, dry=dry)
            return 0
        if sub == "set-env" and len(args) > 2:
            proj, var = args[1], args[2]
            value = args[3] if len(args) > 3 else secret(f"value for {var}")
            access_set_env(proj, var, value, dry=dry)
            return 0
        if sub == "gitcred-add" and len(args) > 2:
            host, user = args[1], args[2]
            token = args[3] if len(args) > 3 else secret(f"token for {user}@{host}")
            access_gitcred("add", host, user=user, token=token,
                           scheme=(val("--scheme", "https") or "https"), dry=dry)
            return 0
        if sub == "gitcred-rm" and len(args) > 1:
            access_gitcred("remove", args[1], dry=dry)
            return 0
        if sub == "grant" and len(args) > 1:
            spec = args[1]
            if "@" not in spec:
                die("usage: " + f"{PROG} access grant <user@host> [--password-stdin]")
            user, _, host = spec.partition("@")
            pw = sys.stdin.readline().rstrip("\n") if "--password-stdin" in rest else None
            state, msg, steps = access_grant(user, host, password=pw, dry=dry)
            for s in steps:
                print(dim("  " + s))
            if state == "need_password":
                if not sys.stdin.isatty():
                    die(f"{user}@{host} asks for a password; pipe it with --password-stdin")
                try:
                    pw = getpass.getpass(f"password for {user}@{host}: ")
                except (EOFError, KeyboardInterrupt):
                    die("cancelled")
                state, msg, steps = access_grant(user, host, password=pw)
                print(dim("  " + steps[-1]))
            if state == "error":
                die(msg)
            ok(f"ssh access ready: {user}@{host}")
            return 0
        if sub == "new-key" and len(args) > 1:
            access_create("key", label=args[1], assume_yes=assume_yes, dry=dry)
            return 0
        if sub == "new-host":
            access_create("host", label=val("--alias", "") or "", hostname=val("--hostname", "") or "",
                          user=val("--user", "") or "", port=val("--port", "") or "",
                          identity=val("--identity", "") or "", assume_yes=assume_yes, dry=dry)
            return 0
        if sub == "edit-host" and len(args) > 1:
            access_edit_host(args[1], hostname=val("--hostname", "") or "", user=val("--user", "") or "",
                             identity=val("--identity", "") or "", port=val("--port", "") or "",
                             dry=dry)
            return 0
        if sub == "add-agent" and len(args) > 1:
            access_create("agent", identity=args[1], assume_yes=assume_yes, dry=dry)
            return 0
        die("usage: " + f"{PROG} access [project] | revoke-agent <key> | revoke-key <key> | "
            f"revoke-host <alias> | unset-env <project> <VAR> | set-env <project> <VAR> [value] | "
            f"new-key <label> | new-host --alias a --hostname h | edit-host <alias> [--hostname h] | "
            f"add-agent <key> | gitcred-add <host> <user> [token] | gitcred-rm <host>")

    if has("--activate"):
        do_activate(val("--activate") or (rest[1] if len(rest) > 1 and not rest[1].startswith("-") else None),
                    dry=dry)
        return 0
    if has("--status"):
        do_status(as_json=as_json)
        return 0
    if has("--unused"):
        do_unused(days=int(val("--unused", 30) or 30))
        return 0
    if has("--audit"):
        do_audit(val("--audit") or (rest[1] if len(rest) > 1 and not rest[1].startswith("-") else None))
        return 0
    if has("--logs"):
        name = val("--logs") or (rest[1] if len(rest) > 1 and not rest[1].startswith("-") else None)
        if not name:
            die("name a project: " + f"{PROG} --logs <name>")
        do_logs(name, follow=has("-f", "--follow"), lines=int(val("-n", 40) or 40), dry=dry)
        return 0
    if has("--tidy"):
        name = val("--tidy")
        do_tidy([name] if name else [], dry=dry, all_profiles=has("--all") or not name)
        return 0
    if has("--usage"):
        name = val("--usage")
        do_usage(name or (rest[1] if len(rest) > 1 and not rest[1].startswith("-") else None),
                 days=int(val("--days", 30) or 30), dry=dry)
        return 0
    if has("--summary"):
        i = rest.index("--summary")
        scope = rest[i + 1] if i + 1 < len(rest) and not rest[i + 1].startswith("-") else ""
        name = rest[i + 2] if i + 2 < len(rest) and not rest[i + 2].startswith("-") else None
        do_summary(scope, name)
        return 0
    if "--describe" in rest:
        i = rest.index("--describe")
        name = rest[i + 1] if i + 1 < len(rest) and not rest[i + 1].startswith("-") else ""
        if not name:
            die("usage: " + f"{PROG} --describe <project> [\"text\"] [--clear]")
        ensure_profile(name)
        text = "" if "--clear" in rest else " ".join(rest[i + 2:])
        if text or "--clear" in rest:
            stored = set_description(name, text, dry=dry)
            if stored:
                ok(f"description of {name}: {stored}")
            else:
                ok(f"description of {name} cleared")
        else:
            cur = description(name)
            print(f"{name}: " + (cur if cur else "(no description)"))
        return 0

    if has("--rename"):
        i = rest.index("--rename")
        if i + 2 >= len(rest):
            die("usage: " + f"{PROG} --rename <old> <new>")
        do_rename(rest[i + 1], rest[i + 2], dry=dry)
        return 0
    if has("--alias", "--alias-remove"):
        if has("--alias-remove"):
            i = rest.index("--alias-remove")
            name = rest[i + 1] if i + 1 < len(rest) else None
            if not name:
                die("usage: " + f"{PROG} --alias-remove <name>")
            do_alias(name, remove=True, dry=dry)
            return 0
        name = val("--alias")
        if not name:
            die("usage: " + f"{PROG} --alias <name> [--alias-name x]")
        do_alias(name, alias_name=val("--alias-name"), dry=dry)
        return 0

    if has("-l", "--list"):
        do_list(as_json=as_json)
        return 0
    if has("-p", "--project", "--create"):
        name = val("-p") or val("--project") or val("--create")
        if not name:
            die("usage: " + f"{PROG} -p <name> [--clone|--clone-all|--from <source>]")
        do_create(name,
                  clone=has("--clone"),
                  clone_all=has("--clone-all"),
                  clone_from=val("--from"),
                  no_alias=has("--no-alias"),
                  no_skills=has("--no-skills"),
                  dry=dry)
        return 0
    if has("-r", "--remove"):
        name = val("-r") or val("--remove")
        if not name:
            die("usage: " + f"{PROG} -r <name>")
        do_remove(name, assume_yes=assume_yes or dry, dry=dry)
        return 0
    if has("-i", "--info"):
        name = val("-i") or val("--info")
        if not name and len(rest) > 1 and not rest[1].startswith("-"):
            name = rest[1]
        if name:
            ensure_profile(name)
            print()
            print_info_card(profile_stats(name))
        else:
            for st in stats_all():
                print()
                print_info_card(st)
        return 0
    if has("-d", "--doctor"):
        name = None if has("--all") else (val("-d") or val("--doctor"))
        do_doctor([name] if name else [], dry=dry, all_profiles=has("--all") or not name)
        return 0
    if has("-b", "--backup"):
        name = val("-b") or val("--backup")
        names = list_profiles() if has("--all") else ([name] if name else [])
        if not names and len(rest) > 1 and not rest[1].startswith("-"):
            names = [rest[1]]
        if not names:
            die("usage: " + f"{PROG} -b <name>  or  {PROG} -b --all")
        made = do_backup(names, dry=dry)
        if not dry and made:
            print()
            ok(f"{len(made)} backup file(s) ready")
        return 0
    if has("-x", "--restore"):
        arch = val("-x") or val("--restore")
        if not arch and len(rest) > 1 and not rest[1].startswith("-"):
            arch = rest[1]
        if not arch:
            die("usage: " + f"{PROG} -x <file.tar.gz> [--as name]")
        do_restore(arch, name=val("--as"), dry=dry, assume_yes=assume_yes)
        return 0
    if has("-C", "--cwd"):
        i = rest.index("-C") if "-C" in rest else rest.index("--cwd")
        if i + 1 >= len(rest):
            die("usage: " + f"{PROG} -C <name> [path]")
        name = rest[i + 1]
        path = rest[i + 2] if i + 2 < len(rest) and not rest[i + 2].startswith("-") else None
        do_cwd(name, path, dry=dry)
        return 0
    if has("-u", "--use"):
        i = rest.index("-u") if "-u" in rest else rest.index("--use")
        name = rest[i + 1] if i + 1 < len(rest) and not rest[i + 1].startswith("-") else None
        if name is None and not has("-q", "-f"):
            rows = stats_all()
            if not rows:
                do_home()
                return 0
            if len(rows) == 1:
                name = rows[0]["name"]
            else:
                name = do_pick(rows)
                if name is None:
                    do_list()
                    return 0
        do_use(name, question=val("-q", None), file=val("-f", None),
               verbose=verbose, dry=dry, assume_yes=assume_yes,
               close_others="--close-others" in rest)
        return 0

    if not cmd.startswith("-"):
        do_use(cmd, question=val("-q", None), file=val("-f", None),
               verbose=verbose, dry=dry, assume_yes=assume_yes,
               close_others="--close-others" in rest)
        return 0

    die(f"unknown command: {' '.join(rest)}\nSee: {PROG} -h")


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except BrokenPipeError:
        sys.exit(0)
    except KeyboardInterrupt:
        print()
        sys.exit(130)
