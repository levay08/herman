def mcp_report(name: str) -> dict:
    """MCP servers already written into this project's config.yaml - nothing is contacted."""
    cfg = profile_home(name) / "config.yaml"
    block = _yaml_block(cfg, "mcp_servers") if cfg.exists() else {}
    servers = []
    for srv, fields in block.items():
        if not isinstance(fields, dict):
            continue
        url = fields.get("url") or ""
        cmd = fields.get("command") or ""
        args = fields.get("args")
        target = url or " ".join(str(x) for x in ([cmd] + (args if isinstance(args, list) else ([args] if args else []))) if x)
        servers.append({
            "name": srv,
            "transport": "http" if url else ("stdio" if cmd else "?"),
            "target": target or "-",
            "auth": str(fields.get("auth") or "-"),
            "enabled": str(fields.get("enabled", "true")),
            "fields": sorted(k for k in fields if k != "args"),
        })
    return {
        "project": name,
        "config": str(cfg),
        "config_exists": cfg.exists(),
        "key": "mcp_servers",
        "count": len(servers),
        "servers": servers,
        "commands": [{"command": c, "connects": con, "what": w} for c, con, w in MCP_COMMANDS],
    }


def integrations_report(name: str) -> dict:
    """Options for connecting this project outwards: chat platforms and web search backends.

    Read-only by design: every row reports the value found in the project config.yaml / .env and
    the exact command that would change it. herman never enables, connects or logs in by itself -
    the operator (or the published app's user) decides.
