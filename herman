def set_active_profile(name: str, *, dry: bool = False) -> tuple[bool, str]:
    """Make a project Hermes' sticky default (the profile a bare `hermes` starts in).

    Always shells out to `hermes profile use <name>`; never writes active_profile itself.
    Returns (ok, name-or-error).
    """
    target = resolve_target((name or "").strip())
    if not target:
        return False, "no project given"
    if not profile_exists(target):
        return False, f"project '{target}' does not exist"
    args = ["profile", "use", target]
    if dry:
        print(dim("  [dry-run] " + " ".join(hermes_cmd(args))))
        return True, target
    res = run_hermes(args, quiet=True)
    if res.returncode != 0:
        return False, ((res.stderr or res.stdout or "").strip() or "hermes profile use failed")
    return True, target


