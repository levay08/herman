def shape_error(key: str, value: str, rule: dict) -> str:
    """The line the panel and the CLI print for a parameter that broke its shape rule.

    One clause per fact: the rule with an example, what is never allowed there, the characters this
    value actually carried when the rule knows its allowed set, and the length when that is what broke
    it. A bare 'unexpected shape' tells an operator nothing about what to type instead.
    """
    parts = [f"parameter '{key}' must be {rule['rule']}", rule["not"]]
    safe = shape_class(rule.get("safe") or "")
    if safe:
        bad = [c for c in dict.fromkeys(value) if c not in safe]
        if bad:
            shown = ", ".join("space" if c == " " else repr(c) for c in bad[:6])
            if len(bad) > 6:
                shown += f" and {len(bad) - 6} more"
            parts.append(f"this value carries: {shown}")
    if rule.get("max") and len(value) > rule["max"]:
        parts.append(f"this value is {len(value)} characters long")
    return " · ".join(parts)


def cmd_web(argv: list[str]):
    port = DEFAULT_WEB_PORT
    host = "127.0.0.1"
    open_browser = True
    if "--port" in argv:
        port = int(argv[argv.index("--port") + 1])
    if "--host" in argv:
        host = argv[argv.index("--host") + 1]
    if not is_loopback_host(host) and "--allow-external" not in argv:
        # A loopback bind is the only safe default: the panel is authorized by a token in a URL and
        # speaks plain HTTP (no TLS), so on a network interface anyone who can reach the port can
        # try to brute force or sniff it. Binding elsewhere has to be an explicit decision.
        die(f"refusing to bind {host}: the panel is token-only over plain HTTP, so it belongs on "
            f"loopback. Use --allow-external if you really mean to expose port {port} on {host}.")
    if not is_loopback_host(host):
        print(amber(f"warning: the panel is reachable from the network on {host}:{port} over plain "
                    f"HTTP; keep it on a trusted LAN or tunnel it over SSH"))
    if "--no-open" in argv:
        open_browser = False
    if "--status" in argv:
        panels = list_panels()
        if not panels:
            print(amber("web panel is stopped"))
            print(dim(f"  start it: {PROG} web"))
            return
        for p in panels:
            print(green("web panel running") + f"   pid {p['pid']}   port {p['port']}")
            print_panel_url(p)
        return
    if "--url" in argv:                       # script friendly: plain text, no escapes
        panels = [x for x in list_panels() if x["port"] == port] or list_panels()
        if not panels:
            sys.exit(1)
        print(panel_url(panels[0]))
        return
    if "--stop" in argv:
        want = port if "--port" in argv else None
        panels = [x for x in list_panels() if want is None or x["port"] == want]
        if not panels:
            print(amber("web panel is not running"))
            return
        for x in panels:
            try:
                os.kill(x["pid"], signal.SIGTERM)
                print(green("✓ ") + f"web panel stopped  pid {x['pid']}  port {x['port']}")
            except OSError:
                print(amber(f"panel on port {x['port']} was already gone"))
            x["file"].unlink(missing_ok=True)
        return

    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
    from urllib.parse import urlparse, parse_qs

    token = ensure_token()
    page = html_path()
    if not page.exists():
        die(f"panel page not found: {page} (reinstall {PROG})")

    SECURITY_HEADERS = (
        # Every response, including errors, carries these: no sniffing, no framing, no referrer
        # (the panel lives behind a token in its URL, so a leaked Referer is a leaked token) and a
        # content policy that allows exactly the panel's own inline page and nothing remote.
        ("X-Content-Type-Options", "nosniff"),
        ("Referrer-Policy", "no-referrer"),
        ("X-Frame-Options", "DENY"),
        ("Content-Security-Policy",
         "default-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; "
         "script-src 'self' 'unsafe-inline'; connect-src 'self'; font-src 'self'; "
         "base-uri 'none'; form-action 'none'; frame-ancestors 'none'"),
        ("Cross-Origin-Opener-Policy", "same-origin"),
        ("Cross-Origin-Resource-Policy", "same-origin"),
        ("Permissions-Policy", "geolocation=(), microphone=(), camera=(), usb=(), payment=()"),
    )

    class Handler(BaseHTTPRequestHandler):
        server_version = f"{PROG}/{VERSION}"
        sys_version = ""                      # never advertise the Python version

        def log_message(self, fmt, *args):  # silent
            pass

        def end_headers(self):
            for key, value in SECURITY_HEADERS:
                self.send_header(key, value)
            super().end_headers()

        def _cookie_token(self) -> str:
            for part in (self.headers.get("Cookie") or "").split(";"):
                key, _, value = part.strip().partition("=")
                if key == COOKIE_NAME:
                    return value
            return ""

        def _same_origin(self) -> bool:
            """Refuse cross-site browsers and DNS-rebinding hosts before any route body runs.

            The operator reaches this panel with a token through a browser, so a hostile page must
            never be able to reach it: `Sec-Fetch-Site` (sent by every current browser) is refused
            for cross-site and same-site requests, an `Origin` header that is not ours is refused,
            and a `Host` header that is not this machine's loopback name is refused (that is the
            DNS-rebinding case, where a hostile domain resolves to 127.0.0.1). Command line clients
            send none of those headers, so curl and scripts keep working with `?t=` or the header.
            """
            host_header = (self.headers.get("Host") or "").strip().lower()
            if host_header:
                name = host_header
                if name.startswith("["):
                    name = name.split("]")[0] + "]"
                elif ":" in name:
                    name = name.rsplit(":", 1)[0]
                allowed = getattr(self.server, "allowed_hosts", None) or {
                    "127.0.0.1", "localhost", "[::1]", "::1"}
                if name not in allowed:
                    return False
            if (self.headers.get("Sec-Fetch-Site") or "").strip().lower() in ("cross-site", "same-site"):
                return False
            origin = (self.headers.get("Origin") or "").strip().lower()
            if origin:
                allowed_origins = getattr(self.server, "allowed_origins", None) or set()
                if origin not in allowed_origins:
                    return False
            return True

        def _auth(self, q) -> bool:
            given = q.get("t", [""])[0] or self.headers.get("X-Herman-Token") or self._cookie_token()
            return bool(given) and secrets.compare_digest(str(given), token)

        def _json(self, obj, code: int = 200):
            body = json.dumps(obj, ensure_ascii=False).encode()
            self.send_response(code)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            try:
                self.wfile.write(body)
            except (BrokenPipeError, ConnectionResetError, ConnectionAbortedError):
                return            # browser tab closed mid-answer: not a failure

        def do_GET(self):
            u = urlparse(self.path)
            self._route(u, parse_qs(u.query), "GET")

        def do_POST(self):
            """Actions that carry secrets (API keys, tokens) use POST, never the URL."""
            u = urlparse(self.path)
            try:
                length = int(self.headers.get("Content-Length") or 0)
            except (TypeError, ValueError):
                length = 0
            if length > MAX_BODY:             # a local client must not be able to stream a huge body
                self.close_connection = True
                self._json({"error": f"request body too large (max {MAX_BODY} bytes)"}, 413)
                return
            raw = self.rfile.read(length).decode("utf-8", "replace") if length else ""
            q = parse_qs(u.query)
            if raw:
                try:
                    data = json.loads(raw)
                    if isinstance(data, dict):
                        for k, v in data.items():
                            q[k] = [v if isinstance(v, str) else json.dumps(v)]
                except ValueError:
                    for k, v in parse_qs(raw).items():
                        q[k] = v
            self._route(u, q, "POST")

        def _route(self, u, q, method: str = "GET"):
            """Origin guard plus a last-resort error guard: no traceback ever reaches the client."""
            if not self._same_origin():
                self._json({"error": "refused: this request did not come from the panel's own "
                                     "origin or host"}, 403)
                return
            try:
                self._dispatch(u, q, method)
            except Exception:
                sys.stderr.write(traceback.format_exc())
                self._json({"error": "internal error: see the panel log"}, 500)

        def _dispatch(self, u, q, method: str = "GET"):
            if u.path == "/favicon.ico":
                self.send_response(204)
                self.end_headers()
                return
            if not self._auth(q):
                self._json({"error": "token required; open the URL printed by "
                                     f"`{PROG} web`"}, 403)
                return
            if u.path in ("/", "/index.html") and (q.get("t", [""])[0] or ""):
                # The token arrived in the URL: put it in an HttpOnly, SameSite=Strict cookie and
                # redirect to the same path without it, so it never sits in the address bar, the
                # browser history or the Referer of any link the page opens.
                self.send_response(302)
                self.send_header("Location", u.path)
                self.send_header("Set-Cookie", f"{COOKIE_NAME}={token}; HttpOnly; SameSite=Strict; "
                                               f"Path=/; Max-Age=28800")
                self.send_header("Content-Length", "0")
                self.send_header("Cache-Control", "no-store")
                self.end_headers()
                return
            if u.path in ("/", "/index.html"):
                body = icon_refs(page.read_text(encoding="utf-8")                  \
                .replace("{{TOKEN}}", token).replace("{{REV}}", page_rev())        \
                .replace("{{ICONS}}", icons_sprite()))
                data = body.encode()
                self.send_response(200)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.send_header("Content-Length", str(len(data)))
                self.send_header("Cache-Control", "no-store")
                self.end_headers()
                self.wfile.write(data)
                return
            if u.path == "/caduceus.png":
                # decorative caduceus (the CLI banner art) for the dashboard watermark
                mark = html_path().parent / "caduceus.png"
                if mark.exists():
                    data = mark.read_bytes()
                    self.send_response(200)
                    self.send_header("Content-Type", "image/png")
                    self.send_header("Content-Length", str(len(data)))
                    self.send_header("Cache-Control", "private, max-age=86400")
                    self.end_headers()
                    self.wfile.write(data)
                else:
                    self.send_response(404)
                    self.send_header("Content-Length", "0")
                    self.end_headers()
                return
            if u.path == "/api/usage-all":
                self._json(usage_overview())
                return
            if u.path == "/api/message":
                nm = q.get("name", [""])[0] or active_profile() or DEFAULT_HERMES
                if not profile_exists(nm):
                    self._json({"error": f"project '{nm}' does not exist"}, 400)
                    return
                try:
                    mid = int(q.get("id", ["0"])[0])
                except (TypeError, ValueError):
                    mid = 0
                self._json(message_detail(nm, mid))
                return
            if u.path == "/api/summary":
                # The panel's Read summary buttons open a dialog, so the analysis travels as plain
                # paragraphs (unwrapped) and the browser does the typesetting. Read-only, like every
                # other JSON route here, and the project name is shape-checked before it is used.
                scope = (q.get("scope", [""])[0] or "").strip().lower()
                nm = (q.get("name", [""])[0] or "").strip()
                if scope == "overview":
