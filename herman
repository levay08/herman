def resolve_target(sel: str, rows: list[dict] | None = None) -> str:
    """Accept a project name or the number shown by `herman -l`."""
    s = (sel or "").strip()
    if s.isdigit():
        rows = rows if rows is not None else stats_all()
        i = int(s)
        if 1 <= i <= len(rows):
            return rows[i - 1]["name"]
        die(f"there is no project number {i}; see: {PROG} -l")
    return s


def do_pick(rows: list[dict]) -> str | None:
    """Interactive numbered pick: only reached when the user asks for it."""
    if not rows or not sys.stdin.isatty():
        return None
    try:
        ans = input(dim("project number or name (empty = cancel): ")).strip()
    except (EOFError, KeyboardInterrupt):
        print()
        return None
    if not ans:
        return None
    return resolve_target(ans, rows)


