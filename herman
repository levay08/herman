HTML_NAME = "index.html"
ICONS_NAME = "icons.svg"


def page_rev() -> str:
    """Fingerprint of the served panel page (mtime + size): a browser tab that still runs an
    older build compares this on every poll and reloads itself. The icon sprite counts too, so a
    new sprite reaches an open tab without a manual hard reload."""
    page = _page_path()
    if not page or not page.exists():
        return "0"
    st = page.stat()
    icons = icons_path()
    tail = f"-{int(icons.stat().st_mtime)}-{icons.stat().st_size}" if icons else ""
    return f"{int(st.st_mtime)}-{st.st_size}{tail}"


def icons_path() -> Path | None:
    """The vendored Bootstrap Icons sprite, kept beside the served page."""
    page = html_path()
    if not page:
        return None
    for cand in (page.parent / ICONS_NAME, HERMAN_SHARE / ICONS_NAME):
        if cand.exists():
            return cand
    return None


def icons_sprite() -> str:
    p = icons_path()
    if not p:
        return ""
    try:
        return p.read_text(encoding="utf-8").strip()
    except OSError:
        return ""


def icon_svg(name: str) -> str:
    return f'<svg class="bi" aria-hidden="true"><use href="#i-{name}"></use></svg>'


def icon_refs(text: str) -> str:
    """Resolve {{ICON:name}} in the page markup into a reference to the injected sprite.

    Inline use means the icons need no icon font, no extra request and no policy change: the page
    stays one document and renders the same glyph on every machine.
    """
    return re.sub(r"\{\{ICON:([a-z0-9-]+)\}\}", lambda m: icon_svg(m.group(1)), text)


def _page_path():
    """The panel page: next to the script (../share/herman), $HERMAN_SHARE, then $HOME."""
    cands = [Path(__file__).resolve().parent.parent / "share" / PROG / HTML_NAME]
    share = os.environ.get("HERMAN_SHARE")
    if share:
        cands.append(Path(share) / HTML_NAME)
    cands.append(Path.home() / ".local" / "share" / PROG / HTML_NAME)
    for c in cands:
        if c.exists():
            return c
    return None


def harden_cache() -> None:
    """Keep herman's own cache (token, pid, state, model cache, dashboard log) owner-only.

    The panel runs as the operator, but a shared machine can have other local users: 0644 files in a
    0755 directory leak project names, the engine version and the configured provider endpoint.
    """
    try:
        HERMAN_CACHE.mkdir(parents=True, exist_ok=True)
        HERMAN_CACHE.chmod(0o700)
    except OSError:
        pass


def chmod_quiet(path: Path, mode: int = 0o600) -> None:
    try:
        path.chmod(mode)
    except OSError:
        pass


def ensure_token() -> str:
    harden_cache()
    if TOKEN_FILE.exists():
        tok = TOKEN_FILE.read_text(encoding="utf-8").strip()
        if tok:
            chmod_quiet(TOKEN_FILE)
            return tok
    tok = secrets.token_urlsafe(24)
    TOKEN_FILE.write_text(tok, encoding="utf-8")
    chmod_quiet(TOKEN_FILE)
    return tok


def _pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def pid_file_for(port: int) -> Path:
    """One pid file per port: the default port keeps web.pid, others get web-<port>.pid."""
    return PID_FILE if port == DEFAULT_WEB_PORT else HERMAN_CACHE / f"web-{port}.pid"


def list_panels() -> list[dict]:
    """Live panels from the pid files (stale files are removed)."""
    out: list[dict] = []
    for f in sorted(HERMAN_CACHE.glob("web*.pid")):
        try:
            raw = json.loads(f.read_text(encoding="utf-8").strip())
            info = raw if isinstance(raw, dict) else {"pid": int(raw)}
            pid = int(info.get("pid") or 0)
            port = int(info.get("port") or DEFAULT_WEB_PORT)
            host = info.get("host") or "127.0.0.1"
        except (OSError, ValueError, TypeError):
            f.unlink(missing_ok=True)
            continue
        if pid and _pid_alive(pid):
            out.append({"pid": pid, "port": port, "host": host,
                        "url": f"http://{url_host(display_host(host))}:{port}/", "file": f})
        else:
            f.unlink(missing_ok=True)
    return out


def panel_url(panel: dict, *, with_token: bool = True) -> str:
    """Full panel URL including the access token."""
    if not with_token:
        return panel["url"]
    try:
        tok = TOKEN_FILE.read_text(encoding="utf-8").strip()
    except OSError:
        tok = ""
    return f"{panel['url']}?t={tok}" if tok else panel["url"]


def hyperlink(url: str, label: str | None = None) -> str:
    """Clickable link in VTE terminals (GNOME Terminal, Terminator). Plain text elsewhere."""
    text = url if label is None else label
    if not sys.stdout.isatty() or os.environ.get("HERMAN_NO_HYPERLINK"):
        return text
    return f"\x1b]8;;{url}\x1b\\{text}\x1b]8;;\x1b\\"


def print_panel_url(panel: dict, *, lead: str = "open in browser"):
    """Print the panel URL as a clickable link on its own line (never truncated by a frame).

    The token is the whole authorization for the panel, so it never appears in the printed text: on
    a terminal the link's target carries it while the visible label stays clean (screenshots, tmux
    logs and scrollback are all readable by whoever is watching), and when stdout is not a terminal
    (a redirect, a pipe, cron) only the token-free URL is printed, with a hint for the explicit
    `herman web --url` call that does print the full one.
    """
    url = panel_url(panel)
    plain = panel_url(panel, with_token=False)
    if sys.stdout.isatty() and not os.environ.get("HERMAN_NO_HYPERLINK"):
        print(dim(f"  {lead} : ") + hyperlink(url, plain))
        print(dim("  click the link above to open it in your default browser"))
        return
    print(dim(f"  {lead} : ") + plain)
    print(dim(f"  the token is not printed here on purpose: run `{PROG} web --url` to get the full URL"))


def print_panel_ready(panel: dict, *, title: str = "web panel ready"):
    print_frame(title, [
        f"pid    : {panel['pid']}    port: {panel['port']}",
        f"token  : {TOKEN_FILE}",
        f"stop   : {PROG} web --stop",
        f"headless url: {panel['url']}?t=<token>  (use {PROG} web --url to print it)",
    ], color=cyan)
    print_panel_url(panel)


def web_status_dict(port: int | None = None) -> dict:
    """Panel status: the live panel on `port`, or any live panel when port is None."""
    panels = list_panels()
    hit = [x for x in panels if x["port"] == port] if port is not None else panels
    if hit:
        x = hit[0]
        return {"running": True, "pid": x["pid"], "port": x["port"], "host": x["host"],
                "url": x["url"], "url_full": panel_url(x)}
    return {"running": False, "pid": None, "port": port or DEFAULT_WEB_PORT,
            "host": "127.0.0.1", "url": None, "url_full": None}


def html_path() -> Path:
    """Locate the panel page.

    Order: the installed share directory, then next to the script (so a plain git clone runs with
    ``./herman web`` without installing anything), then the classic install layout
    (``~/.local/bin/../share/herman/``) and finally $HOME, so the panel is still found when HOME is
    redirected (sandbox/tests).
    """
    candidates = [
        HERMAN_SHARE / HTML_NAME,
        Path(__file__).resolve().parent / HTML_NAME,          # a fresh git clone: ./herman + ./index.html
        Path(__file__).resolve().parent / "herman-web.html",
        Path(__file__).resolve().parent.parent / "share" / PROG / HTML_NAME,
        Path.home() / ".local" / "share" / PROG / HTML_NAME,
    ]
    for c in candidates:
        if c.exists():
            return c
    return candidates[0]


def display_host(host: str) -> str:
    """A browsable host for a bind address.

    `0.0.0.0` and `::` are bind addresses, not destinations: printing `http://0.0.0.0:9120/` gives a
    link nothing can open (it matters in a container, where binding a wildcard is the only way a
    published port reaches the panel). The URL shows loopback instead, and the amber warning already
    says the panel is reachable from the network.
    """
    name = (host or "").strip()
    return "127.0.0.1" if name in ("", "0.0.0.0", "::") else name


def url_host(host: str) -> str:
    """`::1` has to be written `[::1]` inside a URL, or the printed link is unusable."""
    name = (host or "").strip()
    return f"[{name}]" if ":" in name and not name.startswith("[") else name


def is_loopback_host(host: str) -> bool:
    """True for the loopback names and addresses the panel is allowed to bind by default."""
    name = (host or "").strip().strip("[]").lower()
    if name in ("", "localhost", "::1", "0:0:0:0:0:0:0:1"):
        return True
    try:
        import ipaddress
        return ipaddress.ip_address(name).is_loopback
    except ValueError:
        return False


def shape_class(spec: str) -> str:
    """Characters a compact class like 'A-Za-z0-9._-' stands for ('' means the rule takes any text)."""
    out, i = [], 0
    while i < len(spec):
        if i + 2 < len(spec) and spec[i + 1] == "-" and ord(spec[i]) < ord(spec[i + 2]):
            out.extend(chr(c) for c in range(ord(spec[i]), ord(spec[i + 2]) + 1))
            i += 3
        else:
            out.append(spec[i])
            i += 1
    return "".join(out)


