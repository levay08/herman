def human_size(n: float) -> str:
    val = float(n)
    for unit in ("B", "KB", "MB", "GB"):
        if val < 1024 or unit == "GB":
            return f"{int(val)} B" if unit == "B" else f"{val:.1f} {unit}"
        val /= 1024.0
    return f"{val:.1f} GB"


def size_of(path: Path) -> int:
    total = 0
    if not path.exists():
        return 0
    for p in path.rglob("*"):
        try:
            if p.is_file():
                total += p.stat().st_size
        except OSError:
            pass
    return total


def human_time(ts: float | None) -> str:
    if not ts:
        return "never"
    delta = time.time() - ts
    if delta < 60:
        return "just now"
    if delta < 3600:
        return f"{int(delta // 60)} min ago"
    if delta < 86400:
        return f"{int(delta // 3600)} h ago"
    if delta < 86400 * 30:
        return f"{int(delta // 86400)} d ago"
    return time.strftime("%d %b %Y", time.localtime(ts))


def run(cmd: list[str], *, capture: bool = True, check: bool = False,
        env: dict | None = None, stream: bool = False,
        stdin=None) -> subprocess.CompletedProcess:
    return subprocess.run(
        cmd,
        text=True,
        capture_output=capture and not stream,
        check=check,
        env=env,
        stdin=stdin,
    )


def hermes_cmd(args: list[str], profile: str | None = None) -> list[str]:
    cmd = [HERMES_BIN]
    if profile:
        cmd += ["-p", profile]
    return cmd + args


def run_hermes(args: list[str], profile: str | None = None, *, dry: bool = False,
               quiet: bool = False, stream: bool = False) -> subprocess.CompletedProcess:
    cmd = hermes_cmd(args, profile)
    if dry:
        print(dim("  [dry-run] " + " ".join(cmd)))
        return subprocess.CompletedProcess(cmd, 0, "", "")
    if not quiet and stream:
        print(dim("  $ " + " ".join(cmd)), flush=True)
    if stream:
        return run(cmd, capture=False, stream=True)
    res = run(cmd, capture=True)
    if res.returncode != 0 and not quiet:
        out = (res.stdout or "").strip()
        err = (res.stderr or "").strip()
        if out:
            print(out)
        if err:
            print(red(err), file=sys.stderr)
    return res


_HERMES_CACHE: dict[str, object] = {}


def hermes_available(force: bool = False) -> tuple[bool, str]:
    """Check that the Hermes engine is installed and runnable (cached)."""
    if not force and "ok" in _HERMES_CACHE:
        return bool(_HERMES_CACHE["ok"]), str(_HERMES_CACHE.get("why", ""))
    path = shutil.which("hermes")
    if not path:
        res = (False, "the `hermes` command is not on PATH")
    else:
        try:
            r = run([path, "--version"], capture=True)
            text = (r.stdout or r.stderr or "").strip()
            if r.returncode == 0 and text:
                res = (True, text.splitlines()[0])
            else:
                res = (False, f"`hermes --version` exited with code {r.returncode}")
        except (OSError, subprocess.SubprocessError) as exc:
            res = (False, f"could not run hermes: {exc}")
    _HERMES_CACHE["ok"], _HERMES_CACHE["why"] = res
    return res


def require_hermes():
    """HERMAN is a manager, not an agent: refuse to start without Hermes."""
    good, why = hermes_available()
    if good:
        return
    print()
    print_frame("HERMAN cannot start", [
        "HERMAN manages Hermes projects: the Hermes engine must be installed first.",
        "",
        f"problem : {why}",
