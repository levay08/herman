def do_use(name: str | None, *, question: str | None = None, file: str | None = None,
           verbose: bool = False, dry: bool = False, assume_yes: bool = False,
           close_others: bool = False):
    if not name:
        name = load_state().get("last")
        if not name:
            rows = stats_all()
            if len(rows) == 1:
                name = rows[0]["name"]
            else:
                do_list()
                die("name a project: " + f"{PROG} -u <name>")
    name = name.strip()
    if name.isdigit():
        name = resolve_target(name)
    ensure_profile(name)
    if question == "-":
        question = sys.stdin.read()
    if file:
        fp = Path(file).expanduser()
        if not fp.exists():
            die(f"file not found: {fp}")
        question = fp.read_text(encoding="utf-8")
    if question is not None:
        set_last(name)
        args = ["chat", "-q", question]
        interactive = (not _plain) and sys.stdout.isatty()
        res = run_hermes(args, name, dry=dry, quiet=True, stream=interactive)
        if dry:
            return
        if not interactive:
            out = (res.stdout or "").strip()
            if out:
                print(out)
        if res.returncode != 0:
            err = (res.stderr or "").strip()
            if err:
                print(err, file=sys.stderr)
            sys.exit(res.returncode)
        return
    set_last(name)
    guard_other_sessions(name, assume_yes=assume_yes, close_others=close_others)
    os.environ.pop("HERMES_HOME", None)  # let -p pick the home
    if dry:
        print(dim("  [dry-run] " + " ".join(hermes_cmd([], name))))
        return
    os.execvp(HERMES_BIN, hermes_cmd([], name))


def guard_other_sessions(name: str, *, assume_yes: bool = False, close_others: bool = False) -> None:
    """Warn when another project already runs a session, and offer to close it.

    Non-interactive callers (scripts, cron) never block: they get one dim line on stderr and the
    session starts, because a hanging prompt would be worse than the shared machine.
    """
    others = other_live_sessions(name)
    if not others:
        return
    by_project: dict[str, list[dict]] = {}
    for s in others:
        by_project.setdefault(s["project"], []).append(s)
    lines = [f"{p:<16} {s['id']}  ·  {s['surface']}  ·  pid {s['pid']}  ·  up {session_age(s)}"
             for p, items in by_project.items() for s in items]
    if close_others:
        for proj in by_project:
            closed, errors, _how = close_sessions(proj)
            ok(f"closed {len(closed)} session(s) in {proj}")
            for e in errors:
                warn(e)
        return
    if assume_yes:
        print(dim("  ! a session is already running in " + ", ".join(by_project) + " (continuing)"),
              file=sys.stderr)
        return
    if not sys.stdin.isatty() or _plain:
        print(dim("  ! session already running in " + ", ".join(by_project) + " (continuing)"),
              file=sys.stderr)
        return
    print()
    print_frame(f"another project has a live session · entering {name}", lines + [
        "",
        dim("y = continue anyway   c = close those sessions and continue   Enter = cancel"),
    ], color=amber, width=min(term_width(), 104))
    try:
        answer = input("  continue? [y/c/N]: ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        print()
        answer = ""
    if answer.startswith("c"):
        for p in by_project:
            closed, errors, _how = close_sessions(p)
            ok(f"closed {len(closed)} session(s) in {p}")
            for e in errors:
                warn(e)
        return
    if answer.startswith("y"):
        return
    die("cancelled · nothing was closed")


def do_create(name: str, *, clone: bool = False, clone_all: bool = False,
              clone_from: str | None = None, no_alias: bool = False,
              no_skills: bool = False, dry: bool = False):
    name = (name or "").strip().lower()      # hermes profile ids are lowercase
    if not re.fullmatch(r"[a-z0-9][a-z0-9._-]{0,63}", name):
        die(f"project name: {NAME_RULE} · {NAME_NOT} · received {name!r} "
            f"(uppercase letters are lowered for you)")
    if name in list_profiles():
        die(f"project '{name}' already exists")
    args = ["profile", "create", name]
    if clone_from:
        args += ["--clone-from", clone_from]
    elif clone_all:
        args.append("--clone-all")
    elif clone:
        args.append("--clone")
    # PROG is the tool's own command name, hermes/hermes-acp are the engine's: a project shortcut
    # with one of those names would replace the binary on PATH (the engine writes one wrapper per
    # project into ~/.local/bin, so the shortcut wins over whatever was installed there).
    reserved = name in (PROG, "hermes", "hermes-acp")
    if no_alias or reserved:
        args.append("--no-alias")
    if no_skills:
        args.append("--no-skills")
    res = run_hermes(args, dry=dry)
    if dry:
        return
    if res.returncode != 0:
        sys.exit(res.returncode)
    ok(f"project '{name}' created at {profile_home(name)}")
    if reserved:
        print(dim(f"  no shortcut command: '{name}' is already a program on your PATH · "
                  f"enter this project with {PROG} -u {name}"))
    print(dim(f"  enter:  {PROG} -u {name}"))
    print(dim(f"  set workdir:  {PROG} -C {name} ~/Projects/{name}"))


def do_remove(name: str, *, assume_yes: bool = False, dry: bool = False):
