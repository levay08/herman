def load_state() -> dict:
    try:
        return json.loads(STATE_FILE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}


def save_state(state: dict):
    """Atomic, owner-only write: the panel reads this file on every request, so a crash mid-write
    must not leave a half file, and the content names projects so it never goes to 0644."""
    harden_cache()
    try:
        tmp = STATE_FILE.with_name(STATE_FILE.name + ".tmp")
        tmp.write_text(json.dumps(state, indent=2), encoding="utf-8")
        chmod_quiet(tmp)
        os.replace(tmp, STATE_FILE)
    except OSError:
        pass

DESC_MAX = 90          # a card keeps a description to two short lines


def description(name: str) -> str:
    """The operator's one-line note about a project.

    It lives in herman's own state (``descriptions``), never in the project's config.yaml: Hermes has
    no such field, and herman must not invent config keys the engine would not read.
    """
    return str((load_state().get("descriptions") or {}).get(name) or "")


def set_description(name: str, text: str, *, dry: bool = False) -> str:
    """Store (or clear, with empty text) a project description. Returns what is stored now."""
    clean = " ".join((text or "").split())[:DESC_MAX]
    if dry:
        return clean
    st = load_state()
    desc = dict(st.get("descriptions") or {})
    if clean:
        desc[name] = clean
    else:
        desc.pop(name, None)
    st["descriptions"] = desc
    save_state(st)
    return clean



def rename_state(old: str, new: str) -> dict:
    """Move herman's own bookkeeping from one project name to another.

    Renaming a project only moves the Hermes profile directory; herman keeps its own per-project
    facts in state.json (descriptions, the last project used, the recent history), so without this
    the renamed project would come back with an empty description and the old name would linger in
    the panel's history. Returns what actually moved, so the CLI can say it out loud.
    """
    st = load_state()
    moved = {"description": False, "last": False, "history": 0}
    desc = dict(st.get("descriptions") or {})
    if old in desc:
        desc[new] = desc.pop(old)
        moved["description"] = True
    st["descriptions"] = desc
    if st.get("last") == old:
        st["last"] = new
        moved["last"] = True
    before = list(st.get("history") or [])
    moved["history"] = sum(1 for n in before if n == old)
    if before:
        hist: list[str] = []
        for n in before:                   # rewrite the old name, then drop what that duplicated
            n = new if n == old else n
            if n not in hist:
                hist.append(n)
        st["history"] = hist[:10]
    save_state(st)
    return moved


def set_last(name: str):
    st = load_state()
    st["last"] = name
    st["last_ts"] = time.time()
    hist = [n for n in st.get("history", []) if n != name]
    st["history"] = ([name] + hist)[:10]
    save_state(st)


