    cfg = home / "config.yaml"
    env_names: set[str] = set()
    try:
        for ln in (home / ".env").read_text(encoding="utf-8", errors="replace").splitlines():
            m = re.match(r"\s*([A-Za-z_][A-Za-z0-9_]*)\s*=", ln)
