_plain = "--plain" in sys.argv or not sys.stdout.isatty()
_COLOR = os.environ.get("NO_COLOR") is None


def _c(code: str, text: str) -> str:
    if _plain or not _COLOR:
        return text
    return f"\033[{code}m{text}\033[0m"


def dim(t: str) -> str:
    return _c("2", t)


def bold(t: str) -> str:
    return _c("1", t)


def green(t: str) -> str:
    return _c("92", t)          # bright green


def amber(t: str) -> str:
    return _c("93", t)          # bright yellow


def red(t: str) -> str:
    return _c("91", t)          # bright red


def cyan(t: str) -> str:
    return _c("96", t)          # bright cyan


def blue(t: str) -> str:
    return _c("94", t)          # bright blue


# ------------------------------------------------------------- framing ---

ANSI_RE = re.compile(r"\x1b\[[0-9;?]*[a-zA-Z]")


OSC8_RE = re.compile(r"\x1b\]8;;[^\x1b\x07]*(?:\x1b\\|\x07)")

def visible_len(s: str) -> int:
    """Printable width: CSI colours and OSC 8 hyperlink wrappers do not count."""
    return len(OSC8_RE.sub("", ANSI_RE.sub("", s)))


def term_width(default: int = 100) -> int:
    try:
        cols = shutil.get_terminal_size((default, 24)).columns
    except OSError:
        cols = default
    return max(64, min(cols, 118))


def fit(text: str, width: int) -> str:
    """Shorten a line to `width` visible characters, middle-ellipsis."""
    plain = ANSI_RE.sub("", text)
    if len(plain) <= width:
        return text
    keep = max(width - 1, 8)
    head = plain[: keep // 2]
    tail = plain[-(keep - len(head)):]
    return f"{head}…{tail}"


def frame(title: str, lines: list[str], *, color=None, width: int | None = None) -> str:
    """Rounded box around a block of lines (Claude-Code style panels)."""
    w = width or term_width()
    inner = max(w - 4, 24)
    edge = color or cyan
    header = f" {title} " if title else ""
    out = [edge("╭─" + header + "─" * max(0, inner - visible_len(header) - 1) + "╮")]
    for ln in lines:
        txt = fit(ln, inner)
        out.append(edge("│ ") + txt + " " * max(0, inner - visible_len(txt)) + edge(" │"))
    out.append(edge("╰" + "─" * (inner + 1) + "╯"))
    return "\n".join(out)


def print_frame(title: str, lines: list[str], *, color=None, width: int | None = None):
    print(frame(title, lines, color=color, width=width))


def gap(n: int = 1):
    print("\n" * n if n > 1 else "")


