GRAD_A = (16, 185, 129)     # bright green
GRAD_B = (2, 132, 199)      # cyan-blue


def _grad_rgb(t: float, a=GRAD_A, b=GRAD_B) -> tuple[int, int, int]:
    t = max(0.0, min(1.0, t))
    return tuple(int(a[i] + (b[i] - a[i]) * t) for i in range(3))  # type: ignore[return-value]


def gradient_text(art: str, a=GRAD_A, b=GRAD_B) -> str:
    """Colour ASCII art with a diagonal gradient (row+column), like the Hermes banner."""
    if _plain or not _COLOR:
        return art.strip("\n")
    lines = art.strip("\n").splitlines()
    w = max((len(ln) for ln in lines), default=1)
    h = max(len(lines) - 1, 1)
    out = []
    for r, line in enumerate(lines):
        buf = []
        for c, ch in enumerate(line):
            if ch == " ":
                buf.append(ch)
                continue
            rgb = _grad_rgb(((r / h) + (c / max(w - 1, 1))) / 2, a, b)
            buf.append(f"\033[38;2;{rgb[0]};{rgb[1]};{rgb[2]}m{ch}")
        out.append("".join(buf) + "\033[0m")
    return "\n".join(out)


