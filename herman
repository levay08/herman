        "",
        "docs: https://hermes-agent.nousresearch.com/docs",
    ], color=red, width=min(term_width(), 84))
    print()
    sys.exit(2)


def engine_version() -> str:
    """Version string of the installed Hermes engine."""
    good, info = hermes_available()
    if not good:
        return "not installed"
    m = re.search(r"(v?[0-9]+\.[0-9]+\.[0-9]+)", info)
    return m.group(1) if m else info[:40]


def dashboard_running(port: int = DEFAULT_DASHBOARD_PORT, timeout: float = 1.5) -> bool:
    """True when a Hermes dashboard answers /api/status on that port."""
    import urllib.request
    import urllib.error
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/api/status", timeout=timeout) as r:
            return 200 <= r.status < 300
    except (urllib.error.URLError, OSError, ValueError):
        return False


def dashboard_info(port: int = DEFAULT_DASHBOARD_PORT) -> dict:
    return {"running": dashboard_running(port), "port": port,
            "url": f"http://127.0.0.1:{port}/"}


def start_dashboard(port: int = DEFAULT_DASHBOARD_PORT, wait_s: float = 40.0) -> dict:
    """Start `hermes dashboard` in the background if it is not already up."""
    if dashboard_running(port):
        return {"ok": True, "already": True, "url": f"http://127.0.0.1:{port}/",
                "msg": "Hermes dashboard is already running."}
    HERMAN_CACHE.mkdir(parents=True, exist_ok=True)
    harden_cache()
    log = HERMAN_CACHE / "dashboard.log"
    try:
        with open(log, "ab") as fh, open(os.devnull, "rb") as devnull:
            subprocess.Popen(
                hermes_cmd(["dashboard", "--port", str(port), "--no-open"]),
                stdout=fh, stderr=fh, stdin=devnull, start_new_session=True,
            )
    except OSError as exc:
        return {"ok": False, "url": None, "msg": f"could not start the dashboard: {exc}"}
    deadline = time.time() + wait_s
    while time.time() < deadline:
        if dashboard_running(port, timeout=1.0):
            return {"ok": True, "already": False, "url": f"http://127.0.0.1:{port}/",
                    "msg": "Hermes dashboard started."}
        time.sleep(0.6)
    return {"ok": False, "url": None,
            "msg": f"dashboard did not become ready in {int(wait_s)}s (see {log})"}


