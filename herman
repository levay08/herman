def backup_list(limit: int = 12) -> list[dict]:
    """Newest backup archives first: name, size (human), age. Read-only."""
    outdir = Path.home() / "Documents" / f"{PROG}-backup"
    if not outdir.is_dir():
        return []
    files = sorted((p for p in outdir.glob("*.tar.gz") if p.is_file()),
                   key=lambda p: p.stat().st_mtime, reverse=True)[:limit]
    out: list[dict] = []
    for p in files:
        st = p.stat()
        age = max(0, int(time.time() - st.st_mtime))
        if age < 3600:
            when = f"{age // 60} min ago"
        elif age < 86400:
            when = f"{age // 3600} h ago"
        else:
            when = f"{age // 86400} d ago"
        out.append({"name": p.name, "size": human_size(st.st_size),
                    "when": when, "path": str(p)})
    return out


def do_backup(names: list[str], *, dry: bool = False) -> list[str]:
    outdir = Path.home() / "Documents" / f"{PROG}-backup"
    stamp = time.strftime("%Y%m%d-%H%M%S")
    made: list[str] = []
    if not dry:
        outdir.mkdir(parents=True, exist_ok=True)
    for name in names:
        ensure_profile(name)
        target = outdir / f"{name}-{stamp}.tar.gz"
        res = run_hermes(["profile", "export", name, "-o", str(target)], dry=dry)
        if dry:
            continue
        if res.returncode != 0:
            warn(f"failed to back up '{name}'")
            continue
        if target.exists():
            made.append(str(target))
            ok(f"{name}: {target} ({human_size(target.stat().st_size)})")
        else:
            latest = sorted(
                (ROOT / "profile-exports").glob(f"{name}-*.tar.gz"),
                key=lambda p: p.stat().st_mtime,
            ) if (ROOT / "profile-exports").exists() else []
            if latest:
                made.append(str(latest[-1]))
                ok(f"{name}: {latest[-1]} ({human_size(latest[-1].stat().st_size)})")
            else:
                warn(f"backup file for '{name}' not found")
    return made


