def _yaml_scalar(path: Path, *keys: str) -> str | None:
    """Read a simple scalar from YAML without dependencies.

    Supports:  model:\n  default: X   and   terminal:\n  cwd: /path
    """
    if not path.exists():
        return None
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return None
    section = None
    for line in lines:
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        if not line.startswith((" ", "\t")):
            m = re.match(r"^([A-Za-z0-9_.-]+):\s*(.*)$", line)
            if not m:
                section = None
                continue
            key, val = m.group(1), m.group(2).strip()
            if len(keys) == 1 and key == keys[0] and val:
                return val.strip("'\"")
            section = key if not val else None
            continue
        if section and len(keys) == 2 and section == keys[0]:
            m = re.match(r"^\s+([A-Za-z0-9_.-]+):\s*(.+)$", line)
            if m and m.group(1) == keys[1]:
                return m.group(2).strip().strip("'\"")
    return None


def _yaml_block(path: Path, key: str) -> dict:
    """Parse one top-level block of config.yaml into nested dicts, without dependencies.

    Handles the shapes herman reads back for the MCP and integration boards:
    a mapping of scalars (``telegram: {enabled: true}``), a mapping of mappings
    (``mcp_servers: {github: {command: npx}}``) and inline lists (``args: ["-y", "x"]``).
    Read-only: it never writes, and anything it cannot parse is simply left out.
    """
    if not path.exists():
        return {}
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return {}
    out: dict = {}
    inside = False
    stack: list[tuple[int, dict, str]] = []          # (indent, container, last key)
    for raw in lines:
        if not raw.strip() or raw.lstrip().startswith("#"):
            continue
        indent = len(raw) - len(raw.lstrip(" "))
        line = raw.strip()
        if indent == 0:
            m = re.match(r"^([A-Za-z0-9_.-]+):\s*$", line)
            inside = bool(m and m.group(1) == key)
            stack = [(-1, out, "")]
            continue
        if not inside:
            continue
        if line.startswith("- "):
            if stack:
                _, container, last = stack[-1]
                cur = container.get(last)
                item = line[2:].strip().strip("'\"")
                if isinstance(cur, list):
                    cur.append(item)
                else:
                    container[last] = [item]
            continue
        m = re.match(r"^([A-Za-z0-9_.-]+):\s*(.*)$", line)
        if not m:
            continue
        k, val = m.group(1), m.group(2).strip()
        while stack and indent <= stack[-1][0]:
            stack.pop()
        container = stack[-1][1] if stack else out
        if not val:
            child: dict = {}
            container[k] = child
            stack.append((indent, child, ""))
            continue
        if val.startswith("[") and val.endswith("]"):
            container[k] = [v.strip().strip("'\"") for v in val[1:-1].split(",") if v.strip()]
        else:
            container[k] = val.strip("'\"")
        if stack:
            stack[-1] = (stack[-1][0], stack[-1][1], k)
    return out


