def _hermes_root() -> Path:
    """Home directory of the default profile.

    Matches hermes: profiles live at <root>/profiles/<name>. When herman runs
    INSIDE a profile session (HERMES_HOME pointing at <root>/profiles/<x>),
    climb one level so every project is still listed.
    """
    env = os.environ.get("HERMES_HOME", "").strip()
    if env:
        p = Path(env).expanduser().resolve()
        if p.parent.name == "profiles":
            return p.parent.parent
    return Path.home() / ".hermes"


