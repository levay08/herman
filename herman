def do_doctor(names: list[str], *, dry: bool = False, all_profiles: bool = False):
    targets = list_profiles() if all_profiles else names
    if not targets:
        st = load_state().get("last")
        targets = [st] if st else list_profiles()[:1]
    w = min(term_width(), 104)
    for name in targets:
        ensure_profile(name)
        st = profile_stats(name)
        lines: list[str] = []
        if not (profile_home(name) / "config.yaml").exists():
            lines.append(amber("config.yaml missing → run: " + f"{PROG} -u {name} setup"))
        if st["model"] in ("-", ""):
            lines.append(amber("model not set"))
        res = run_hermes(["doctor"], name, dry=dry)
        if dry:
            continue
        text = (res.stdout or "") + (res.stderr or "")
        bad = [ln for ln in text.splitlines()
               if re.match(r"^\s*(✗|✖|❌|\[fail)", ln)
               or re.search(r"\b(failed|error|broken|invalid)\b", ln, re.I)]
        if res.returncode == 0 and not bad:
            lines.append(green("✓ healthy"))
            color = green
        else:
            color = amber
            lines += ["  " + red(ln.strip()) for ln in bad[:10]]
            lines.append(dim("auto-fix: " + f"{PROG} -u {name} doctor --fix"))
        print()
        print_frame(f"doctor · {name}  (engine: hermes doctor)", lines, color=color, width=w)


