    print(dim("  every write touches only that project's config.yaml / .env, after a backup; "
              "herman never connects anywhere."))


def gateway_state(name: str) -> str:
    """Messaging gateway status, read the way the engine itself decides it (no process spawn).

    Hermes writes `<profile>/gateway_state.json` with `gateway_state` (and `desired_state`), a pid
    record (`pid`, `start_time`) and `active_agents`. The engine keys liveness off the PROCESS, not
    off the file's age, because an idle gateway never advances the timestamp: a live pid therefore
    means `running` even in a record that has not been touched for hours, and a dead pid means
    `stopped` even in a freshly written one (that is the ungraceful-kill case: taskkill /F, OOM,
    power loss). Only when
    the record carries no pid do we fall back to the file's age, with the engine's own 120 s window.
    """
    p = profile_home(name) / "gateway_state.json"
    if not p.exists():
        return "stopped"
    try:
        age = time.time() - p.stat().st_mtime
        data = json.loads(p.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return "stopped"
    if not isinstance(data, dict):
        return "stopped"
    st = str(data.get("gateway_state") or data.get("state") or data.get("desired_state") or "").lower()
    pid = data.get("pid")
    try:
        pid = int(pid)
    except (TypeError, ValueError):
        pid = 0
    if pid > 0:
        if not _pid_alive(pid):
            return "stopped"
        started = data.get("start_time") or data.get("process_start_time")
        try:
            started = float(started)
        except (TypeError, ValueError):
            started = 0.0
        actual = _proc_start_time(pid)
        if started and actual and abs(actual - started) > 5:
            return "stopped"          # a recycled pid is not this gateway
        busy = str(data.get("active_agents") or "").strip()
        if busy.isdigit() and int(busy) > 0 and st in ("running", "busy", "ok", ""):
            return "busy"
        return "running" if st in ("running", "busy", "ok", "") else (st or "running")
    if age > 120:
        return "stopped"
    if st in ("running", "busy", "ok", ""):
        return "running"
    return st or "stopped"


def _pid_alive(pid) -> bool:
    try:
        pid = int(pid)
    except (TypeError, ValueError):
        return False
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True            # exists, owned by another user
    except OSError:
        return False
    return True


def _proc_start_time(pid: int) -> float | None:
    """Epoch seconds when pid started (from /proc), so a recycled pid cannot
    masquerade as the owner of a stale session lease."""
    try:
        ticks = os.sysconf("SC_CLK_TCK")
        with open(f"/proc/{pid}/stat", "r", encoding="utf-8", errors="replace") as fh:
            raw = fh.read()
        start_ticks = float(raw[raw.rfind(")") + 2:].split()[19])   # field 22
        btime = 0.0
        with open("/proc/stat", "r", encoding="utf-8") as fh:
            for line in fh:
                if line.startswith("btime "):
                    btime = float(line.split()[1])
                    break
        return btime + start_ticks / ticks
    except (OSError, IndexError, ValueError, AttributeError):
        # Windows has neither /proc nor os.sysconf: no start time is available, so the pid-reuse
        # guard degrades to plain pid existence instead of raising.
        return None


def live_sessions(name: str) -> list[dict]:
    """Sessions this project has open right now.

    Hermes records one lease per live process in <home>/runtime/active_sessions.json
    (session_id, pid, surface, process_start_time). A lease counts as live only while
    that pid still runs with the recorded start time; a recycled pid drops it.
    """
    path = profile_home(name) / "runtime" / "active_sessions.json"
    try:
        entries = json.loads(path.read_text(encoding="utf-8")).get("entries") or []
    except (OSError, ValueError, AttributeError):
        return []
    now = time.time()
    out: list[dict] = []
    for e in entries:
        if not isinstance(e, dict):
            continue
        sid = str(e.get("session_id") or "").strip()
        if not sid:
            continue
        pid = e.get("pid")
        alive = _pid_alive(pid)
        recorded = e.get("process_start_time")
        if alive and recorded and str(pid).isdigit():
            real = _proc_start_time(int(pid))
            if real is not None and abs(real - float(recorded)) > 2.0:
                alive = False
        if not alive:
            continue
        started = e.get("started_at") or e.get("updated_at")
        out.append({
            "id": sid,
            "surface": e.get("surface") or "-",
            "pid": pid,
            "age_s": round(now - float(started), 1) if started else None,
        })
    return out


def live_sessions_all() -> list[dict]:
    """Every live session on this machine, each tagged with its project."""
    out: list[dict] = []
    for name in list_profiles():
        for s in live_sessions(name):
            out.append({"project": name, **s})
    return out


def close_sessions(project: str, *, keep_pid: int | None = None,
                   session_id: str | None = None, interrupt_grace: float = 6.0,
                   term_grace: float = 3.0) -> tuple[list[int], list[str], dict[int, str]]:
    """Stop live session processes the polite way, mirroring Ctrl+C.

    Ladder per process: SIGINT (what Ctrl+C sends, so Hermes closes the turn and saves the
    transcript) -> SIGTERM (the engine handles this for a clean shutdown too) -> SIGKILL as the
    last resort. The runtime leases stay on disk: they are keyed to a pid, so a stopped session
    simply stops counting as live. Never touches the caller's own process.
    """
    closed: list[int] = []
    errors: list[str] = []
    how: dict[int, str] = {}
    mine = os.getpid()

    def _gone(pid: int, seconds: float) -> bool:
        deadline = time.monotonic() + seconds
        while time.monotonic() < deadline and _pid_alive(pid):
            time.sleep(0.1)
        return not _pid_alive(pid)

    for entry in live_sessions(project):
        if session_id and str(entry.get("id") or entry.get("session_id") or "") != session_id:
            continue
        pid = entry.get("pid")
        try:
            pid = int(pid)
        except (TypeError, ValueError):
            continue
        if pid == mine or pid == keep_pid or pid <= 1:
            errors.append(f"skipped own/kept pid {pid}")
            continue
        sent = ""
        ladder = [(signal.SIGINT, interrupt_grace, "interrupt"),
                  (signal.SIGTERM, term_grace, "terminate")]
        if hasattr(signal, "SIGKILL"):
            ladder.append((signal.SIGKILL, 0.3, "kill"))
        for sig, grace, label in ladder:
            try:
                os.kill(pid, sig)
            except OSError as exc:
                errors.append(f"pid {pid}: {exc}")
                break
            sent = label
            if _gone(pid, grace):
                break
        if _pid_alive(pid):
            errors.append(f"pid {pid} survived the signal ladder")
            continue
        closed.append(pid)
        how[pid] = sent
    return closed, errors, how


def kill_targets(name: str, *, session: str | None = None) -> list[dict]:
    """Live sessions of one project, optionally narrowed to a single session id."""
    out = []
    for s in live_sessions(name):
        if session and str(s.get("id") or s.get("session_id") or "") != session:
            continue
        out.append({"project": name, **s})
    return out


def do_kill(name: str, *, session: str | None = None, everything: bool = False,
            assume_yes: bool = False, dry: bool = False, as_json: bool = False) -> dict:
    """`herman kill`: stop running session(s) of a project the polite way.

    The ladder mirrors Ctrl+C: SIGINT first so Hermes can close the turn and save the transcript,
    then SIGTERM, then SIGKILL only if the process refuses to leave.

    The project name has to be typed unless -y is given, and the caller's own process is never
    a target.
    """
    names = _all_projects() if everything else [name]
    targets: list[dict] = []
    for nm in names:
        targets.extend(kill_targets(nm, session=session))
    res: dict = {"dry": dry, "targets": targets, "closed": [], "errors": [], "session": session,
                 "project": "all" if everything else name}
    if not targets:
        msg = (f"no live session in {name}"
               + (f" with id {session}" if session else "")) if not everything else "no live session anywhere"
        if as_json:
            print(json.dumps({**res, "msg": msg}, indent=2, ensure_ascii=False))
        else:
            print(dim(msg))
        return res
    if not as_json:
        print(f"about to stop {len(targets)} session(s) (Ctrl+C style: interrupt, then terminate,"
              f" then kill only if needed):")
        for t in targets:
            print(f"  {t.get('project')}  {t.get('id') or t.get('session_id') or '-'}  pid {t.get('pid')}"
                  f"  {'· ' + str(t.get('surface')) if t.get('surface') else ''}")
    if dry:
        if not as_json:
            print(dim("  [dry-run] nothing was stopped"))
        return res
    if not assume_yes:
        if everything:
            phrase = "all"
        else:
            phrase = name
        if not sys.stdin.isatty():
            die(f"refusing to stop sessions without -y (type '{phrase}' to confirm interactively)")
        try:
            answer = input(f"type '{phrase}' to stop {len(targets)} session(s): ").strip()
        except (EOFError, KeyboardInterrupt):
            die("cancelled")
        if answer != phrase:
            die("cancelled: input did not match")
    by_project: dict[str, list[str]] = {}
    for t in targets:
        by_project.setdefault(str(t.get("project")), []).append(str(t.get("id") or t.get("session_id") or ""))
    res["how"] = {}
    for nm, _sids in by_project.items():
        closed, errors, how = close_sessions(nm, session_id=session)
        res["closed"].extend(closed)
        res["errors"].extend(errors)
        res["how"].update(how)
    if as_json:
        print(json.dumps(res, indent=2, ensure_ascii=False))
    else:
        if res["closed"]:
            print(f"stopped {len(res['closed'])} session(s): "
                  + ", ".join(f"pid {p} ({res.get('how', {}).get(p, '-')})" for p in res["closed"]))
        for e in res["errors"]:
            print(dim("  " + e))
        if not res["closed"]:
            print(dim("nothing was stopped"))
    return res


def other_live_sessions(project: str) -> list[dict]:
