    mins = int((s.get("age_s") or 0) // 60)
    return f"{mins}m" if mins < 60 else f"{mins // 60}h{mins % 60:02d}"


def profile_stats(name: str) -> dict:
    home = profile_home(name)
    cfg = home / "config.yaml"
    model = _yaml_scalar(cfg, "model", "default") or _yaml_scalar(cfg, "model.default") or "-"
    cwd = _yaml_scalar(cfg, "terminal", "cwd") or "-"
    skills_dir = home / "skills"
    skills = 0
    if skills_dir.exists():
        for md in skills_dir.rglob("SKILL.md"):
            skills += 1
    mem = size_of(home / "memories")
    last = None
    for cand in (home / "state.db", home / "logs" / "agent.log", home):
        try:
            if cand.exists():
                last = cand.stat().st_mtime
                break
        except OSError:
            pass
    return {
        "name": name,
        "home": str(home),
        "model": model,
        "cwd": cwd,
        "skills": skills,
        "memory_bytes": mem,
        "last_used": last,
        "gateway": gateway_state(name),
        "sessions": live_sessions(name),
        "active": active_profile() == name or (name == DEFAULT_HERMES and not active_profile()),
        "description": description(name),
        "exists": home.exists(),
    }


