def do_rename(old: str, new: str, *, dry: bool = False):
    """Rename a project: alias, profile directory, sticky default and herman's own notes.

    Refused up front when the name is impossible or already taken, because the engine's own error
    arrives after it has started moving things. `default` is the installation root, so Hermes cannot
    move it: for that one name the engine stores a display name and the id stays `default`, which the
    output says plainly instead of pretending the project was renamed.
    """
    ensure_profile(old)
    new = (new or "").strip()
    if old == new:
        die(f"'{old}' is already the name; nothing to rename")
    if old != DEFAULT_HERMES and not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}", new):
        die(f"new name: {NAME_RULE} · {NAME_NOT} · received {new!r}")
    if profile_exists(new):
        die(f"project '{new}' already exists; pick another name")
    running = profile_stats(old).get("sessions") or []
    if running and not dry:
        warn(f"{len(running)} session(s) are live in '{old}': Hermes stops its gateway, and a "
             f"terminal already open keeps running from the moved path until you restart it")
    res = run_hermes(["profile", "rename", old, new], dry=dry)
    if dry or res.returncode != 0:
        return
    if not profile_exists(new):
        ok(f"{old}: display name set to '{new}' (the profile id stays '{old}')")
        return
    moved = rename_state(old, new)
    ok(f"{old} → {new}")
    notes = [t for t, hit in (("description moved", moved["description"]),
                              ("last project updated", moved["last"])) if hit]
    if moved["history"]:
        notes.append(f"{moved['history']} history entry/entries rewritten")
    if notes:
        print(dim("  herman state: " + ", ".join(notes)))
    print(dim(f"  enter the renamed project: {PROG} -u {new}"))


