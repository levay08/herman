def in_container() -> bool:
    """True when herman runs from a container image (its own marker or the usual runtime files).

    It matters for `sync`: the per-project shortcut wrappers in ~/.local/bin belong to the HOST. Inside
    a container they are simply absent, and writing them there would be useless noise, so the check
    reports them as informational instead of a warning.
    """
    if os.environ.get("HERMAN_IN_CONTAINER"):
        return True
    return any(Path(p).exists() for p in ("/.dockerenv", "/run/.containerenv"))
