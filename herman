def confirm(prompt: str, phrase: str | None = None, assume_yes: bool = False) -> bool:
    if assume_yes:
        return True
    if not sys.stdin.isatty():
        warn("not an interactive terminal; pass -y to continue")
        return False
    try:
        if phrase:
            ans = input(f"{prompt}\n  type '{bold(phrase)}' to continue: ").strip()
            return ans == phrase
        ans = input(f"{prompt} [y/N]: ").strip().lower()
        return ans in ("y", "yes")
    except (EOFError, KeyboardInterrupt):
        print()
        return False


