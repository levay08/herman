def preset_rows() -> list[dict]:
    """The preset table as JSON-ready rows the CLI and the panel both render."""
    groups = dict(ENDPOINT_GROUPS)
    out = []
    for key, label, url, provider, key_env, group, note in ENDPOINT_PRESETS:
        out.append({"key": key, "label": label, "url": url, "provider": provider,
                    "key_env": key_env, "group": group,
                    "group_label": groups.get(group, group), "note": note})
    return out


def preset_by_key(key: str) -> dict:
    """One preset by its short key (lower case; unknown keys answer {})."""
    want = (key or "").strip().lower()
    if not want:
        return {}
    for row in preset_rows():
        if row["key"] == want:
            return row
    return {}


def preset_for_url(url: str) -> dict:
    """The preset a URL belongs to, so a typed or edited URL still gets the right provider."""
    want = normalize_endpoint(url).lower().rstrip("/")
    if not want:
        return {}
    for row in preset_rows():
        if normalize_endpoint(row["url"]).lower().rstrip("/") == want:
            return row
    return {}


def normalize_endpoint(url: str) -> str:
    """One spelling per endpoint: no surrounding space, one trailing slash at most, none at the end.

    `model.base_url` is compared as a string in several places (the catalog cache is keyed by it,
    the panel marks the current endpoint), so `https://host/v1/` and `https://host/v1` must not be
    two different endpoints.
    """
    return re.sub(r"/+$", "", (url or "").strip())


def endpoint_problem(url: str) -> str:
    """Why this base_url cannot be written, or "" when Hermes can use it."""
    u = normalize_endpoint(url)
    if not u:
        return "the endpoint is empty"
    if len(u) > 300:
        return "the endpoint is longer than 300 characters"
    if any(ch.isspace() or ord(ch) < 32 for ch in u):
        return "the endpoint must not contain spaces or control characters"
    parts = urllib.parse.urlsplit(u)
    if parts.scheme not in ("http", "https"):
        return "the endpoint must start with http:// or https://"
    if not parts.netloc:
        return "the endpoint has no host"
    if parts.query or parts.fragment:
        return "the endpoint must not carry a query string or a fragment"
    return ""


def _env_value(path: Path, var: str) -> str:
    """One variable out of an .env file, for TESTS only: the value is never printed anywhere."""
    if not path.exists() or not var:
        return ""
    try:
        for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
            line = line.strip()
            if line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            if k.strip() == var:
                return v.strip().strip('"').strip("'")
    except OSError:
        pass
    return ""


def endpoint_key(name: str, base_url: str) -> str:
    """The key to send to THIS endpoint, or "" when it needs none.

    Three rules, in this order: a loopback server needs no key (and a project key must not travel to
    one), `model.api_key` is sent only to the URL the project is CONFIGURED with and only when the
    configured provider is one Hermes reads that key for (custom/openrouter), and a known provider
    uses the .env variable its preset names. So a preset whose key sits in .env still reports
    "reachable", and testing an unrelated host never ships the project's key.
    """
    provider, cfg_url, cfg_key = model_endpoint(name)
    host = (urllib.parse.urlsplit(normalize_endpoint(base_url)).hostname or "").lower()
    if host in ("127.0.0.1", "localhost", "::1", "0.0.0.0"):
        return ""
    if (cfg_key and provider.lower() in ("custom", "openrouter", "")
            and (not base_url or normalize_endpoint(cfg_url) == normalize_endpoint(base_url))):
        return cfg_key
    preset = preset_for_url(base_url)
    if preset.get("key_env"):
        return _env_value(profile_home(name) / ".env", preset["key_env"])
    return ""


def _models_surface(base_url: str) -> list[str]:
    """Candidate model-list URLs for one base_url, the most likely one first.

    Both spellings are common in the wild: a host whose documented base already ends in a version
    segment (OpenAI /v1, Gemini /openai, Z.AI /v4) answers at <base>/models, while the others
    (a hub preset, DeepSeek, Ollama, Groq) answer at <base>/v1/models. herman used to append
    "/v1/models" unconditionally, so half of the documented endpoints replied 404 with an empty
    picker; the candidates are tried in order and the one that answers is remembered.
    """
    base = normalize_endpoint(base_url)
    if base.endswith(("/v1", "/openai", "/v4")):
        return [base + "/models", base + "/v1/models"]
    return [base + "/v1/models", base + "/models"]


def _models_request(url: str, key: str, timeout: int = 8) -> dict:
    """One guarded GET against a candidate model-list URL: status, model ids and raw rows.

    Never raises. Local servers take no key, so an empty key sends no Authorization header at all
    (some of them reject a bogus one); Anthropic's Model API wants x-api-key instead of Bearer.
    """
    headers = {"Accept": "application/json"}
    if key:
        headers["Authorization"] = "Bearer " + key
        if "anthropic.com" in url:
            headers["x-api-key"] = key
            headers["anthropic-version"] = "2023-06-01"
    try:
        req = urllib.request.Request(url, headers=headers)
        with urllib.request.urlopen(req, timeout=timeout) as r:
            status = int(getattr(r, "status", 200) or 200)
            payload = json.loads(r.read(2_000_000).decode("utf-8", "replace"))
    except urllib.error.HTTPError as exc:
        return {"ok": False, "status": int(exc.code), "ids": [], "rows": [],
                "error": f"HTTP {exc.code}"}
    except Exception as exc:
        return {"ok": False, "status": 0, "ids": [], "rows": [], "error": type(exc).__name__}
    if isinstance(payload, dict):
        items = (payload.get("data") or payload.get("models") or payload.get("model_list")
                 or (payload if payload.get("object") == "list" else None))
        if items is None:
            return {"ok": False, "status": status, "ids": [], "rows": [],
                    "error": "answered without a model list"}
    else:
        items = payload
    if isinstance(items, dict):
        items = list(items.values())
    ids, rows = [], []
    for it in items or []:
        if isinstance(it, dict):
            mid = it.get("id") or it.get("model") or it.get("name")
            rows.append(it)
        else:
            mid = str(it)
            rows.append({"id": mid})
        if mid:
            ids.append(str(mid))
    return {"ok": bool(ids), "status": status, "ids": ids, "rows": rows[:500],
            "error": "" if ids else "answered without a model list"}


def probe_endpoint(base_url: str, key: str = "", *, timeout: int = 8) -> dict:
    """Find and read one endpoint's model list. Always answers, never raises.

    Shape: ``ok``, ``endpoint``, ``url`` (the path that answered), ``status``, ``count``,
    ``sample``, ``rows``, ``needs_key``, ``error``, ``tried``. Without an API key a 401/403 still
    means "the right endpoint, it wants a key", so it is reported that way instead of as a failure;
    404 on every candidate means the base URL points at the wrong path.
    """
    base = normalize_endpoint(base_url)
    tried: list[dict] = []
    best: dict = {}
    for path in _models_surface(base):
        res = _models_request(path, key, timeout=timeout)
        tried.append({"url": path, "status": res["status"], "models": len(res["ids"]),
                      "error": res["error"]})
        if res["ok"]:
            return {"ok": True, "endpoint": base, "url": path, "status": res["status"],
                    "count": len(res["ids"]), "sample": res["ids"][:8], "rows": res["rows"],
                    "needs_key": False, "error": "", "tried": tried}
        weak = best.get("status") in (None, 0, 404)
        if not best or (weak and res["status"] in (401, 403)):
            best = {"url": path, "status": res["status"], "error": res["error"]}
    status = int(best.get("status") or 0)
    paths = " and ".join(t["url"] for t in tried)
    if status in (401, 403):
        error = f"the endpoint answered {status}: it wants an API key for this project"
    elif status == 404:
        error = f"no model list at {paths}"
    elif status:
        error = f"the endpoint answered {status}: {best.get('error') or 'no model list'}"
    else:
        error = f"the endpoint did not answer ({best.get('error') or 'no response'})"
    return {"ok": False, "endpoint": base, "url": str(best.get("url") or base), "status": status,
            "count": 0, "sample": [], "rows": [], "needs_key": status in (401, 403),
            "error": error, "tried": tried}


def endpoint_report(name: str, base_url: str, key: str = "") -> dict:
    """What the panel and the CLI show about one endpoint: reachable, which path, how many models."""
    rep = probe_endpoint(base_url, key)
    rep["project"] = name
    rep["key_present"] = bool(key)
    rep["preset"] = preset_for_url(base_url)
    return rep


def endpoint_lines(rep: dict, model: str = "") -> list[str]:
    """The endpoint report as terminal lines (shared by `model --probe` and `--endpoint`)."""
    lines = [f"endpoint : {rep.get('endpoint') or '-'}"]
    if rep.get("ok"):
        lines.append(f"models   : {rep['count']} from {rep['url']}")
        if rep.get("sample"):
            lines.append("examples : " + ", ".join(rep["sample"][:4]))
    else:
        lines.append(f"models   : none ({rep.get('error') or 'unknown error'})")
    for t in rep.get("tried") or []:
        note = f" · {t['models']} models" if t.get("models") else ""
        if not t.get("models") and t.get("error"):
            note = f" ({t['error']})"
        lines.append(f"tried    : {t['url']} -> {t['status'] or 'no answer'}{note}")
    if rep.get("key_present"):
        lines.append("api key  : sent with the request")
    else:
        lines.append("api key  : none configured for this project")
    if model and rep.get("ok"):
        if str(model) in (rep.get("sample") or []) or any(
                str(model) == str(r.get("id")) for r in (rep.get("rows") or [])):
            lines.append(f"model    : '{model}' is offered here")
        else:
            lines.append(f"model    : '{model}' is NOT in this list (pick another model after "
                         f"switching)")
    return lines


def do_endpoint(name: str, target: str, provider: str | None = None, *,
                dry: bool = False) -> dict:
    """Point one project at another endpoint: the ONLY writer of model.base_url.

    `target` is a preset key, an http(s) URL, or `default` to drop the key and fall back to what
    the configured provider ships. Every write goes through `hermes config set/unset`, so Hermes
    itself sees exactly what the panel reports; afterwards the new endpoint is asked for its model
    list at once, because a picker that quietly keeps serving the old list is worse than a failure.
    """
    ensure_profile(name)
    cur_provider, cur_url, _ = model_endpoint(name)
    target = (target or "").strip()
    preset = preset_by_key(target) or preset_for_url(target)
    clearing = target.lower() in ("default", "none", "clear", "unset")
    if not target:
        die("an endpoint is needed: a preset key, an http(s) URL, or `default` to clear it")
    if not clearing and not preset and "://" not in target:
        die(f"'{target}' is neither a preset key nor an http(s) URL: run "
            f"`{PROG} model {name} --endpoints` for the list of keys")
    url = "" if clearing else normalize_endpoint(preset.get("url") or target)
    if not clearing:
        problem = endpoint_problem(url)
        if problem:
            die(f"refusing to write model.base_url: {problem}")
    want_provider = (provider or "").strip() or str(preset.get("provider") or "")
    done: list[str] = []

    def write(args: list[str], label: str) -> bool:
        res = run_hermes(["config"] + args, name, dry=dry, quiet=True)
        if dry:
            done.append(f"[dry-run] hermes -p {name} config {' '.join(args)}")
            return True
        if res.returncode != 0:
            err = ((res.stderr or res.stdout or "").strip().splitlines() or
                   ["hermes config failed"])[-1]
            die(f"{label} was refused by Hermes: {err}")
        done.append(f"hermes -p {name} config {' '.join(args)}")
        return True

    if clearing:
        if cur_url:
            write(["unset", "model.base_url"], "clearing model.base_url")
    else:
        if url != cur_url:
            write(["set", "model.base_url", url], "writing model.base_url")
        if want_provider and want_provider != cur_provider:
            write(["set", "model.provider", want_provider], "writing model.provider")
    # "cleared" means "whatever the provider ships": the project can still inherit the GLOBAL Hermes
    # config, so the effective URL is read back after the write and reported as inherited instead of
    # pretending the project has no endpoint at all.
    inherited = ""
    if clearing:
        _, inherited, _ = model_endpoint(name)
    eff = "" if clearing else url
    target_url = eff or inherited
    rep = endpoint_report(name, target_url, endpoint_key(name, target_url)) if target_url else {}
    model = configured_model(name)
    title = (f"{PROG} model {name} · endpoint "
             + ("cleared" if clearing else ("updated" if done else "unchanged")))
    lines = done + [""]
    if rep:
        if inherited:
            lines.append("base_url : removed from this project's Hermes config")
            lines.append(f"falls back: {inherited} (the global Hermes config)")
            lines += endpoint_lines(rep, model)[1:]
        else:
            lines += endpoint_lines(rep, model)
        if not rep.get("ok") and rep.get("needs_key") and preset.get("key_env"):
            lines.append(f"next     : add {preset['key_env']} for this project")
            lines.append(f"           herman access set-env {name} {preset['key_env']}")
        elif not rep.get("ok") and rep.get("needs_key"):
            lines.append(f"next     : add the API key for this project under Access -> API keys")
        elif not rep.get("ok"):
            lines.append("next     : check the URL, then Test again; Hermes keeps the old list "
                         "until the endpoint answers")
    if clearing and not inherited:
        lines.append("base_url : removed: Hermes now uses the provider's own default")
    if not clearing:
        lines.append(f"config   : hermes uses this for every new session of '{name}'" if done
                     else "config   : the project already points there, nothing was written")
    print_frame(title, lines, color=amber if (rep and not rep.get("ok")) else green)
    if rep and not rep.get("ok"):
        print(amber(f"  the endpoint did not answer: the model list stays as it is until it does"))
    return {"ok": bool(rep.get("ok")) if rep else True, "url": url, "provider": want_provider,
            "wrote": done, "probe": rep}


def _provider_models(provider: str | None) -> list[str]:
    """Model ids cached for the configured provider (provider_models_cache.json)."""
    cache = Path.home() / ".hermes" / "provider_models_cache.json"
    try:
        data = json.loads(cache.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return []
    if provider and provider in data:
        return list(data[provider].get("models") or [])
    out: list[str] = []
    for v in data.values():
        if isinstance(v, dict):
            out.extend(v.get("models") or [])
    return sorted(set(out))


def _ctx_label(n: int) -> str:
    return f"{n / 1_000_000:.1f}M" if n >= 1_000_000 else f"{max(n // 1000, 1)}K"


def catalog_meta() -> dict:
    """id -> {provider, context, prices} from an optional local catalog file.

    ``models-local.json`` is USER DATA, not part of the tool: it holds whatever catalog the
    operator dropped there (their provider list with prices). Looked up next to the script too, so a
    redirected HOME (sandbox/test) still finds it. Empty when nobody provided one.
    """
    candidates = [CATALOG_FILE,
                  Path(__file__).resolve().parent.parent / "share" / PROG / CATALOG_FILE.name,
                  Path.home() / ".local" / "share" / PROG / CATALOG_FILE.name]
    for c in candidates:
        try:
            data = json.loads(c.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        if data.get("models"):
            return {m["id"]: _clean_row(m) for m in data["models"] if m.get("id")}
    return {}


def _clean_row(row: dict) -> dict:
    """Drop em dashes the vendor list uses as an empty marker (house rule: no em dash)."""
    return {k: (v.replace("\u2014", "").replace("\u2013", "").strip()
                if isinstance(v, str) else v) for k, v in row.items()}


def hermes_models_cache() -> dict:
    """The engine's own provider/model cache (``models_dev_cache.json``), read not guessed.

    Hermes refreshes that file for its model picker: provider blocks with their models, context
    limits and USD prices. herman reads the same file so a project that talks to a provider WITHOUT a
    custom base_url still gets a real model list, and so a dead endpoint has a sane fallback. Every
    candidate path is tried (HERMES_HOME first, so a profile/sandbox resolves its own copy).
    """
    candidates = []
    env_home = (os.environ.get("HERMES_HOME") or "").strip()
    if env_home:
        candidates.append(Path(env_home) / "models_dev_cache.json")
    candidates += [Path.home() / ".hermes" / "models_dev_cache.json",
                   Path.home() / ".cache" / "hermes" / "models_dev_cache.json"]
    for cand in candidates:
        try:
            data = json.loads(cand.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        if isinstance(data, dict) and data:
            return data
    return {}


def _usd(value) -> str:
    """USD per 1M tokens as the catalog file writes it (4 decimals under a dollar, else 2)."""
    try:
        num = float(value)
    except (TypeError, ValueError):
        return ""
    if num <= 0:
        return ""
    return f"{num:.4f}" if num < 1 else f"{num:.2f}"


def _row_from_meta(mid: str, meta: dict, provider_label: str) -> dict:
    meta = meta if isinstance(meta, dict) else {}
    cost = meta.get("cost") if isinstance(meta.get("cost"), dict) else {}
    limits = meta.get("limit") if isinstance(meta.get("limit"), dict) else {}
    row = {"id": str(mid), "provider": provider_label,
           "input_usd": _usd(cost.get("input")), "output_usd": _usd(cost.get("output")),
           "cache_usd": _usd(cost.get("cache_read"))}
    ctx = limits.get("context") or meta.get("context")
    try:
        if ctx:
            row["context"] = _ctx_label(int(ctx))
    except (TypeError, ValueError):
        pass
    return row


def hermes_catalog(provider: str, model: str, *, limit: int = 600) -> list[dict]:
    """Model rows for a project from Hermes' own cache: the fallback when there is no endpoint list.

    Picks the provider the project is configured with; when the config says ``custom`` (or nothing) it
    follows the model id's own prefix, then the provider that owns that exact model id. An empty list
    means the cache knows nothing about this project, and the ladder then falls through to the user
    catalog file and finally to the configured model alone.
    """
    data = hermes_models_cache()
    want = (provider or "").strip().lower()
    model_id = (model or "").strip()
    if not data:
        return []
    keys = {str(k).lower(): k for k in data}
    picked: list[tuple[str, dict]] = []
    if want and want in keys:
        picked = [(want, data[keys[want]])]
    else:
        guess = model_id.split("/")[0].strip().lower() if "/" in model_id else ""
        if guess and guess in keys:
            picked = [(guess, data[keys[guess]])]
        else:
            for key, block in data.items():
                models = (block or {}).get("models") if isinstance(block, dict) else None
                if model_id and isinstance(models, dict) and model_id in models:
                    picked = [(str(key), block)]
                    break
    rows: list[dict] = []
    for key, block in picked:
        block = block if isinstance(block, dict) else {}
        label = str(block.get("name") or key)
        models = block.get("models") if isinstance(block.get("models"), dict) else {}
        for mid, meta in models.items():
            rows.append(_row_from_meta(mid, meta, label))
            if len(rows) >= limit:
                break
        if len(rows) >= limit:
            break
    return rows                      # empty means "the cache knows nothing about this project"


def enrich_prices(rows: list[dict]) -> None:
    """Fill in missing prices/context on endpoint rows from Hermes' own price cache (best effort)."""
    if not any(not r.get("input_usd") for r in rows):
        return
    prices = _price_catalog()
    if not prices:
        return
    for row in rows:
        if row.get("input_usd") and row.get("output_usd"):
            continue
        hit = _model_price(str(row.get("id") or ""), prices)
        if not hit:
            continue
        row["input_usd"] = row.get("input_usd") or _usd(hit.get("input"))
        row["output_usd"] = row.get("output_usd") or _usd(hit.get("output"))
        row["cache_usd"] = row.get("cache_usd") or _usd(hit.get("cache_read"))
        if not row.get("context") and hit.get("context"):
            try:
                row["context"] = _ctx_label(int(hit["context"]))
            except (TypeError, ValueError):
                pass


CATALOG_SOURCES = {
    "live": "live from the project endpoint",
    "cache": "cached answer from the project endpoint",
    "hermes": "Hermes local model data (engine cache)",
    "provider-cache": "Hermes provider cache",
    "file": "optional local catalog file",
    "config": "the project's configured model only",
    "none": "unavailable",
}


def catalog_source_label(source: str) -> str:
    return CATALOG_SOURCES.get(str(source or ""), str(source or "-"))


def ensure_current(rows: list[dict], model: str, provider: str) -> list[dict]:
    """Guarantee the project's own model is in its picker.

    Whatever the list came from (a live endpoint, Hermes' cache, the user file), the model a project
    is actually running must be visible there: a picker that hides the current choice reads as broken.
    """
    model = (model or "").strip()
    if not model or any(str(r.get("id")) == model for r in rows):
        return rows
    # `_configured` marks the row herman added: the endpoint did NOT offer it, so no count or table
    # may present it as part of the endpoint's list.
    rows.insert(0, {"id": model, "provider": provider or "configured", "input_usd": "",
                    "output_usd": "", "cache_usd": "", "_configured": True})
    return rows


def configured_model(name: str) -> str:
    """The project's model.default (falls back to the global Hermes config)."""
    return (_yaml_scalar(profile_home(name) / "config.yaml", "model", "default")
            or _yaml_scalar(Path.home() / ".hermes" / "config.yaml", "model", "default")
            or "").strip()


def model_endpoint(name: str) -> tuple[str, str, str]:
    """(provider, base_url, api_key) of a project, falling back to the global Hermes config."""
    cfg = profile_home(name) / "config.yaml"
    gcfg = Path.home() / ".hermes" / "config.yaml"

    def pick(key: str) -> str:
        root = cfg if cfg.exists() else gcfg
        return (_yaml_scalar(root, "model", key) or _yaml_scalar(gcfg, "model", key) or "").strip()

    return pick("provider"), pick("base_url"), pick("api_key")


def endpoint_catalog(name: str, *, force: bool = False, max_age: int = 12 * 3600,
                     persist: bool = True) -> dict:
    """The model list for one project, resolved in the order Hermes itself would use it.

    1. the project's own endpoint (see `probe_endpoint`: both common model-list spellings are tried,
       the API key is sent only when the project has one because plenty of local servers need none),
       cached for 12h per base_url AND per answered path
    2. Hermes' own local provider cache when there is no base_url at all (a plain provider such as
       openai/anthropic/nous) or when the endpoint answered nothing
    3. the optional user catalog file ``models-local.json``
    4. the project's configured model on its own, so the board is never empty

    Nothing here can raise: every read and every request is guarded, and the returned dict always has
    the same shape (``source``, ``endpoint``, ``provider``, ``models``, ``age_s`` plus ``url``,
    ``status``, ``error`` and ``needs_key`` describing what the endpoint answered). ``persist=False``
    fetches live without touching the 12h cache, which is what ``sync --dry-run`` needs.
    """
    meta = catalog_meta()
    provider, base_url, _ = model_endpoint(name)
    key = endpoint_key(name, base_url)
    model = configured_model(name)
    cache: dict = {}
    try:
        cache = json.loads(CATALOG_CACHE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        cache = {}
    age = time.time() - float(cache.get("ts") or 0)
    if (base_url and not force and cache.get("models") and cache.get("base_url") == base_url
            and age < max_age):
        return {"source": cache.get("source", "cache"), "endpoint": base_url, "provider": provider,
                "models": ensure_current(list(cache["models"]), model, provider), "age_s": int(age),
                "url": cache.get("url") or "", "status": int(cache.get("status") or 200),
                "error": "", "needs_key": False}
    live: list[dict] = []
    probe: dict = {}
    if base_url:
        try:
            probe = probe_endpoint(base_url, key)
        except Exception:
            probe = {}
        for it in probe.get("rows") or []:
            mid = (it.get("id") or it.get("model") or it.get("name")
                   if isinstance(it, dict) else str(it))
            if not mid:
                continue
            m = _clean_row(dict(meta.get(str(mid)) or {}))
            m["id"] = str(mid)
            m.setdefault("provider", provider or "endpoint")
            if not m.get("context") and isinstance(it, dict) and it.get("max_input_tokens"):
                try:
                    m["context"] = _ctx_label(int(it["max_input_tokens"]))
                except (TypeError, ValueError):
                    pass
            live.append(m)
    if live:
        live.sort(key=lambda m: (str(m.get("provider") or ""), m["id"]))
        try:
            enrich_prices(live)
        except Exception:
            pass
        if persist:
            try:
                CATALOG_CACHE.parent.mkdir(parents=True, exist_ok=True)
                CATALOG_CACHE.write_text(json.dumps(
                    {"ts": time.time(), "base_url": base_url, "url": probe.get("url") or "",
                     "status": probe.get("status") or 0, "source": "live", "models": live}),
                    encoding="utf-8")
            except OSError:
                pass
        return {"source": "live", "endpoint": base_url, "provider": provider,
                "models": ensure_current(live, model, provider), "age_s": 0,
                "url": probe.get("url") or "", "status": probe.get("status") or 0,
                "error": "", "needs_key": False}
    fallback = {"url": probe.get("url") or "", "status": probe.get("status") or 0,
                "error": probe.get("error") or "", "needs_key": bool(probe.get("needs_key"))}
    rows = hermes_catalog(provider, model)
    if rows:
        return dict({"source": "hermes", "endpoint": base_url, "provider": provider,
                     "models": ensure_current(rows, model, provider), "age_s": None}, **fallback)
    ids = _provider_models(None if provider in ("", "-") else provider)
    if ids:
        label = provider or "configured"
        return dict({"source": "provider-cache", "endpoint": base_url, "provider": provider,
                     "models": ensure_current(
                         [{"id": mid, "provider": label, "input_usd": "", "output_usd": "",
                           "cache_usd": ""} for mid in sorted(set(ids))][:600], model, provider),
                     "age_s": None}, **fallback)
    user_rows = sorted(meta.values(), key=lambda m: (str(m.get("provider") or ""), m["id"]))
    if user_rows:
        return dict({"source": "file", "endpoint": base_url, "provider": provider,
                     "models": ensure_current(list(user_rows), model, provider), "age_s": None},
                    **fallback)
    if model:
        return dict({"source": "config", "endpoint": base_url, "provider": provider,
                     "models": [{"id": model, "provider": provider or "configured",
                                 "input_usd": "", "output_usd": "", "cache_usd": ""}],
                     "age_s": None}, **fallback)
    return dict({"source": "none", "endpoint": base_url, "provider": provider,
                 "models": [], "age_s": None}, **fallback)


def model_report(name: str, *, refresh: bool = False) -> dict:
    cfg = profile_home(name) / "config.yaml"
    gcfg = Path.home() / ".hermes" / "config.yaml"
    provider = (_yaml_scalar(cfg, "model", "provider") or _yaml_scalar(gcfg, "model", "provider")
                or "-")
    model = (_yaml_scalar(cfg, "model", "default") or _yaml_scalar(gcfg, "model", "default")
             or "-")
    base_url = (_yaml_scalar(cfg, "model", "base_url") or _yaml_scalar(gcfg, "model", "base_url")
                or "-")
    _, _url, _cfg_key = model_endpoint(name)
    key = endpoint_key(name, base_url if base_url != "-" else "")
    cat = endpoint_catalog(name, force=refresh)
    preset = preset_for_url(base_url) if base_url not in ("-", "") else {}
    return {
        "project": name,
        "provider": provider,
        "model": model,
        "base_url": base_url,
        "key_present": bool(key),
        "available": _provider_models(None if provider in ("-", "") else provider),
        "catalog": cat["models"],
        "catalog_offered": sum(1 for m in cat["models"] if not m.get("_configured")),
        "catalog_source": cat["source"],
        "catalog_age_s": cat["age_s"],
        "catalog_endpoint": cat["endpoint"] or base_url,
        "endpoint_preset": preset.get("key", ""),
        "endpoint_preset_label": preset.get("label", ""),
        "endpoint_note": preset.get("note", ""),
        "endpoint_key_env": preset.get("key_env", ""),
        "endpoint_url": cat.get("url") or "",
        "endpoint_status": cat.get("status") or 0,
        "endpoint_error": cat.get("error") or "",
        "endpoint_needs_key": bool(cat.get("needs_key")),
        "presets": preset_rows(),
        "preset_groups": [{"key": k, "label": v} for k, v in ENDPOINT_GROUPS],
    }


def do_model(name: str, *, set_model: str | None = None, provider: str | None = None,
             list_models: bool = False, refresh: bool = False, list_endpoints: bool = False,
             endpoint: str | None = None, probe: str | None = None, dry: bool = False):
    ensure_profile(name)
    if endpoint is not None:
        do_endpoint(name, endpoint, provider=provider, dry=dry)
        return
    rep = model_report(name, refresh=refresh)
    if probe is not None:
        _, base_url, _ = model_endpoint(name)
        target = (probe or "").strip()
        preset = preset_by_key(target)
        url = preset.get("url") or normalize_endpoint(target) or base_url
        if not url:
            die("no endpoint to test: pass a URL or a preset key, or set one first "
                f"({PROG} model {name} --endpoints)")
        if target and not preset:
            problem = endpoint_problem(url)
            if problem:
                die(f"cannot test that endpoint: {problem}")
        result = endpoint_report(name, url, endpoint_key(name, url))
        print_frame(f"{PROG} model {name} · endpoint test (nothing written)",
                    endpoint_lines(result, rep["model"]),
                    color=green if result["ok"] else amber)
        if not result["ok"] and result.get("needs_key"):
            print(dim(f"  a key for this project: {PROG} access set-env {name} <VAR>"))
        return
    if list_endpoints:
        rows, group = [], ""
        for pre in preset_rows():
            if pre["group"] != group:
                group = pre["group"]
                if rows:
                    rows.append("")
                rows.append(pre["group_label"])
            mark = "  <- current" if rep["endpoint_preset"] == pre["key"] else ""
            rows.append(f"  {pre['key']:<12} {fit(pre['url'], 44):<44} "
                        f"{pre['key_env'] or '-'}{mark}")
        print_frame(f"{PROG} model {name} · {len(preset_rows())} endpoints to pick from",
                    rows, color=cyan)
        print(dim(f"  current: {rep['base_url']}   ·   any other URL: "
                  f"{PROG} model {name} --endpoint https://host/v1"))
        print(dim(f"  test before switching: {PROG} model {name} --probe <url|key>"
                  f"   ·   back to the provider default: --endpoint default"))
        return
    if list_models:
        cat = endpoint_catalog(name, force=refresh)
        rows = []
        group = ""
        injected = 0
        offered = sum(1 for m in cat["models"] if not m.get("_configured"))
        for m in cat["models"]:
            g = str(m.get("provider") or "endpoint")
            label = ("" if g == group else g)
            group = g
            inp, outp = (m.get("input_usd") or "").strip(), (m.get("output_usd") or "").strip()
            price = f"${inp} / ${outp}" if (inp or outp) else "price n/a"
            if m.get("_configured"):
                mark = " *"
                injected += 1
            elif m["id"] == rep["model"]:
                mark = " ← current"
            else:
                mark = ""
            rows.append([label, m["id"] + mark, str(m.get("context") or "-"), price])
        where = (f"from {cat.get('url') or cat['endpoint']}"
                 if cat["source"] in ("live", "cache") and cat["endpoint"]
                 else f"from {catalog_source_label(cat['source'])}")
        print_frame(f"{PROG} model {name} · {offered} models {where}" if offered
                    else f"{PROG} model {name} · no model list {where}",
                    [f"{r[0]:<10} {r[1]:<30} {r[2]:>6}  in/out {r[3]}" for r in rows] or
                    ["no model list available: set model.base_url, or let Hermes fetch its model "
                     "list once (hermes model)"], color=cyan)
        print(dim(f"  source: {catalog_source_label(cat['source'])}"
                  f"   ·   change: {PROG} model {name} --set <model-id>"))
        if injected:
            print(dim(f"  * the configured model '{rep['model']}': this endpoint does not offer it, "
                      f"so a session would likely fail until you --set another one"))
        return
    if not set_model and not provider:
        print(f"{name}: model = {bold(rep['model'])}   provider = {bold(rep['provider'])}")
        if rep["base_url"] == "-":
            print(dim("  endpoint: the provider's own default (no model.base_url set)"
                      f"   ·   pick one: {PROG} model {name} --endpoints"))
        else:
            tag = f" [{rep['endpoint_preset']}]" if rep["endpoint_preset"] else ""
            print(dim(f"  endpoint: {rep['base_url']}{tag}"
                      f"   ·   switch: {PROG} model {name} --endpoints"
                      f"   ·   test: {PROG} model {name} --probe"))
        if rep["catalog"]:
            where = (rep["catalog_endpoint"] if rep["catalog_source"] in ("live", "cache")
                     and rep["catalog_endpoint"] else catalog_source_label(rep["catalog_source"]))
            print(dim(f"  {rep['catalog_offered'] or len(rep['catalog'])} models available "
                      f"from {where}   ·   list them: {PROG} model {name} --list"))
        elif rep["endpoint_error"]:
            print(amber(f"  endpoint: {rep['endpoint_error']}"))
        print(dim(f"  change model: {PROG} model {name} --set <model-id> [--provider <name>]"))
        return
    if provider:
        res = run_hermes(["config", "set", "model.provider", provider], name, dry=dry)
        if not dry and res.returncode == 0:
            ok(f"provider of '{name}' → {provider}")
    if set_model:
        if (rep["catalog"] and rep["catalog_source"] in ("live", "cache")
                and not any(m["id"] == set_model for m in rep["catalog"])):
            print(amber(f"note: '{set_model}' is not in the list of "
                        f"{rep['catalog_endpoint'] or 'this endpoint'} ({len(rep['catalog'])} models)"))
        res = run_hermes(["config", "set", "model.default", set_model], name, dry=dry)
        if not dry and res.returncode == 0:
            ok(f"model of '{name}' → {set_model}")
    if not dry:
        do_model(name)


def git_report(name: str) -> dict:
    st = profile_stats(name)
    out = {"project": name, "workdir": None, "repo": False, "branch": None, "dirty": 0,
           "ahead": None, "behind": None, "last_commit": None, "remote": None,
           "root": None, "msg": "", "remotes": [], "user_name": "", "user_email": "",
           "helper": "", "init_branch": ""}
    if st["cwd"] in ("-", ""):
        out["msg"] = "no workdir set"
        return out
    wd = Path(st["cwd"]).expanduser()
    out["workdir"] = str(wd)
    if not wd.exists():
        out["msg"] = "workdir does not exist"
        return out
    if not GIT:
        out["msg"] = "git is not installed"
        return out

    def g(*args: str) -> str:
        res = run([GIT, "-C", str(wd)] + list(args), capture=True)
        return (res.stdout or "").strip() if res.returncode == 0 else ""

    if g("rev-parse", "--is-inside-work-tree") != "true":
        out["msg"] = "not a git repository"
        return out
    out["repo"] = True
    out["root"] = g("rev-parse", "--show-toplevel")
    out["branch"] = g("rev-parse", "--abbrev-ref", "HEAD")
    porcelain = g("status", "--porcelain")
    out["dirty"] = len([ln for ln in porcelain.splitlines() if ln.strip()])
    out["last_commit"] = g("log", "-1", "--pretty=%h %s")
    out["remote"] = g("remote", "get-url", "origin") or None
    out["user_name"] = g("config", "--local", "user.name")
    out["user_email"] = g("config", "--local", "user.email")
    out["helper"] = g("config", "--local", "credential.helper")
    out["init_branch"] = g("symbolic-ref", "--short", "HEAD")
    seen: dict[str, str] = {}
    for line in g("remote", "-v").splitlines():
        parts = line.split()
        if len(parts) >= 2 and parts[0] not in seen:
            seen[parts[0]] = parts[1]
    out["remotes"] = [{"name": k, "url": v} for k, v in sorted(seen.items())]
    ab = g("rev-list", "--left-right", "--count", "@{u}...HEAD")
    if ab:
        parts = ab.split()
        if len(parts) == 2:
            out["behind"], out["ahead"] = int(parts[0]), int(parts[1])
    return out


def do_git(name: str, sub: str | None = None, *, dry: bool = False, **kw):
    """Show or edit the git setup that belongs to a project workdir.

    Edits are repo-local (`git -C <workdir> config …`): they change the
    checkout Hermes works in, not your global git identity.
    """
    ensure_profile(name)
    st = profile_stats(name)
    if st["cwd"] in ("-", ""):
        if sub == "set-workdir" and kw.get("path"):
            do_cwd(name, kw["path"], dry=dry)
            st = profile_stats(name)
        else:
            print_frame(f"git · {name}", [
                amber("no workdir set for this project"),
                "",
                f"set one:   {PROG} -C {name} <path>",
                f"then:      {PROG} git {name}",
            ], color=amber, width=min(term_width(), 96))
            return
    wd = Path(st["cwd"]).expanduser()
    if sub and sub != "set-workdir" and not wd.exists():
        die(f"workdir does not exist: {wd}")

    def g(*args: str) -> subprocess.CompletedProcess:
        return run([GIT, "-C", str(wd)] + list(args), capture=True)

    if sub in (None, "", "show"):
        rep = git_report(name)
        print()
        print_git_report(rep)
        print()
        print(dim(f"  edit: {PROG} git {name} init | set-user --name N --email E | "
                  f"set-remote origin <url> | rm-remote <name> | set-helper store|none"))
        print(dim(f"  workdir: {PROG} -C {name} <path>"))
        return

    if not GIT:
        die("git is not installed")
    if sub == "set-workdir":
        do_cwd(name, kw.get("path"), dry=dry)
        return
    if sub == "init":
        if not wd.exists():
            if not dry:
                wd.mkdir(parents=True, exist_ok=True)
            print(dim(f"  created {wd}"))
        if dry:
            print(dim(f"  [dry-run] git -C {wd} init"))
            return
        res = g("init")
        print((res.stdout or res.stderr).strip())
        if res.returncode == 0:
            ok(f"git repository initialised in {wd}")
        return
    if g("rev-parse", "--is-inside-work-tree").stdout.strip() != "true":
        die(f"{wd} is not a git repository; run: {PROG} git {name} init")
    if sub == "set-user":
        for key, val in (("user.name", kw.get("user_name")), ("user.email", kw.get("user_email"))):
            if val:
                res = g("config", "--local", key, val)
                if not dry and res.returncode == 0:
                    ok(f"{key} → {val}")
        if dry:
            print(dim(f"  [dry-run] git -C {wd} config --local user.name/user.email"))
        return
    if sub == "set-remote":
        rname, url = kw.get("remote_name"), kw.get("url")
        if not rname or not url:
            die(f"usage: {PROG} git {name} set-remote <name> <url>")
        if dry:
            print(dim(f"  [dry-run] git -C {wd} remote add {rname} {url}"))
            return
        if rname in [r["name"] for r in git_report(name)["remotes"]]:
            res = g("remote", "set-url", rname, url)
        else:
            res = g("remote", "add", rname, url)
        if res.returncode == 0:
            ok(f"remote {rname} → {url}")
        else:
            warn((res.stderr or "").strip())
        return
    if sub == "rm-remote":
        rname = kw.get("remote_name")
        if not rname:
            die(f"usage: {PROG} git {name} rm-remote <name>")
        if dry:
            print(dim(f"  [dry-run] git -C {wd} remote remove {rname}"))
            return
        res = g("remote", "remove", rname)
        if res.returncode == 0:
            ok(f"remote {rname} removed")
        else:
            warn((res.stderr or "").strip())
        return
    if sub == "set-helper":
        helper = (kw.get("helper") or "").strip()
        if dry:
            print(dim(f"  [dry-run] git -C {wd} config --local credential.helper {helper or '(unset)'}"))
            return
        if helper in ("", "none", "off"):
            res = g("config", "--local", "--unset", "credential.helper")
        else:
            res = g("config", "--local", "credential.helper", helper)
        if res.returncode in (0, 5):      # 5 = nothing to unset
            ok(f"credential.helper → {helper or '(unset)'}")
        else:
            warn((res.stderr or "").strip())
        return
    die(f"unknown git action '{sub}'. See: {PROG} git {name}")



def _env_names(path: Path) -> list[dict]:
    """Variable names (never values) of an .env file."""
    if not path.exists():
        return []
    names = []
    try:
        for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            names.append({"name": k.strip(), "set": bool(v.strip())})
    except OSError:
        pass
    return names


def ssh_fingerprint(path: Path) -> tuple[str, str, str] | None:
    """(fingerprint, type, comment) of an SSH key file, or None."""
    if not shutil.which("ssh-keygen"):
        return None
    res = run(["ssh-keygen", "-lf", str(path)], capture=True)
    if res.returncode != 0:
        return None
    parts = (res.stdout or "").strip().split(" ", 2)
    if len(parts) < 2:
        return None
    bits, fp = parts[0], parts[1]
    # ``ssh-keygen -lf`` prints "<bits> <fp> <comment> (<type>)": keep the comment whole
    # (including the type suffix) so it matches ``ssh-add -l`` instead of being clipped by
    # strip("()"), which ate the closing bracket.
    comment = parts[2].strip() if len(parts) > 2 else ""
    if comment.lower().startswith("no comment"):
        comment = ""
    return fp, bits, comment


def ssh_agent_keys() -> list[dict]:
    if not shutil.which("ssh-add"):
        return []
    res = run(["ssh-add", "-l"], capture=True)
    if res.returncode != 0:
        return []
    out = []
    for line in (res.stdout or "").splitlines():
        parts = line.split(" ", 2)
        if len(parts) >= 2 and parts[1].startswith("SHA"):
            out.append({"bits": parts[0], "fingerprint": parts[1],
                        "comment": parts[2] if len(parts) > 2 else ""})
    return out


def ssh_hosts() -> list[dict]:
    cfg = Path.home() / ".ssh" / "config"
    hosts: list[dict] = []
    if not cfg.exists():
        return hosts
    cur: dict | None = None
    try:
        lines = cfg.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return hosts
    for line in lines:
        s = line.strip()
        if not s or s.startswith("#"):
            continue
        low = s.lower()
        if low.startswith("host "):
            if cur:
                hosts.append(cur)
            cur = {"alias": s.split(None, 1)[1].strip(), "hostname": "", "user": "",
                   "identity": ""}
        elif cur is not None:
            if low.startswith("hostname "):
                cur["hostname"] = s.split(None, 1)[1].strip()
            elif low.startswith("user "):
                cur["user"] = s.split(None, 1)[1].strip()
            elif low.startswith("identityfile "):
                cur["identity"] = s.split(None, 1)[1].strip()
    if cur:
        hosts.append(cur)
    return hosts


def active_ssh_conns() -> list[str]:
    res = run(["ss", "-tn"], capture=True)
    out = []
    for line in (res.stdout or "").splitlines():
        if ":22 " in line or ":22\t" in line:
            cols = line.split()
            if len(cols) >= 5 and cols[0].upper() == "ESTAB":
                out.append(f"{cols[3]} → {cols[4]}")
    return out


def _mask_secret(value: str) -> str:
    """First 6 and last 4 characters, middle hidden: enough to recognise a key, never enough to use it."""
    v = (value or "").strip()
    if not v:
        return ""
    if len(v) <= 12:
        return v[:2] + "…" + v[-2:]
    return v[:6] + "…" + v[-4:]


def engine_credentials(home: Path) -> list[dict]:
    """Where the engine actually keeps its provider key: config.yaml model.api_key.

    The .env of a profile is the documented home for secrets, so this reports both
    stores side by side (values always masked).
    """
    out: list[dict] = []
    cfg = home / "config.yaml"
    if not cfg.exists():
        return out
    key = _yaml_scalar(cfg, "model", "api_key") or ""
    if key:
        out.append({"name": "model.api_key", "source": "config.yaml", "masked": _mask_secret(key),
                    "set": True, "path": str(cfg)})
    return out


def access_report(name: str) -> dict:
    ensure_profile(name)
    home = profile_home(name)
    ssh_dir = Path.home() / ".ssh"
    keys = []
    if ssh_dir.exists():
        for f in sorted(ssh_dir.iterdir()):
            if not f.is_file() or f.name.endswith(".pub") or f.name.startswith("known_hosts"):
                continue
            info = ssh_fingerprint(f)
            if not info:
                continue
            fp, bits, comment = info
            pub = f.parent / (f.name + ".pub")
            keys.append({"name": f.name, "path": str(f), "bits": bits,
                         "fingerprint": fp, "comment": comment,
                         "perm": oct(f.stat().st_mode & 0o777),
                         "public": pub.read_text(encoding="utf-8").strip() if pub.exists() else ""})
    creds = Path.home() / ".git-credentials"
    cred_hosts = []
    if creds.exists():
        try:
            for line in creds.read_text(encoding="utf-8", errors="replace").splitlines():
                line = line.strip()
                if not line:
                    continue
                m = re.match(r"^([a-z]+)://(?:([^:@/]+)(?::[^@]*)?@)?(.+)$", line)
                if m:
                    cred_hosts.append({"scheme": m.group(1), "user": m.group(2) or "-",
                                       "host": m.group(3).rstrip("/")})
        except OSError:
            pass
    known = ssh_dir / "known_hosts"
    known_count = 0
    known_list: list[str] = []
    if known.exists():
        try:
            for ln in known.read_text(encoding="utf-8", errors="replace").splitlines():
                if not ln.strip():
                    continue
                known_count += 1
                first = ln.split(" ")[0]
                # hashed entries start with |1|; keep them grouped, otherwise split host,alias
                for part in ([] if first.startswith("|") else first.split(",")):
                    if part and part not in known_list:
                        known_list.append(part)
        except OSError:
            pass
    helper = ""
    if GIT:
        res = run([GIT, "config", "--global", "--get", "credential.helper"], capture=True)
        helper = (res.stdout or "").strip()
    return {
        "project": name,
        "home": str(home),
        "api_keys": _env_names(home / ".env"),
        "engine_keys": engine_credentials(home),
        "ssh_keys": keys,
        "agent": ssh_agent_keys(),
        "hosts": ssh_hosts(),
        "known_hosts": known_count,
        "known_hosts_list": sorted(known_list),
        "git": {"helper": helper, "credentials": cred_hosts},
        "connections": active_ssh_conns(),
        "git_report": git_report(name),
    }



# ───────────────────────────── usage & insights analytics ─────────────────────────────
# Everything below reads a project's Hermes state DB READ-ONLY (sqlite uri mode=ro): analytics
# must never open a second writer next to a live gateway/session, and must never mint a WAL.

USAGE_DAYS = 30


def _sqlite_ro(path: Path):
    """Read-only connection to a Hermes state DB, or None when it is missing/unusable."""
    try:
        if not path.exists():
            return None
        con = sqlite3.connect(f"file:{path}?mode=ro", uri=True, timeout=2.0)
        con.row_factory = sqlite3.Row
        return con
    except sqlite3.Error:
        return None


def _usage_rows(home: Path) -> list[dict]:
    con = _sqlite_ro(home / "state.db")
    if con is None:
        return []
    try:
        cur = con.execute(
            "select session_id, model, billing_provider, billing_base_url, billing_mode, task,"
            " api_call_count, input_tokens, output_tokens, cache_read_tokens, cache_write_tokens,"
            " reasoning_tokens, estimated_cost_usd, first_seen, last_seen from session_model_usage")
        rows = [dict(r) for r in cur.fetchall()]
        return rows
    except sqlite3.Error:
        return []
    finally:
        con.close()


def _price_catalog() -> dict:
    """model id (lowercase) -> USD per 1M tokens, best effort from the models.dev cache."""
    out: dict[str, dict] = {}
    try:
        data = json.loads((Path.home() / ".hermes" / "models_dev_cache.json").read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return out
    if not isinstance(data, dict):
        return out
    for prov in data.values():
        models = prov.get("models") if isinstance(prov, dict) else None
        if not isinstance(models, dict):
            continue
        for mid, meta in models.items():
            cost = (meta or {}).get("cost") if isinstance(meta, dict) else None
            if not isinstance(cost, dict):
                continue
            try:
                row = {
                    "input": float(cost.get("input") or 0),
                    "output": float(cost.get("output") or 0),
                    "cache_read": float(cost.get("cache_read") or 0),
                    "context": int(((meta.get("limit") or {}).get("context")) or 0),
                }
                # cache_write is a real price key for some providers (vertex/gemini and friends) and
                # absent for others: keep it out instead of pretending it costs 0.
                if cost.get("cache_write") is not None:
                    row["cache_write"] = float(cost["cache_write"])
                out[str(mid).lower()] = row
            except (TypeError, ValueError):
                continue
    return out


def _model_price(model: str, catalog: dict) -> dict | None:
    """Exact id first, then suffix match: providers usually prefix the model id."""
    m = (model or "").strip().lower()
    if not m:
        return None
    if m in catalog:
        return catalog[m]
    for key, val in catalog.items():
        if key.endswith("/" + m) or key.split("/")[-1] == m:
            return val
    return None


def _bucket() -> dict:
    return {"calls": 0, "input": 0, "output": 0, "cache_read": 0, "cache_write": 0,
            "reasoning": 0, "total": 0}


def _add(b: dict, r: dict) -> None:
    b["calls"] += int(r.get("api_call_count") or 0)
    b["input"] += int(r.get("input_tokens") or 0)
    b["output"] += int(r.get("output_tokens") or 0)
    b["cache_read"] += int(r.get("cache_read_tokens") or 0)
    b["cache_write"] += int(r.get("cache_write_tokens") or 0)
    b["reasoning"] += int(r.get("reasoning_tokens") or 0)
    b["total"] = b["input"] + b["output"]


def _day(ts) -> str:
    try:
        return time.strftime("%Y-%m-%d", time.localtime(float(ts)))
    except (TypeError, ValueError, OSError):
        return ""


def _summarize(rows: list[dict], catalog: dict, days: int = USAGE_DAYS) -> dict:
    """Totals + per-model + per-day, with a best-effort USD estimate from models.dev prices."""
    models: dict[str, dict] = {}
    per_day: dict[str, dict] = {}
    sessions: set[str] = set()
    for r in rows:
        name = str(r.get("model") or "unknown")
        mb = models.get(name)
        if mb is None:
            mb = models[name] = dict(_bucket(), model=name, sessions=set(), first=None, last=None)
        _add(mb, r)
        mb["sessions"].add(str(r.get("session_id") or ""))
        sessions.add(str(r.get("session_id") or ""))
        for field, better in (("first_seen", min), ("last_seen", max)):
            v = r.get(field)
            if v:
                mb["first" if field == "first_seen" else "last"] = (
                    float(v) if mb["first" if field == "first_seen" else "last"] is None
                    else better(mb["first" if field == "first_seen" else "last"], float(v)))
        d = _day(r.get("last_seen") or r.get("first_seen"))
        if d:
            db = per_day.get(d)
            if db is None:
                db = per_day[d] = dict(_bucket(), day=d)
            _add(db, r)
    total = _bucket()
    for r in rows:
        _add(total, r)
    model_list = []
    for mb in models.values():
        price = _model_price(mb["model"], catalog)
        if price:
            est = ((mb["input"] / 1e6) * price["input"] + (mb["output"] / 1e6) * price["output"]
                   + (mb["cache_read"] / 1e6) * price.get("cache_read", 0))
            mb["est_usd"] = round(est, 4)
        else:
            mb["est_usd"] = None
        mb["sessions"] = len(mb["sessions"])
        mb["share"] = round(100.0 * mb["total"] / total["total"], 2) if total["total"] else 0.0
        mb["last_text"] = time.strftime("%Y-%m-%d %H:%M", time.localtime(mb["last"])) if mb["last"] else "-"
        mb["first_text"] = time.strftime("%Y-%m-%d %H:%M", time.localtime(mb["first"])) if mb["first"] else "-"
        model_list.append(mb)
    model_list.sort(key=lambda m: m["total"], reverse=True)
    # continuous day series so the chart has no invisible holes
    series = []
    now = time.time()
    for i in range(days - 1, -1, -1):
        d = time.strftime("%Y-%m-%d", time.localtime(now - i * 86400))
        series.append(per_day.get(d) or dict(_bucket(), day=d))
    total["sessions"] = len(sessions)
    total["models"] = len(model_list)
    est = [m["est_usd"] for m in model_list if m["est_usd"] is not None]
    total["est_usd"] = round(sum(est), 4) if est else None
    return {"totals": total, "models": model_list, "days": series}


def cache_analytics(name: str) -> dict:
    """Prompt-cache analytics of one project: hit rate, fresh input and what the cache saved.

    Read-only sqlite over ``session_model_usage``. The token counts are what the provider
    reported; the hit rate is ``cache_read / (cache_read + fresh input)`` (a cache read is a
    prompt token the provider served from its own cache, so it is NOT part of the fresh input
    count), and the money is priced with the same third-party table the usage view uses, so it
    is an estimate, never an invoice. A model the table does not know is listed as unpriced
    instead of being counted as free.
    """
    catalog = _price_catalog()
    rows = _usage_rows(profile_home(name))

    def blank() -> dict:
        return {"fresh": 0, "cache_read": 0, "cache_write": 0, "output": 0, "reasoning": 0,
                "calls": 0}

    def add(b: dict, r: dict) -> None:
        b["fresh"] += int(r.get("input_tokens") or 0)
        b["cache_read"] += int(r.get("cache_read_tokens") or 0)
        b["cache_write"] += int(r.get("cache_write_tokens") or 0)
        b["output"] += int(r.get("output_tokens") or 0)
        b["reasoning"] += int(r.get("reasoning_tokens") or 0)
        b["calls"] += int(r.get("api_call_count") or 0)

    def rates(b: dict) -> None:
        prompt = b["fresh"] + b["cache_read"]
        b["prompt"] = prompt
        b["hit_pct"] = round(100.0 * b["cache_read"] / prompt, 1) if prompt else 0.0

    totals = blank()
    models: dict[str, dict] = {}
    days: dict[str, dict] = {}
    sessions: set[str] = set()
    for r in rows:
        add(totals, r)
        sid = str(r.get("session_id") or "")
        if sid:
            sessions.add(sid)
        mid = str(r.get("model") or "unknown")
        mb = models.get(mid)
        if mb is None:
            mb = models[mid] = dict(blank(), model=mid, sessions=set())
        add(mb, r)
        if sid:
            mb["sessions"].add(sid)
        d = _day(r.get("last_seen") or r.get("first_seen"))
        if d:
            db = days.get(d)
            if db is None:
                db = days[d] = dict(blank(), day=d)
            add(db, r)

    money = {"saved": 0.0, "fresh": 0.0, "paid": 0.0, "write": 0.0, "write_priced": False,
             "priced": 0}
    unpriced: list[str] = []
    model_list = []
    for mb in models.values():
        rates(mb)
        mb["sessions"] = len(mb["sessions"])
        price = _model_price(mb["model"], catalog)
        mb["priced"] = bool(price)
        if price:
            read = mb["cache_read"] / 1e6
            money["priced"] += 1
            money["fresh"] += read * price["input"]
            money["paid"] += read * price["cache_read"]
            money["saved"] += read * (price["input"] - price["cache_read"])
            mb["fresh_usd"] = round(read * price["input"], 4)
            mb["paid_usd"] = round(read * price["cache_read"], 4)
            mb["saved_usd"] = round(read * (price["input"] - price["cache_read"]), 4)
            if "cache_write" in price:
                money["write_priced"] = True
                money["write"] += mb["cache_write"] / 1e6 * price["cache_write"]
                mb["write_usd"] = round(mb["cache_write"] / 1e6 * price["cache_write"], 4)
        else:
            unpriced.append(mb["model"])
        model_list.append(mb)
    model_list.sort(key=lambda m: m["cache_read"], reverse=True)
    day_list = sorted(days.values(), key=lambda d: d["day"])
    for db in day_list:
        rates(db)
    rates(totals)
    totals["sessions"] = len(sessions)
    return {"project": name, "totals": totals, "models": model_list, "days": day_list,
            "saved_usd": round(money["saved"], 4), "fresh_usd": round(money["fresh"], 4),
            "paid_usd": round(money["paid"], 4),
            "write_usd": round(money["write"], 4) if money["write_priced"] else None,
            "priced_models": money["priced"], "unpriced_models": unpriced,
            "window_days": USAGE_DAYS}


def usage_report(name: str) -> dict:
    """Token usage of one project: per model, per day, and the models it used before."""
    home = profile_home(name)
    catalog = _price_catalog()
    summary = _summarize(_usage_rows(home), catalog)
    active = (_yaml_scalar(home / "config.yaml", "model", "default")
              or _yaml_scalar(Path.home() / ".hermes" / "config.yaml", "model", "default") or "-")
    for m in summary["models"]:
        m["active"] = (m["model"] == active)
        price = _model_price(m["model"], catalog)
        m["context_limit"] = (price or {}).get("context") or 0
        m["price"] = price
    previous = [m for m in summary["models"] if not m["active"]]
    return {"project": name, "active_model": active, **summary,
            "previous_models": previous,
            "cache_ratio": round(100.0 * summary["totals"]["cache_read"] /
                                 max(1, summary["totals"]["cache_read"] + summary["totals"]["input"]), 1)}


def _all_projects() -> list[str]:
    names = [DEFAULT_HERMES]
    for p in list_profiles():
        if p not in names:
            names.append(p)
    return names


def usage_overview() -> dict:
    """Usage across every project, de-duplicated per (session, model, billing, task) row.

    Restoring a DB from another profile leaves two databases holding the same history; summing
    them blindly would double every number, so identical usage rows are merged (max of each
    counter) and projects that share session ids are reported as such.
    """
    catalog = _price_catalog()
    merged: dict[tuple, dict] = {}
    per_project: dict[str, dict] = {}
    session_sets: dict[str, set] = {}
    for name in _all_projects():
        rows = _usage_rows(profile_home(name))
        if not rows:
            continue
        pb = _bucket()
        pses: set[str] = set()
        for r in rows:
            key = (str(r.get("session_id") or ""), str(r.get("model") or ""),
                   str(r.get("billing_provider") or ""), str(r.get("billing_base_url") or ""),
                   str(r.get("billing_mode") or ""), str(r.get("task") or ""))
            cur = merged.get(key)
            if cur is None:
                merged[key] = dict(r)
            else:
                for f in ("api_call_count", "input_tokens", "output_tokens", "cache_read_tokens",
                          "cache_write_tokens", "reasoning_tokens"):
                    cur[f] = max(int(cur.get(f) or 0), int(r.get(f) or 0))
                cur["estimated_cost_usd"] = max(float(cur.get("estimated_cost_usd") or 0),
                                                float(r.get("estimated_cost_usd") or 0))
                if float(r.get("last_seen") or 0) > float(cur.get("last_seen") or 0):
                    cur["last_seen"] = r["last_seen"]
                if cur.get("first_seen") is None or float(r.get("first_seen") or 0) < float(cur["first_seen"] or 0):
                    cur["first_seen"] = r["first_seen"]
            _add(pb, r)
            sid = str(r.get("session_id") or "")
            pses.add(sid)
            session_sets.setdefault(name, set()).add(sid)
        pb["sessions"] = len(pses)
        per_project[name] = pb
    summary = _summarize(list(merged.values()), catalog)
    dupes = []
    names = sorted(session_sets)
    for i, a in enumerate(names):
        for b in names[i + 1:]:
            share = session_sets[a] & session_sets[b]
            if share:
                dupes.append({"a": a, "b": b, "shared_sessions": len(share)})
    raw = sum(v["total"] for v in per_project.values())
    return {"project": "all", **summary,
            "projects": [{"project": k, **v} for k, v in per_project.items()],
            "duplicate_total": raw - summary["totals"]["total"],
            "shared_history": dupes}


# ------------------------------------------------------- usage analysis text ---
# The panel's three analysis buttons (dashboard usage, Insights usage, Insights cache) print a plain
# English reading of the table above them into the output dock: nothing is rendered until the
# operator asks for it, and the text gets the full width of the dock. Every sentence is derived from
# the same dict the table renders, so the prose cannot drift from the numbers, and every figure that
# is an estimate says so.

def _tok_text(n) -> str:
    """Token counts in the compact form the panel tiles use (12.3k, 1.24M)."""
    try:
        v = float(n or 0)
    except (TypeError, ValueError):
        return "0"
    if v >= 1e9:
        return f"{v / 1e9:.2f}B"
    if v >= 1e6:
        return f"{v / 1e6:.2f}M"
    if v >= 1e3:
        return f"{v / 1e3:.1f}k"
    return str(int(v))


def _usd_text(value) -> str:
    """A USD amount, or the words the analysis uses when the price table has no row."""
    try:
        return f"${float(value):,.2f}"
    except (TypeError, ValueError):
        return "n/a"


def _pct(part, whole) -> str:
    try:
        return f"{100.0 * float(part) / float(whole):.1f}%"
    except (TypeError, ValueError, ZeroDivisionError):
        return "0.0%"


def _active_days(days: list[dict]) -> list[dict]:
    return [d for d in (days or []) if int(d.get("calls") or 0) or int(d.get("total") or 0)]


def _summary_width() -> int:
    """Wrap width for the analysis text.

    A pipe (the panel's output dock, a cron job, `> file`) always gets a fixed 96 columns, because
    COLUMNS from the parent shell would otherwise hand the dock lines wider than the dock itself.
    """
    if not sys.stdout.isatty():
        return 96
    return max(40, term_width() - 4)


def _para_lines(paras: list[str], width: int | None = None) -> list[str]:
    """Wrap paragraphs to the frame's inner width, one empty line between them."""
    inner = width or _summary_width()
    out: list[str] = []
    for i, p in enumerate(paras):
        if i:
            out.append("")
        out.extend(textwrap.wrap(" ".join(str(p).split()), inner) or [""])
    return out


def work_patterns(name: str) -> dict:
    """How the work was actually done: what the operator typed and what the agent ran.

    Read-only over ``messages``/``sessions``, and defensive about columns an older engine may not
    have. This is what lets the analysis read behaviour (how the operator prompts, how the agent
    answers, how long the threads get) instead of restating the totals of the table.
    """
    out: dict = {"user_msgs": 0, "user_chars": 0, "short_user_msgs": 0, "assistant_msgs": 0,
                 "tool_msgs": 0, "repeat_msgs": 0, "repeat_samples": [], "tools": [],
                 "sessions": 0, "calls": 0, "longest_session": 0, "big_sessions": 0,
                 "compression_events": 0, "compression_sessions": 0,
                 "tiny": 0, "brief": 0, "long_brief": 0, "sessions_one": 0, "sessions_deep": 0,
                 "per_session_max": 0, "work_days": 0, "hours": [], "hour_share": 0.0}
    con = _sqlite_ro(profile_home(name) / "state.db")
    if con is None:
        return out
    try:
        r = con.execute(
            "select count(*) n, coalesce(sum(length(trim(coalesce(content, '')))), 0) chars,"
            " coalesce(sum(case when length(trim(coalesce(content, ''))) <= 12 then 1 else 0 end), 0) tiny,"
            " coalesce(sum(case when length(trim(coalesce(content, ''))) between 13 and 120 then 1 else 0 end), 0) shrt,"
            " coalesce(sum(case when length(trim(coalesce(content, ''))) between 121 and 400 then 1 else 0 end), 0) mid,"
            " coalesce(sum(case when length(trim(coalesce(content, ''))) > 400 then 1 else 0 end), 0) lng"
            " from messages where role = 'user'").fetchone()
        out["user_msgs"] = int(r["n"] or 0)
        out["user_chars"] = int(r["chars"] or 0)
        out["tiny"] = int(r["tiny"] or 0)
        out["short_user_msgs"] = int(r["shrt"] or 0)
        out["brief"] = int(r["mid"] or 0)
        out["long_brief"] = int(r["lng"] or 0)
        for role, key in (("assistant", "assistant_msgs"), ("tool", "tool_msgs")):
            out[key] = int(con.execute(
                "select count(*) from messages where role = ?", (role,)).fetchone()[0] or 0)
        out["repeat_msgs"] = int(con.execute(
            "select coalesce(sum(n - 1), 0) from (select count(*) n from messages"
            " where role = 'user' and content is not null and trim(content) <> ''"
            " group by content having n > 1)").fetchone()[0] or 0)
        for x in con.execute(
                "select trim(replace(content, char(10), ' ')) t, count(*) n from messages"
                " where role = 'user' and content is not null and trim(content) <> ''"
                " group by content having n > 1 order by n desc limit 3"):
            out["repeat_samples"].append([_sample_msg(x["t"]), int(x["n"])])
        # How the work is spread over threads: a few deep ones and many one-shot ones read very
        # differently in the bill, and they need opposite advice.
        counts = [int(x["n"]) for x in con.execute(
            "select count(*) n from messages where role = 'user' group by session_id")]
        out["sessions_one"] = sum(1 for n in counts if n == 1)
        out["sessions_deep"] = sum(1 for n in counts if n >= 15)
        out["per_session_max"] = max(counts) if counts else 0
        out["tools"] = [[str(x["tool_name"]), int(x["n"])] for x in con.execute(
            "select tool_name, count(*) n from messages where tool_name is not null and tool_name <> ''"
            " group by tool_name order by n desc limit 6")]
        s = con.execute(
            "select count(*) n, coalesce(max(message_count), 0) mx,"
            " coalesce(sum(api_call_count), 0) calls,"
            " coalesce(sum(case when message_count > 200 then 1 else 0 end), 0) big"
            " from sessions").fetchone()
        out["sessions"] = int(s["n"] or 0)
        out["longest_session"] = int(s["mx"] or 0)
        out["calls"] = int(s["calls"] or 0)
        out["big_sessions"] = int(s["big"] or 0)
        # When the operator works: the clock is part of the habit, and a late-night run usually
        # means a tired prompt and more retries.
        hours = [[int(x["h"]), int(x["n"])] for x in con.execute(
            "select cast(strftime('%H', timestamp, 'unixepoch', 'localtime') as integer) h, count(*) n"
            " from messages where role = 'user' and timestamp is not null group by h"
            " order by n desc limit 3")]
        out["hours"] = hours
        total_hours = int(con.execute(
            "select count(*) from messages where role = 'user' and timestamp is not null").fetchone()[0] or 0)
        if total_hours and hours:
            out["hour_share"] = 100.0 * sum(h[1] for h in hours) / total_hours
        out["work_days"] = int(con.execute(
            "select count(distinct date(timestamp, 'unixepoch', 'localtime')) from messages"
            " where role = 'user' and timestamp is not null").fetchone()[0] or 0)
        cols = {row[1] for row in con.execute("pragma table_info(sessions)")}
        if "compression_ineffective_count" in cols:
            c = con.execute(
                "select coalesce(sum(compression_ineffective_count), 0) n,"
                " coalesce(sum(case when compression_ineffective_count > 0 then 1 else 0 end), 0) s"
                " from sessions").fetchone()
            out["compression_events"] = int(c["n"] or 0)
            out["compression_sessions"] = int(c["s"] or 0)
    except sqlite3.Error:
        return out
    finally:
        con.close()
    return out


def work_patterns_all(names: list[str] | None = None) -> dict:
    """The same counters merged over every project, so the fleet reading matches the fleet totals."""
    merged: dict = {"user_msgs": 0, "user_chars": 0, "short_user_msgs": 0, "assistant_msgs": 0,
                    "tool_msgs": 0, "repeat_msgs": 0, "repeat_samples": [], "tools": [],
                    "sessions": 0, "calls": 0, "longest_session": 0, "big_sessions": 0,
                    "compression_events": 0, "compression_sessions": 0,
                    "tiny": 0, "brief": 0, "long_brief": 0, "sessions_one": 0, "sessions_deep": 0,
                    "per_session_max": 0, "work_days": 0, "hours": [], "hour_share": 0.0}
    tools: dict[str, int] = {}
    labelled: list[tuple[str, int]] = []
    for name in (names if names is not None else _all_projects()):
        p = work_patterns(name)
        for key in ("user_msgs", "user_chars", "short_user_msgs", "assistant_msgs", "tool_msgs",
                    "repeat_msgs", "sessions", "calls", "big_sessions", "compression_events",
                    "compression_sessions", "tiny", "brief", "long_brief", "sessions_one",
                    "sessions_deep", "work_days"):
            merged[key] += int(p.get(key) or 0)
        for key in ("longest_session", "per_session_max"):
            merged[key] = max(merged[key], int(p.get(key) or 0))
        for tname, count in p.get("tools") or []:
            tools[tname] = tools.get(tname, 0) + int(count)
        for h, n in p.get("hours") or []:
            labelled.append((h, n))
        merged["repeat_samples"].extend(p.get("repeat_samples") or [])
    merged["tools"] = sorted(tools.items(), key=lambda kv: -kv[1])[:6]
    merged["repeat_samples"] = sorted(merged["repeat_samples"], key=lambda s: -s[1])[:3]
    seen: dict[int, int] = {}
    for h, n in labelled:
        seen[h] = seen.get(h, 0) + n
    merged["hours"] = sorted(seen.items(), key=lambda kv: -kv[1])[:3]
    merged["hour_share"] = 0.0
    return merged


def _n(count, singular: str, plural: str = "") -> str:
    """A count that reads like a person wrote it: 1 message, 6 messages."""
    try:
        n = int(count or 0)
    except (TypeError, ValueError):
        n = 0
    word = singular if n == 1 else (plural or singular + "s")
    return f"{n:,} {word}"


def _sample_msg(text, limit: int = 52) -> str:
    """One operator message, flattened and shortened for the quoted sample in the analysis."""
    t = " ".join(str(text or "").split())
    if t.lower().startswith("msg="):
        t = t[4:].strip()
    return t[:limit] + ("…" if len(t) > limit else "")


def _hit_rate_from_days(days: list[dict]) -> tuple[float, float, float]:
    """(early, late, overall) cache hit rate over the day rows, weighted by prompt tokens."""
    rows = [d for d in (days or []) if int(d.get("prompt") or 0) > 0]
    if not rows:
        return (0.0, 0.0, 0.0)

    def rate(chunk: list[dict]) -> float:
        prompt = sum(int(d.get("prompt") or 0) for d in chunk)
        read = sum(int(d.get("cache_read") or 0) for d in chunk)
        return 100.0 * read / prompt if prompt else 0.0

    half = max(1, len(rows) // 2)
    return (rate(rows[:half]), rate(rows[-half:]), rate(rows))


def _operator_paragraph(pat: dict | None, tokens: int, who: str, calls: int = 0) -> str:
    """Your side of the story, read off the messages: length, repeats, spread, clock."""
    pat = pat or {}
    user = int(pat.get("user_msgs") or 0)
    if not user:
        return ""
    avg_chars = int(pat.get("user_chars") or 0) / user
    calls_each = calls / user if user else 0
    parts = [f"Your side of it first: {who} sent {user:,} instructions over "
             f"{_n(int(pat.get('work_days') or 0), 'working day')} and "
             f"{_n(int(pat.get('sessions') or 0), 'session')}, averaging {avg_chars:.0f} "
             f"characters each. Each one set off about "
             f"{_tok_text(tokens / user if user else 0)} tokens of the model reading and writing, and "
             f"{calls_each:.1f} round trips to the model (one round trip is one question the agent "
             f"asks it, tool calls included)."]
    tiny = int(pat.get("tiny") or 0)
    longd = int(pat.get("long_brief") or 0)
    if longd and longd / user >= 0.25:
        parts.append(f"{_n(longd, 'instruction')} were proper briefs over 400 characters. That is the good habit: "
                     f"a long brief costs reading but usually saves rounds, and "
                     f"{calls_each:.1f} round trips per instruction is what that trade produced here.")
    elif tiny >= 3 and tiny / user >= 0.15:
        parts.append(f"{_n(tiny, 'instruction')} were one-liners under 13 characters, the keep-going nudge you "
                     f"send when the agent stops early. Friendly reminder: every nudge is still a "
                     f"whole round trip with the full chat attached, so saying up front what done "
                     f"looks like is usually cheaper.")
    ones = int(pat.get("sessions_one") or 0)
    deeps = int(pat.get("sessions_deep") or 0)
    if deeps or ones:
        bits = []
        if deeps:
            bits.append(f"{_n(deeps, 'session')} carried 15 or more instructions, the deepest taking "
                        f"{int(pat.get('per_session_max') or 0)}")
        if ones:
            bits.append(f"{_n(ones, 'session')} held a single instruction" + ("" if ones == 1 else " each"))
        parts.append("Shape of the work: " + "; ".join(bits) + ". Both shapes are fine, they just "
                     "bill differently: a long thread keeps re-reading its own history, while a "
                     "one-shot session pays full price for its first prompt and never gets to reuse "
                     "anything.")
    if pat.get("repeat_msgs"):
        samples = pat.get("repeat_samples") or []
        quoted = f", for example \"{samples[0][0]}\" twice" if samples else ""
        parts.append(f"And {_n(int(pat['repeat_msgs']), 'message')} went out again word for word{quoted}. "
                     f"That is the fingerprint of a chat that lost the thread before it finished the "
                     f"job: the repeat costs the whole context a second time, which is the expensive "
                     f"way to say \"we were here already\".")
    hours = pat.get("hours") or []
    if hours and int(pat.get("hour_share") or 0) >= 30:
        stamps = [int(x[0]) for x in hours]
        when = ", ".join(f"{z:02d}:00" for z in stamps)
        if any(z >= 21 or z <= 5 for z in stamps):
            tail = ("late nights are the classic pattern: tired prompt, faster firing, more retries, "
                    "and the retries are what shows up in this bill")
        else:
            tail = ("good news, by the way: one sitting keeps the cache warm and avoids restarting "
                    "the thread from scratch")
        parts.append(f"Most of it happens around {when} ({int(pat.get('hour_share') or 0)}% of the "
                     f"instructions), and {tail}.")
    return " ".join(parts)


def _agent_paragraph(pat: dict | None, reason_share: float, out_share: float) -> str:
    """The agent's side, still only from measured counters, explained in plain words."""
    pat = pat or {}
    user = max(1, int(pat.get("user_msgs") or 0))
    tools = int(pat.get("tool_msgs") or 0)
    assistants = int(pat.get("assistant_msgs") or 0)
    parts = []
    names = ", ".join(f"{n} ({c:,})" for n, c in (pat.get("tools") or [])[:3])
    if assistants or tools:
        total_msgs = max(1, user + assistants + tools)
        parts.append(f"Now the agent's side: it replied with {assistants:,} messages and ran {tools:,} "
                     f"tool calls (commands, file edits, searches, browsing), which is about "
                     f"{(tools / user):.1f} tool results per instruction of yours"
                     + (f", led by {names}" if names else "")
                     + f". Tool output is {_pct(tools, total_msgs)} of everything that exists in the "
                       f"chat, and every turn has to read that again: most of the traffic here is the "
                       f"agent's own work coming back, not your typing.")
    if int(pat.get("longest_session") or 0) >= 150:
        extra = (f", and {_n(int(pat['big_sessions']), 'session')} went past 200 messages"
                 if pat.get("big_sessions") else "")
        parts.append(f"The longest single chat reached {int(pat['longest_session']):,} messages"
                     f"{extra}. Picture a conversation that long: each new turn has to read the whole "
                     f"thing, and when it stops fitting in the model's short-term memory (its context "
                     f"window) the engine squeezes the old part into a summary, which is exactly how "
                     f"\"the agent forgot what we agreed\" happens.")
    if pat.get("compression_events"):
        parts.append(f"That squeezing actually happened "
                     f"{_n(int(pat['compression_events']), 'time')} across "
                     f"{_n(int(pat['compression_sessions']), 'session')}.")
    if reason_share:
        parts.append(f"{reason_share:.0f}% of everything written was reasoning, the model thinking to "
                     f"itself: you pay for those words, you never get to read them.")
    if out_share >= 40:
        parts.append(f"Output is {out_share:.0f}% of the tokens, so the model spends more time writing "
                     f"than reading here.")
    else:
        parts.append(f"Output is {out_share:.0f}% of the tokens, the usual shape for agent work: lots "
                     f"of context read, a short answer written, so the reading side carries the cost.")
    return " ".join(parts)


def _playbook(pat: dict | None, *, hit: float, out_share: float, reason_share: float,
              total: int, per_call_prompt: float = 0, limit: int = 0,
              models_used: int = 0) -> str:
    """What to actually do next, ranked by what this project's own numbers show.

    Two independent dials are named as such: the cache decides what a word of context costs, and how
    much context you carry decides how many words there are. A tip only appears when its trigger is
    measured, so nothing here is generic advice.
    """
    pat = pat or {}
    user = max(1, int(pat.get("user_msgs") or 0))
    tools = int(pat.get("tool_msgs") or 0)
    repeats = int(pat.get("repeat_msgs") or 0)
    tips: list[tuple[int, str]] = []
    if repeats >= 3:
        tips.append((95, f"stop re-sending, start restating ({_n(repeats, 'message')} went out twice, "
                         f"word for word): when a chat has lost the thread, a fresh session that opens "
                         f"with the decision written down beats dragging the old history along"))
    if tools and tools / user >= 2:
        tips.append((90, f"ask for smaller helpings ({tools:,} tool results for {user:,} "
                         f"instructions): \"only the matching lines\" or \"only that one file\" "
                         f"instead of a full dump, because every later turn re-reads whatever came "
                         f"back"))
    if reason_share >= 25:
        tips.append((85, f"put the right model on the job: {reason_share:.0f}% of what you pay for is "
                         f"the model thinking to itself, so keep the thinking model for the hard "
                         f"turns and move routine edits to a cheaper one (Model board)"))
    if hit and hit < 60:
        tips.append((80, f"make the reusable part really reusable (cache hit rate {hit:.0f}%): the "
                         f"cache is the provider keeping text it already read so you pay a fraction "
                         f"for it next time, and it only works when the beginning of the request "
                         f"stays identical, so keep SOUL.md and the skills untouched mid-session and "
                         f"put the changing request at the end"))
    elif hit >= 75:
        tips.append((75, f"keep doing what you are doing on caching (hit rate {hit:.0f}%, meaning the "
                         f"provider is reusing your prompt instead of charging full price for it): "
                         f"the lever left is how much context you carry, not what it costs per word"))
    if int(pat.get("sessions_deep") or 0) >= 2 and int(pat.get("longest_session") or 0) >= 300:
        tips.append((70, f"close long chats at milestones ({int(pat.get('longest_session') or 0):,} "
                         f"messages in the deepest one): a new session costs one cache write and then "
                         f"rides that cache, while an endless thread keeps paying to re-read itself"))
    if int(pat.get("sessions_one") or 0) >= 2:
        tips.append((65, f"bundle related questions ({_n(int(pat['sessions_one']), 'session')} had a "
                         f"single instruction): a cold start pays full price for its first prompt, so five "
                         f"related asks in one thread cost less than five fresh starts"))
    if models_used >= 3:
        tips.append((60, f"one model per thread ({_n(models_used, 'model')} appear in this history): "
                         f"switching mid-session throws away the text the provider had cached"))
    if int(pat.get("tiny") or 0) >= 3:
        tips.append((55, "write the finish line into the first message (\"done when X passes\"): "
                         "that is what removes the short keep-going nudges and the extra rounds they "
                         "cost"))
    if limit and per_call_prompt and 100.0 * per_call_prompt / limit >= 60:
        tips.append((50, f"keep a normal turn well under the model's memory (this one already fills "
                         f"{100.0 * per_call_prompt / limit:.0f}% of it): that is where summarising and "
                         f"slow answers start"))
    if not tips:
        tips.append((40, "honestly, nothing here looks wasteful: the mix of instructions, tool calls "
                         "and cache reuse is what cheap agent work looks like, so keep the shape and "
                         "just watch the trend"))
    tips.sort(key=lambda t: -t[0])
    balance = ("Two dials here, and they do different jobs: the cache decides what a word of context "
               "costs you (it reuses text the provider already read, at a fraction of the price), and "
               "the size of your context decides how many words you are paying for. ")
    if hit >= 75:
        balance += (f"With a {hit:.0f}% hit rate the price dial is already turned the right way, so "
                    f"the next win is volume.")
    elif hit and hit < 60:
        balance += (f"With a {hit:.0f}% hit rate the price dial is still costing you money, and that "
                    f"is usually the cheaper half to fix first.")
    else:
        balance += "Both dials are worth a look, and the numbers above say which one is louder."
    return "What actually to do: " + "; ".join(t[1] for t in tips[:4]) + ". " + balance


def usage_summary(report: dict, patterns: dict | None = None, cache: dict | None = None) -> list[str]:
    """Four paragraphs: the numbers in plain words, your habit, the agent's habit, the playbook."""
    t = report.get("totals") or {}
    project = report.get("project") or "this project"
    total = int(t.get("total") or 0)
    calls = int(t.get("calls") or 0)
    sessions = int(t.get("sessions") or 0)
    fresh = int(t.get("input") or 0)
    output = int(t.get("output") or 0)
    cached = int(t.get("cache_read") or 0)
    reason = int(t.get("reasoning") or 0)
    days = report.get("days") or []
    busy = _active_days(days)
    window = len(days) or USAGE_DAYS
    models = report.get("models") or []
    active = report.get("active_model") or "-"
    if not total and not calls:
        return [f"{project} has no model usage recorded yet, so there is nothing to analyse. The "
                f"tables stay empty until a session reports its first tokens."]
    prompt = fresh + cached
    hit = 100.0 * cached / prompt if prompt else 0.0
    per_call_prompt = prompt / calls if calls else 0
    per_call_out = output / calls if calls else 0
    per_session = total / sessions if sessions else 0
    per_day = total / len(busy) if busy else 0
    out_share = 100.0 * output / total if total else 0.0
    reason_share = 100.0 * reason / output if output else 0.0
    top = models[0] if models else {}
    limit = int(top.get("context_limit") or 0)
    est = t.get("est_usd")
    # A rough yardstick anyone can picture: about 750,000 words (call it seven novels) per million
    # tokens, which is the usual rule of thumb for English text.
    novels = total / 1e6 * 7

    p1 = (f"Let us start with the size of it: {project} was billed for {_tok_text(total)} tokens in the "
          f"last {window} days, where a token is a few characters of text (a rough rule of thumb: "
          f"about 750,000 words per million tokens). Rounded off, that is around {novels:.0f} "
          f"novels' worth: {_tok_text(fresh)} of text the model had to read fresh, plus "
          f"{_tok_text(output)} that it wrote back.")
    p1 += (f" That is only half the story, because a chat re-reads the same text on every turn: on top "
           f"of the billed tokens it read {_tok_text(cached)} more straight from the provider's "
           f"cache, which is the copy the provider keeps of text it has already seen. That is the "
           f"{hit:.0f}% hit rate the Cache tab reports, and the reason this bill is not several "
           f"times bigger. All of it took {calls:,} round trips to the model in "
           f"{_n(sessions, 'session')}, about {_tok_text(per_session)} tokens per session over "
           f"{_n(len(busy), 'active day')}, roughly {_tok_text(per_day)} tokens on a busy day.")
    if top.get("model") and top["model"] != active:
        p1 += (f" The model doing the heavy lifting is {top['model']} ({_pct(top.get('total'), total)} "
               f"of the tokens), while the project is set to {active} today.")
    elif top.get("model"):
        p1 += (f" That model, {top['model']}, is also the one the project is set to, so this is your "
               f"current baseline.")
    if report.get("previous_models"):
        p1 += (f" {_n(len(report['previous_models']), 'other model')} show up in older sessions, so part "
               f"of this history was made at different prices.")
    if est is None:
        p1 += (" There is no cost estimate here: the price table has no row for at least one model "
               "used, so only the token counts are comparable.")
    else:
        p1 += (f" At list prices that is about {_usd_text(est)}"
               + (f", or roughly ${est / calls:.4f} per round trip" if calls else "")
               + ", an estimate built from third-party price tables rather than an invoice.")
    p1 += (f" An average round trip reads {_tok_text(per_call_prompt)} tokens of context and writes "
           f"{_tok_text(per_call_out)}.")
    if limit and per_call_prompt:
        p1 += (f" For scale: the model holds about {_tok_text(limit)} tokens in one go (its context "
               f"window), so a normal turn fills {100.0 * per_call_prompt / limit:.0f}% of that "
               f"memory before it starts summarising the old part of the chat.")

    p2 = _operator_paragraph(patterns, total, project, calls)
    p3 = _agent_paragraph(patterns, reason_share, out_share)
    rows = []
    cache_row = cache or {}
    if cache_row:
        early, late, overall = _hit_rate_from_days(cache_row.get("days") or [])
        write = int((cache_row.get("totals") or {}).get("cache_write") or 0)
        if overall:
            trend = ""
            if early and late and abs(late - early) >= 8:
                trend = (f", moving from {early:.0f}% early on to {late:.0f}% later, so the reusable "
                         f"part got " + ("steadier" if late > early else "less stable")
                         + " as the work went on")
            rows.append(f"{overall:.0f}% of the context the model read was served from the cache "
                        f"instead of being charged as new text{trend}")
        if write and cached and write / max(1, cached) >= 0.2:
            rows.append(f"the cache was rebuilt often ({_tok_text(write)} tokens stored against "
                        f"{_tok_text(cached)} reused), so the reusable opening of the request keeps "
                        f"changing")
    if rows:
        p3 += " On caching, in plain terms: " + "; ".join(rows) + "."
    p4 = _playbook(patterns, hit=hit, out_share=out_share, reason_share=reason_share, total=total,
                   per_call_prompt=per_call_prompt, limit=limit, models_used=len(models))
    return [p1, p2 or p1, p3, p4]


def cache_summary(cache: dict, patterns: dict | None = None) -> list[str]:
    """Three paragraphs: what the cache did, what shapes it, and what to do with it."""
    t = cache.get("totals") or {}
    project = cache.get("project") or "this project"
    prompt = int(t.get("prompt") or 0)
    cached = int(t.get("cache_read") or 0)
    fresh = int(t.get("fresh") or 0)
    write = int(t.get("cache_write") or 0)
    calls = int(t.get("calls") or 0)
    sessions = int(t.get("sessions") or 0)
    output = int(t.get("output") or 0)
    reason = int(t.get("reasoning") or 0)
    hit = float(t.get("hit_pct") or 0.0)
    window = cache.get("window_days") or USAGE_DAYS
    models = cache.get("models") or []
    unpriced = cache.get("unpriced_models") or []
    priced = int(cache.get("priced_models") or 0)
    if not prompt and not write:
        return [f"{project} has no prompt-cache traffic recorded yet: every call so far was a single "
                f"prompt with no reusable opening, so there was nothing for the provider to keep."]
    p1 = (f"Short version: the provider's cache answered {hit}% of this project's reading in the last "
          f"{window} days. In numbers, {_tok_text(cached)} of {_tok_text(prompt)} context tokens were "
          f"text it had already read and could reuse cheaply, while {_tok_text(fresh)} had to be sent "
          f"as new text, across {calls:,} round trips in {_n(sessions, 'session')}.")
    if write:
        p1 += (f" It also stored {_tok_text(write)} tokens for later, "
               + ("which has no price row, so it is counted in tokens only."
                  if cache.get("write_usd") is None else
                  f"at a cost of about {_usd_text(cache.get('write_usd'))}."))
    if priced:
        p1 += (f" Those reused {_tok_text(cached)} tokens cost about {_usd_text(cache.get('paid_usd'))}, "
               f"where the same text as new input would have cost {_usd_text(cache.get('fresh_usd'))}: "
               f"the cache saved roughly {_usd_text(cache.get('saved_usd'))}, which is money the model "
               f"never had to read from scratch.")
    else:
        p1 += (" No model in this project has a price row, so the saving is shown in tokens rather "
               "than dollars.")

    early, late, overall = _hit_rate_from_days(cache.get("days") or [])
    p2 = []
    if models:
        top = models[0]
        p2.append(f"{_pct(top.get('cache_read'), cached)} of the reused text belongs to "
                  f"{top.get('model')} across {_n(top.get('sessions'), 'session')}")
    if early and late and abs(late - early) >= 8:
        p2.append(f"weighted by volume the hit rate went from {early:.0f}% in the first half of the "
                  f"window to {late:.0f}% in the second, "
                  + ("so whatever the later sessions did to keep their opening stable is worth "
                     "repeating" if late > early else
                     "which is what editing the instructions, SOUL.md or the skills mid-chat looks "
                     "like from the provider's side"))
    if hit >= 75.0:
        p2.append(f"a hit rate of {hit:.0f}% means your opening stays stable: the system prompt, the "
                  f"skills and the early turns of the chat are being reused instead of paid for again, "
                  f"which is the cheapest your context can be")
    elif hit >= 40.0:
        p2.append(f"a hit rate of {hit:.0f}% is middling: part of the opening gets reused and part "
                  f"keeps changing, which is what happens when a chat starts long and then gets "
                  f"edited along the way")
    else:
        p2.append(f"a hit rate of {hit:.0f}% is low: the provider can hardly reuse anything, so short "
                  f"sessions, a changed system prompt, or big tool results landing before the "
                  f"reusable part are the first suspects")
    pat = patterns or {}
    if pat.get("user_msgs"):
        p2.append(f"the habit behind it: {_n(int(pat['user_msgs']), 'instruction')} over "
                  f"{_n(int(pat.get('sessions') or 0), 'session')}"
                  + (", one of them a session with a single instruction"
                     if int(pat.get("sessions_one") or 0) == 1 else
                     f", {_n(int(pat['sessions_one']), 'session')} with a single instruction"
                     if int(pat.get("sessions_one") or 0) > 1 else "")
                  + (f", {_n(int(pat['repeat_msgs']), 'message')} re-sent word for word"
                     if pat.get("repeat_msgs") else "")
                  + (f", the deepest chat at {int(pat['longest_session']):,} messages"
                     if int(pat.get("longest_session") or 0) >= 150 else ""))
    if len(models) >= 2:
        p2.append(f"{_n(len(models), 'model')} appear in this history, and every switch starts the "
                  f"cache over")
    if unpriced:
        p2.append(f"the dollar columns cover the priced models only: no price row for "
                  f"{', '.join(unpriced)}")
    reason_share = 100.0 * reason / output if output else 0.0
    p3 = _playbook(pat, hit=hit, out_share=0.0, reason_share=reason_share,
                   total=cached + fresh, per_call_prompt=(cached + fresh) / calls if calls else 0,
                   models_used=len(models))
    return [p1, "What shapes it: " + "; ".join(p2) + ".", p3]


def overview_summary(over: dict, patterns: dict | None = None,
                     label: str | None = None) -> list[str]:
    """Four paragraphs: the fleet in plain words, your habit, the agent's side, the playbook."""
    t = over.get("totals") or {}
    projects = over.get("projects") or []
    models = over.get("models") or []
    days = over.get("days") or []
    busy = _active_days(days)
    window = len(days) or USAGE_DAYS
    total = int(t.get("total") or 0)
    calls = int(t.get("calls") or 0)
    sessions = int(t.get("sessions") or 0)
    fresh = int(t.get("input") or 0)
    cached = int(t.get("cache_read") or 0)
    output = int(t.get("output") or 0)
    reason = int(t.get("reasoning") or 0)
    if not total and not calls:
        return ["No project has recorded model usage yet, so there is nothing to analyse. The numbers "
                "appear as soon as a session reports its first tokens."]
    per_day = total / len(busy) if busy else 0
    top_p = max(projects, key=lambda p: int(p.get("total") or 0)) if projects else {}
    top_m = models[0] if models else {}
    top_day = max(days, key=lambda d: int(d.get("total") or 0), default={})
    out_share = 100.0 * output / total if total else 0.0
    reason_share = 100.0 * reason / output if output else 0.0
    hit = 100.0 * cached / (fresh + cached) if (fresh + cached) else 0.0
    novels = total / 1e6 * 7
    p1 = (f"All projects together: {_tok_text(total)} tokens in the last {window} days, or roughly "
          f"{novels:.0f} novels' worth of text read and written, and that is the part you get billed "
          f"for: {_tok_text(fresh)} of fresh reading plus {_tok_text(output)} of the model's own "
          f"writing. On top of the billed tokens, the models read another {_tok_text(cached)} straight "
          f"from the provider's cache (the copy kept of text they had already seen, which is why the "
          f"hit rate is {hit:.0f}%). That came from {calls:,} round trips over "
          f"{_n(sessions, 'session')}, on {_n(len(busy), 'active day')} at about {_tok_text(per_day)} "
          f"tokens a day.")
    if top_p.get("project"):
        p1 += (f" {top_p['project']} eats {_pct(top_p.get('total'), total)} of it, and "
               f"{top_m.get('model') or 'the top model'} handles {_pct(top_m.get('total'), total)} of "
               f"everything by itself.")
    if top_day.get("day"):
        p1 += f" The heaviest single day was {top_day['day']} at {_tok_text(top_day.get('total'))}."
    if t.get("est_usd") is not None:
        p1 += (f" Estimated at list prices: about {_usd_text(t.get('est_usd'))} for the window, built "
               f"from third-party price tables rather than an invoice.")
    else:
        p1 += (" There is no fleet-wide cost estimate: at least one model in use has no price row, so "
               "only the token counts are comparable.")
    if fresh + cached and hit < 75:
        p1 += (f" Caching only absorbed {_pct(cached, fresh + cached)} of the reading here, so there "
               f"is real money left on that table.")

    who = label or "these projects"
    p2 = _operator_paragraph(patterns, total, who, calls)
    p3 = _agent_paragraph(patterns, reason_share, out_share)
    if top_p.get("project") and p3:
        p3 += (f" Most of that sits in {top_p['project']} "
               f"({_pct(top_p.get('total'), total)} of the fleet).")
    p4 = _playbook(patterns, hit=hit, out_share=out_share, reason_share=reason_share, total=total,
                   models_used=len(models))
    return [p1, p2 or p1, p3, p4]


def do_summary(scope: str, name: str | None = None):
    """Print the analysis the panel's buttons show: one project's usage or cache, or the whole fleet."""
    scope = (scope or "").strip().lower()
    if scope in ("overview", "all", "fleet", "dashboard"):
        data = usage_overview()
        nproj = len(data.get("projects") or [])
        paras = overview_summary(data, work_patterns_all(),
                                 "the project with usage" if nproj == 1 else
                                 f"the {nproj} projects with usage")
        title = f"analysis · all projects · token usage (last {USAGE_DAYS} days)"
    elif scope in ("cache", "prompt-cache"):
        if not name:
            die("name a project: " + f"{PROG} --summary cache <name>")
        ensure_profile(name)
        data = cache_analytics(name)
        paras = cache_summary(data, work_patterns(name))
        title = f"analysis · {name} · prompt cache (last {USAGE_DAYS} days)"
    elif scope in ("usage", "tokens"):
        if not name:
            die("name a project: " + f"{PROG} --summary usage <name>")
        ensure_profile(name)
        data = usage_report(name)
        paras = usage_summary(data, work_patterns(name), cache_analytics(name))
        title = f"analysis · {name} · token usage (last {USAGE_DAYS} days)"
    else:
        die("usage: " + f"{PROG} --summary usage|cache <project>   or   {PROG} --summary overview")
        return
    print()
    print_frame(title, _para_lines(paras))


def search_history(name: str, query: str, limit: int = 40) -> dict:
    """Full-text search over a project's messages (FTS5 index, LIKE as the fallback)."""
    q = (query or "").strip()
    out = {"project": name, "query": q, "hits": [], "total": 0, "mode": ""}
    if not q:
        return out
    con = _sqlite_ro(profile_home(name) / "state.db")
    if con is None:
        out["error"] = "state.db not readable"
        return out
    try:
        try:
            cur = con.execute(
                "select m.id as msg_id, m.session_id, m.role, m.tool_name, m.timestamp,"
                " snippet(messages_fts, 0, '[', ']', ' … ', 14) as snippet,"
                " s.title, s.model from messages_fts"
                " join messages m on m.rowid = messages_fts.rowid"
                " join sessions s on s.id = m.session_id"
                " where messages_fts match ? order by m.timestamp desc limit ?", ('"' + q.replace('"', ' ') + '"', limit))
            hits = [dict(r) for r in cur.fetchall()]
            out["mode"] = "fts"
        except sqlite3.Error:
            cur = con.execute(
                "select m.id as msg_id, m.session_id, m.role, m.tool_name, m.timestamp, substr(m.content, 1, 200) as snippet,"
                " s.title, s.model from messages m join sessions s on s.id = m.session_id"
                " where m.content like ? order by m.timestamp desc limit ?", (f"%{q}%", limit))
            hits = [dict(r) for r in cur.fetchall()]
            out["mode"] = "like"
        # The counter must count the same way the hits were found, or "N matches" contradicts
        # the list (FTS indexes tool_name/tool_calls too, LIKE only looks at content).
        if out["mode"] == "fts":
            total = con.execute("select count(*) from messages_fts where messages_fts match ?",
                                ('"' + q.replace('"', ' ') + '"',)).fetchone()[0]
        else:
            total = con.execute("select count(*) from messages where content like ?", (f"%{q}%",)).fetchone()[0]
        out["total"] = int(total or 0)
    except sqlite3.Error as exc:
        out["error"] = str(exc)
        hits = []
    finally:
        con.close()
    for h in hits:
        h["when"] = time.strftime("%Y-%m-%d %H:%M", time.localtime(float(h["timestamp"]))) if h.get("timestamp") else "-"
    out["hits"] = hits
    return out


def message_detail(name: str, msg_id: int, around: int = 3, cap: int = 20000) -> dict:
    """One message in full, plus the messages around it, for the search detail view."""
    out: dict = {"project": name, "id": msg_id, "msg": None, "before": [], "after": [], "session": {}}
    con = _sqlite_ro(profile_home(name) / "state.db")
    if con is None:
        out["error"] = "state.db not readable"
        return out
    try:
        row = con.execute(
            "select id, session_id, role, tool_name, content, timestamp, token_count, finish_reason,"
            " reasoning_content from messages where id = ?", (msg_id,)).fetchone()
        if row is None:
            out["error"] = "message not found"
            return out
        body = row["content"] or ""
        out["msg"] = {
            "id": row["id"], "session_id": row["session_id"], "role": row["role"],
            "tool_name": row["tool_name"] or "", "tokens": row["token_count"],
            "finish_reason": row["finish_reason"] or "",
            "when": time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(float(row["timestamp"])))
            if row["timestamp"] else "-",
            "chars": len(body), "truncated": len(body) > cap, "content": body[:cap],
        }
        sid = row["session_id"]
        sess = con.execute("select title, model, message_count, api_call_count from sessions where id = ?",
                           (sid,)).fetchone()
        if sess is not None:
            out["session"] = {"id": sid, "title": sess["title"] or "", "model": sess["model"] or "",
                              "messages": sess["message_count"], "calls": sess["api_call_count"]}
        else:
            out["session"] = {"id": sid}
        for label, op, order in (("before", "<", "desc"), ("after", ">", "asc")):
            rows = con.execute(
                f"select id, role, tool_name, timestamp, substr(content, 1, 400) as preview"
                f" from messages where session_id = ? and id {op} ? order by id {order} limit ?",
                (sid, msg_id, around)).fetchall()
            if order == "desc":
                rows = list(reversed(rows))
            out[label] = [{"id": r["id"], "role": r["role"], "tool_name": r["tool_name"] or "",
                           "when": time.strftime("%Y-%m-%d %H:%M", time.localtime(float(r["timestamp"])))
                           if r["timestamp"] else "-", "preview": r["preview"] or ""} for r in rows]
    except sqlite3.Error as exc:
        out["error"] = str(exc)
    finally:
        con.close()
    return out


def _error_digest(home: Path, limit: int = 8) -> dict:
    """Group errors.log lines by their normalised message so repeats collapse into one row."""
    path = home / "logs" / "errors.log"
    out = {"path": str(path), "lines": 0, "levels": {}, "top": [], "last": ""}
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return out
    groups: dict[str, dict] = {}
    for line in text.splitlines():
        if not line.strip():
            continue
        out["lines"] += 1
        m = re.match(r"^(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d),\d+ (\w+)", line)
        if not m:
            continue
        when, level = m.group(1), m.group(2)
        out["levels"][level] = out["levels"].get(level, 0) + 1
        body = re.sub(r"\[[\w-]+\]\s*", "", line[m.end():].strip())
        body = re.sub(r"\d+", "N", body)[:170]
        g = groups.get(body)
        if g is None:
            g = groups[body] = {"message": body, "n": 0, "level": level, "last": when,
                                "sample": line[m.end():].strip()[:220]}
        g["n"] += 1
        if when > g["last"]:
            g["last"] = when
            g["sample"] = line[m.end():].strip()[:220]
        if level == "ERROR":
            g["level"] = "ERROR"
        out["last"] = max(out["last"], when)
    out["top"] = sorted(groups.values(), key=lambda g: (g["level"] != "ERROR", -g["n"]))[:limit]
    return out


def insights_report(name: str, limit: int = 15) -> dict:
    """Activity, tool usage, context/compression health and the error digest of one project.

    Also carries the prompt-cache analytics (``cache``) and the raw series the Activity rundown
    needs: ``daily`` (every day with messages, ascending, bounded to 5 years) and ``hourly``
    (messages per hour per day for the recent months, so a single day can be broken down).
    """
    home = profile_home(name)
    out: dict = {"project": name, "activity": [], "hours": [0] * 24, "tools": [],
                 "context": [], "errors": _error_digest(home), "sessions": 0, "messages": 0,
                 "live": sorted(_live_session_ids(name)), "daily": [], "hourly": [],
                 "cache": None}
    con = _sqlite_ro(home / "state.db")
    if con is None:
        out["cache"] = cache_analytics(name)
        return out
    try:
        for r in con.execute(
                "select date(timestamp, 'unixepoch', 'localtime') d, count(*) n,"
                " sum(role = 'user') u, sum(role = 'assistant') a, sum(role = 'tool') t,"
                " sum(coalesce(token_count, 0)) msg_tokens from messages where timestamp is not null"
                " group by d order by d desc limit ?", (USAGE_DAYS,)):
            out["activity"].append({"day": r["d"], "messages": r["n"], "user": r["u"],
                                    "assistant": r["a"], "tool": r["t"], "token": r["msg_tokens"]})
        # The full per-day series, newest 5 years, flipped to ascending: the rundown buckets it
        # into weeks, months and years in the browser, so the SQL stays one cheap group-by.
        for r in con.execute(
                "select date(timestamp, 'unixepoch', 'localtime') d, count(*) n,"
                " sum(role = 'user') u, sum(role = 'assistant') a, sum(role = 'tool') t,"
                " sum(coalesce(token_count, 0)) msg_tokens,"
                " sum(case when tool_name is not null and tool_name <> '' then 1 else 0 end) calls"
                " from messages where timestamp is not null group by d order by d desc limit 1825"):
            out["daily"].append({"day": r["d"], "messages": r["n"], "user": r["u"],
                                 "assistant": r["a"], "tool": r["t"], "token": r["msg_tokens"],
                                 "calls": r["calls"]})
        out["daily"].reverse()
        for r in con.execute(
                "select date(timestamp, 'unixepoch', 'localtime') d,"
                " cast(strftime('%H', timestamp, 'unixepoch', 'localtime') as integer) h,"
                " count(*) n, sum(coalesce(token_count, 0)) tok from messages"
                " where timestamp is not null and timestamp >= strftime('%s', 'now') - ?"
                " group by d, h order by d asc", (180 * 86400,)):
            out["hourly"].append({"day": r["d"], "hour": r["h"], "messages": r["n"],
                                  "token": r["tok"]})
        for r in con.execute(
                "select strftime('%H', timestamp, 'unixepoch', 'localtime') h, count(*) n"
                " from messages where timestamp is not null group by h"):
            try:
                out["hours"][int(r["h"])] = r["n"]
            except (TypeError, ValueError):
                pass
        for r in con.execute(
                "select tool_name, count(*) n, max(timestamp) last from messages"
                " where tool_name is not null and tool_name <> '' group by tool_name"
                " order by n desc limit ?", (limit,)):
            out["tools"].append({"tool": r["tool_name"], "n": r["n"],
                                 "last": time.strftime("%Y-%m-%d %H:%M", time.localtime(r["last"]))
                                 if r["last"] else "-"})
        # Column names drift between engine versions (compression_fallback_streak vs ..._failure_...),
        # so project only the columns this DB actually has instead of hard-coding a schema.
        have = {r[1] for r in con.execute("pragma table_info(sessions)")}
        want = [c for c in ("id", "title", "model", "message_count", "api_call_count", "input_tokens",
                            "output_tokens", "cache_read_tokens", "reasoning_tokens", "last_activity_at",
                            "started_at", "compression_ineffective_count", "compression_fallback_streak",
                            "compression_recovery_deadline", "handoff_state", "profile_name") if c in have]
        cols = ", ".join("s." + c for c in want)
        for r in con.execute(
                f"select {cols},"
                " (select sum(coalesce(token_count, 0)) from messages m where m.session_id = s.id) msg_tokens"
                " from sessions s order by s.last_activity_at desc limit ?", (limit,)):
            row = dict(r)
            row["when"] = time.strftime("%Y-%m-%d %H:%M", time.localtime(row["last_activity_at"])) if row.get("last_activity_at") else "-"
            out["context"].append(row)
        out["sessions"] = con.execute("select count(*) from sessions").fetchone()[0]
        out["messages"] = con.execute("select count(*) from messages").fetchone()[0]
    except sqlite3.Error as exc:
        out["error"] = str(exc)
    finally:
        con.close()
    out["cache"] = cache_analytics(name)
    return out


SOUL_MAX_TEXT = 200_000          # the engine reads SOUL.md whole; a sane cap for the panel too


def engine_error(text: str) -> str:
    """The first error line the engine printed, or "" when the output looks clean.

    `hermes tools disable no_such_tool` and `hermes skills uninstall <builtin>` both exit 0 while
    printing `✗ Unknown toolset ...` / `Error: ... is not a hub-installed skill`. Trusting the return
    code alone would report a failed action as a success in the panel.
    """
    for line in (text or "").splitlines():
        low = line.strip().lower()
        if low.startswith("error") or low.startswith("✗") or "not a hub-installed skill" in low:
            return line.strip()[:200]
    return ""


def skills_report(name: str) -> dict:
    """Installed skills of one project, as the engine itself lists them.

    The engine owns install/uninstall and knows builtin vs local vs hub, so herman asks it
    (``hermes -p <name> skills list``) instead of guessing from the skills directory: the answer then
    matches what the agent will actually load.
    """
    ensure_profile(name)
    res = run_hermes(["skills", "list"], name, quiet=True)
    rows: list[dict] = []
    for line in (res.stdout or "").splitlines():
        if "│" not in line:
            continue
        cells = [c.strip() for c in line.strip().strip("│").split("│")]
        if len(cells) < 5 or cells[0] in ("Name", "") or set(cells[0]) <= set("─━"):
            continue
        rows.append({"name": cells[0], "category": cells[1], "source": cells[2],
                     "trust": cells[3], "status": cells[4]})
    return {"project": name, "rows": rows, "count": len(rows),
            "home": str(profile_home(name) / "skills"),
            "error": "" if res.returncode == 0 else (res.stderr or res.stdout or "skills list failed").strip()[:300]}


def remove_skill(name: str, skill: str, *, dry: bool = False) -> dict:
    """Delete a LOCAL skill folder, after archiving it into herman's own cache.

    Only skills the engine lists as ``local`` are touched: builtin ones live in the install tree and
    are never deleted from the panel, and hub-installed ones belong to ``hermes skills uninstall``
    (the engine tracks them). The folder must sit inside the profile's skills tree, so a crafted name
    can never reach out of it.
    """
    ensure_profile(name)
    rows = {r["name"]: r for r in skills_report(name)["rows"]}
    row = rows.get(skill)
    if not row:
        return {"ok": False, "error": f"no skill named '{skill}' in this project"}
    if row.get("source") != "local":
        return {"ok": False, "error": f"'{skill}' is {row.get('source')}: builtin skills are never "
                                      "deleted from here, hub ones go through `hermes skills uninstall`"}
    root = profile_home(name) / "skills"
    if not root.is_dir():
        return {"ok": False, "error": f"{root} does not exist"}
    hits = [p for p in root.rglob("SKILL.md")
            if p.parent.name == skill and p.parent != root
            and root.resolve() in p.resolve().parents]
    if not hits:
        return {"ok": False, "error": f"no folder for skill '{skill}' inside {root}"}
    folder = hits[0].parent
    if dry:
        return {"ok": True, "path": str(folder), "backup": "", "dry": True}
    bdir = HERMAN_CACHE / "skill-backups"
    try:
        bdir.mkdir(parents=True, exist_ok=True)
        bdir.chmod(0o700)
    except OSError:
        pass
    tar_path = bdir / f"{skill}-{time.strftime('%Y%m%d-%H%M%S')}.tar.gz"
    try:
        with tarfile.open(tar_path, "w:gz") as tf:
            tf.add(folder, arcname=folder.name)
        tar_path.chmod(0o600)
        shutil.rmtree(folder)
    except (OSError, tarfile.TarError) as exc:
        return {"ok": False, "error": str(exc)}
    return {"ok": True, "path": str(folder), "backup": tar_path.name, "dry": False}


def tools_report(name: str) -> dict:
    """Toolsets of one project with their enabled/disabled state (`hermes tools list`)."""
    ensure_profile(name)
    res = run_hermes(["tools", "list"], name, quiet=True)
    sections: list[dict] = []
    cur: dict | None = None
    for line in (res.stdout or "").splitlines():
        stripped = line.strip()
        if stripped.endswith(":") and "toolset" in stripped.lower():
            cur = {"title": stripped[:-1], "tools": []}
            sections.append(cur)
            continue
        m = re.match(r"\s*([✓✗])\s+(enabled|disabled)\s+([A-Za-z0-9_:.-]+)\s*(.*)$", line)
        if m and cur is not None:
            cur["tools"].append({"name": m.group(3), "enabled": m.group(1) == "✓",
                                 "label": m.group(4).strip()})
    return {"project": name, "sections": sections,
            "count": sum(len(sec["tools"]) for sec in sections),
            "error": "" if res.returncode == 0 else (res.stderr or res.stdout or "tools list failed").strip()[:300]}


def soul_path(name: str) -> Path:
    """``SOUL.md`` of a project: identity slot #1 in Hermes' system prompt (per profile)."""
    return profile_home(name) / "SOUL.md"


def soul_report(name: str) -> dict:
    ensure_profile(name)
    p = soul_path(name)
    try:
        exists = p.exists()
        text = p.read_text(encoding="utf-8", errors="replace") if exists else ""
        size = p.stat().st_size if exists else 0
    except OSError as exc:
        return {"project": name, "path": str(p), "exists": False, "size": 0, "text": "",
                "truncated": False, "backup": "", "error": str(exc)}
    return {"project": name, "path": str(p), "exists": exists, "size": size,
            "text": text[:SOUL_MAX_TEXT], "truncated": len(text) > SOUL_MAX_TEXT,
            "backups": len(list(p.parent.glob(p.name + ".herman-backup-*"))), "error": ""}


def save_soul(name: str, text: str, *, dry: bool = False) -> dict:
    """Write the project's SOUL.md, keeping a timestamped copy of the old one first."""
    ensure_profile(name)
    p = soul_path(name)
    if len(text.encode("utf-8")) > SOUL_MAX_TEXT:
        return {"ok": False, "error": f"SOUL.md is limited to {SOUL_MAX_TEXT} bytes by this panel"}
    if dry:
        return {"ok": True, "path": str(p), "size": len(text.encode('utf-8')), "backup": "", "dry": True}
    backup = _backup_file(p) if p.exists() else None
    if backup is not None:
        try:
            backup.chmod(0o600)      # SOUL.md is private text: its copy stays owner-only too
        except OSError:
            pass
    try:
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(text, encoding="utf-8")
        p.chmod(0o600)               # the engine keeps SOUL.md owner-only: match it
    except OSError as exc:
        return {"ok": False, "error": str(exc)}
    return {"ok": True, "path": str(p), "size": p.stat().st_size,
            "backup": backup.name if backup else "", "dry": False}


def _ssh_config_path() -> Path:
    return Path.home() / ".ssh" / "config"


def _backup_file(path: Path) -> Path | None:
    if not path.exists():
        return None
    bak = path.with_name(f"{path.name}.herman-backup-{time.strftime('%Y%m%d-%H%M%S')}")
    try:
        shutil.copy2(path, bak)
        return bak
    except OSError:
        return None


def access_revoke(kind: str, target: str, *, assume_yes: bool = False,
                  dry: bool = False) -> bool:
    """Revoke one piece of access. Returns True when something changed."""
    ssh_dir = Path.home() / ".ssh"
    if kind == "agent":
        key = Path(target).expanduser()
        if not key.exists():
            die(f"key file not found: {key}")
        if dry:
            print(dim(f"  [dry-run] ssh-add -d {key}"))
            return True
        res = run(["ssh-add", "-d", str(key)], capture=True)
        if res.returncode == 0:
            ok(f"removed {key.name} from the ssh-agent")
            return True
        warn((res.stderr or res.stdout or "ssh-add failed").strip())
        return False
    if kind == "key":
        key = Path(target).expanduser()
        if not key.exists():
            die(f"key file not found: {key}")
        if not confirm(f"Delete SSH key {key.name} (and its .pub)? This cannot be undone.",
                       phrase=key.name, assume_yes=assume_yes):
            warn("cancelled")
            return False
        if dry:
            print(dim(f"  [dry-run] rm {key} {key}.pub"))
            return True
        pub = key.with_name(key.name + ".pub")
        for f in (key, pub):
            try:
                if f.exists():
                    f.unlink()
            except OSError as exc:
                warn(f"could not delete {f}: {exc}")
        ok(f"deleted {key.name}" + (" and its .pub" if pub.exists() is False else ""))
        return True
    if kind == "host":
        cfg = _ssh_config_path()
        if not cfg.exists():
            die("no ~/.ssh/config to edit")
        lines = cfg.read_text(encoding="utf-8", errors="replace").splitlines()
        out, skip, removed = [], False, False
        for line in lines:
            s = line.strip()
            if s.lower().startswith("host "):
                names = s.split(None, 1)[1].split()
                skip = target in names
                if skip:
                    removed = True
                    continue
            if skip and (s.lower().startswith(("hostname", "user", "identityfile",
                                               "port", "proxyjump", "forwardagent")) or not s):
                continue
            skip = False if skip and s.lower().startswith("host ") else skip
            out.append(line)
        if not removed:
            die(f"host '{target}' not found in ~/.ssh/config")
        if not confirm(f"Remove host '{target}' from ~/.ssh/config?",
                       phrase=target, assume_yes=assume_yes):
            warn("cancelled")
            return False
        if dry:
            print(dim(f"  [dry-run] rewrite {cfg} without host {target}"))
            return True
        bak = _backup_file(cfg)
        cfg.write_text("\n".join(out).rstrip("\n") + "\n", encoding="utf-8")
        ok(f"host '{target}' removed" + (f" (backup: {bak.name})" if bak else ""))
        return True
    if kind == "env":
        home = profile_home(target) if target in list_profiles() else Path(target).expanduser()
        var = os.environ.pop("HERMAN_ENV_VAR", "")
        env_file = home / ".env"
        if not env_file.exists():
            die(f"{env_file} does not exist")
        names = [k["name"] for k in _env_names(env_file)]
        if var not in names:
            die(f"variable '{var}' not found in {env_file}")
        if not confirm(f"Remove {var} from {env_file}?", phrase=var, assume_yes=assume_yes):
            warn("cancelled")
            return False
        if dry:
            print(dim(f"  [dry-run] drop {var} from {env_file}"))
            return True
        bak = _backup_file(env_file)
        lines = [ln for ln in env_file.read_text(encoding="utf-8", errors="replace").splitlines()
                 if not ln.strip().startswith(f"{var}=")]
        env_file.write_text("\n".join(lines).rstrip("\n") + "\n", encoding="utf-8")
        ok(f"variable {var} removed" + (f" (backup: {bak.name})" if bak else ""))
        return True
    die(f"unknown revoke kind: {kind}")


def _ensure_host_block(alias: str, hostname: str, user: str, identity: str, *,
                       dry: bool = False) -> str:
    """Append a Host block to ~/.ssh/config unless the alias is already there."""
    cfg = _ssh_config_path()
    existing = cfg.read_text(encoding="utf-8", errors="replace") if cfg.exists() else ""
    if re.search(rf"^Host\s+{re.escape(alias)}\s*$", existing, re.M):
        return f"host '{alias}' already in ~/.ssh/config"
    block = [f"Host {alias}", f"    HostName {hostname}"]
    if user:
        block.append(f"    User {user}")
    if identity:
        block.append(f"    IdentityFile {identity}")
    if dry:
        print(dim("  [dry-run] append to ~/.ssh/config:\n    " + "\n    ".join(block)))
        return "dry-run"
    _backup_file(cfg)
    with open(cfg, "a", encoding="utf-8") as fh:
        fh.write("\n" + "\n".join(block) + "\n")
    cfg.chmod(0o600)
    return f"host '{alias}' added to ~/.ssh/config"


def _askpass_helper(directory: Path) -> Path:
    """Executable ssh calls for the password when there is no terminal to type on."""
    helper = directory / "herman-askpass"
    helper.write_text('#!/bin/sh\nprintf "%s\\n" "$HERMAN_SSH_PASSWORD"\n', encoding="utf-8")
    helper.chmod(0o700)
    return helper


def access_grant(user: str, host: str, *, password: str | None = None,
                 dry: bool = False) -> tuple[str, str, list[str]]:
    """Set up SSH access to user@host: create or reuse a key, write the ssh-config
    entry, install the public key with ssh-copy-id.

    Only a username and a host are needed; everything else is derived. Returns
    (state, message, steps) with state in ok | need_password | error. A supplied
    password travels in the askpass environment only, never on a command line
    (argv is visible to every user on the machine through ps).
    """
    steps: list[str] = []
    user = (user or "").strip()
    host = (host or "").strip()
    if not re.fullmatch(r"[A-Za-z0-9._-]+", user):
        return "error", "username: letters, digits, dot, dash, underscore", steps
    if not re.fullmatch(r"[A-Za-z0-9._:-]+", host):
        return "error", "host: letters, digits, dot, dash, colon", steps
    if not shutil.which("ssh-copy-id"):
        return "error", "ssh-copy-id is not installed", steps
    ssh_dir = Path.home() / ".ssh"
    ssh_dir.mkdir(mode=0o700, exist_ok=True)
    key = ssh_dir / f"id_ed25519_{host}"
    if dry:
        print(dim(f"  [dry-run] ssh-keygen -t ed25519 -f {key} -N ''   (only if missing)"))
        print(dim(f"  [dry-run] ssh-copy-id -i {key}.pub {user}@{host}"))
        return "ok", "dry-run", steps
    if key.exists():
        steps.append(f"reusing {key.name}")
    else:
        if not shutil.which("ssh-keygen"):
            return "error", "ssh-keygen is not installed", steps
        res = run(["ssh-keygen", "-t", "ed25519", "-f", str(key), "-C", f"{user}@{host}", "-N", ""],
                  capture=True)
        if res.returncode != 0:
            return "error", (res.stderr or res.stdout or "").strip(), steps
        key.chmod(0o600)
        steps.append(f"created {key.name}")
    steps.append(_ensure_host_block(host, host, user, str(key)))
    cmd = ["ssh-copy-id", "-i", str(key) + ".pub", "-o", "StrictHostKeyChecking=accept-new",
           "-o", "ConnectTimeout=10", "-o", "NumberOfPasswordPrompts=1", f"{user}@{host}"]
    if password is None:
        res = run(cmd + ["-o", "BatchMode=yes"], capture=True, stdin=subprocess.DEVNULL)
        out = ((res.stdout or "") + (res.stderr or "")).strip()
        if res.returncode == 0:
            steps.append("public key installed")
            return "ok", f"key installed on {user}@{host}", steps
        last = (out.splitlines() or [""])[-1][:220]
        if re.search(r"permission denied|password|batch mode|publickey|host key verification",
                     out, re.I):
            return "need_password", last or "the host asks for a password", steps
        return "error", last or "ssh-copy-id failed", steps
    with tempfile.TemporaryDirectory() as td:
        env = dict(os.environ)
        env.update({"SSH_ASKPASS": str(_askpass_helper(Path(td))),
                    "SSH_ASKPASS_REQUIRE": "force",
                    "HERMAN_SSH_PASSWORD": password, "DISPLAY": ":0"})
        env.pop("SSH_TTY", None)
        launcher = ["setsid"] if shutil.which("setsid") else []
        res = run(launcher + cmd, capture=True, env=env, stdin=subprocess.DEVNULL)
    out = ((res.stdout or "") + (res.stderr or "")).strip()
    if res.returncode == 0:
        steps.append("public key installed")
        return "ok", f"key installed on {user}@{host}", steps
    return "error", (out.splitlines() or [""])[-1][:220] or "ssh-copy-id failed", steps


def access_create(kind: str, *, label: str = "", hostname: str = "", user: str = "",
                  port: str = "", identity: str = "", assume_yes: bool = False,
                  dry: bool = False) -> bool:
    """Create a new piece of access (SSH key or ssh-config host entry)."""
    ssh_dir = Path.home() / ".ssh"
    ssh_dir.mkdir(mode=0o700, exist_ok=True)
    if kind == "key":
        if not re.fullmatch(r"[A-Za-z0-9._-]+", label or ""):
            die("label: letters, digits, dot, dash, underscore (e.g. myserver)")
        key = ssh_dir / f"id_ed25519_{label}"
        if key.exists():
            die(f"key already exists: {key}")
        comment = f"{PROG}@{socket.gethostname()}"
        if dry:
            print(dim(f"  [dry-run] ssh-keygen -t ed25519 -f {key} -C {comment} -N ''"))
            return True
        if not confirm(f"Create a new ed25519 key {key.name} (no passphrase)?",
                       assume_yes=assume_yes):
            warn("cancelled")
            return False
        res = run(["ssh-keygen", "-t", "ed25519", "-f", str(key), "-C", comment, "-N", ""],
                  capture=True)
        if res.returncode != 0:
            warn((res.stderr or res.stdout).strip())
            return False
        key.chmod(0o600)
        pub = key.with_name(key.name + ".pub")
        ok(f"key created: {key}")
        if pub.exists():
            print(pub.read_text(encoding="utf-8").strip())
            print(dim(f"  add it to the agent: ssh-add {key}"))
        return True
    if kind == "host":
        if not label or not hostname:
            die("usage: access new-host --alias <alias> --hostname <host> [--user u] [--identity f]")
        cfg = _ssh_config_path()
        block = [f"Host {label}",
                 f"    HostName {hostname}"]
        if user:
            block.append(f"    User {user}")
        if port:
            block.append(f"    Port {port}")
        if identity:
            block.append(f"    IdentityFile {identity}")
        if dry:
            print(dim("  [dry-run] append to ~/.ssh/config:\n    " + "\n    ".join(block)))
            return True
        if not confirm(f"Add host '{label}' ({hostname}) to ~/.ssh/config?",
                       assume_yes=assume_yes):
            warn("cancelled")
            return False
        bak = _backup_file(cfg)
        with open(cfg, "a", encoding="utf-8") as fh:
            fh.write("\n" + "\n".join(block) + "\n")
        cfg.chmod(0o600)
        ok(f"host '{label}' added to ~/.ssh/config"
           + (f" (backup: {bak.name})" if bak else ""))
        return True
    if kind == "agent":
        key = Path(identity).expanduser()
        if not key.exists():
            die(f"key file not found: {key}")
        if dry:
            print(dim(f"  [dry-run] ssh-add {key}"))
            return True
        res = run(["ssh-add", str(key)], capture=True)
        if res.returncode != 0:
            warn((res.stderr or res.stdout).strip())
            return False
        ok(f"{key.name} added to the ssh-agent")
        return True
    die(f"unknown create kind: {kind}")


def access_set_env(project: str, var: str, value: str, *, dry: bool = False) -> bool:
    """Create or update a variable in a project's .env (0600, backed up first)."""
    ensure_profile(project)
    if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", var or ""):
        die("variable name: letters, digits and underscore, not starting with a digit")
    env_file = profile_home(project) / ".env"
    if dry:
        print(dim(f"  [dry-run] set {var} in {env_file}"))
        return True
    env_file.parent.mkdir(parents=True, exist_ok=True)
    bak = _backup_file(env_file)
    lines: list[str] = []
    if env_file.exists():
        lines = [ln for ln in env_file.read_text(encoding="utf-8", errors="replace").splitlines()
                 if not ln.strip().startswith(f"{var}=")]
    lines.append(f"{var}={value}")
    env_file.write_text("\n".join(lines).rstrip("\n") + "\n", encoding="utf-8")
    try:
        env_file.chmod(0o600)
    except OSError:
        pass
    ok(f"{var} set in {env_file}" + (f" (backup: {bak.name})" if bak else ""))
    return True


def _gitcred_path() -> Path:
    return Path.home() / ".git-credentials"


def access_gitcred(kind: str, host: str, *, user: str = "", token: str = "",
                   scheme: str = "https", dry: bool = False) -> bool:
    """Add or remove a stored git credential (~/.git-credentials, backed up)."""
    if not host:
        die("host is required")
    path = _gitcred_path()
    entries: list[str] = []
    if path.exists():
        entries = [ln.strip() for ln in path.read_text(encoding="utf-8", errors="replace")
                   .splitlines() if ln.strip()]

    def host_of(line: str) -> str:
        m = re.match(r"^[a-z]+://(?:[^:@/]+(?::[^@]*)?@)?(.+)$", line)
        return (m.group(1) if m else line).rstrip("/")

    kept = [ln for ln in entries if host_of(ln) != host.rstrip("/")]
    if kind == "remove":
        if len(kept) == len(entries):
            warn(f"no stored credential for {host}")
            return False
        if dry:
            print(dim(f"  [dry-run] drop the {host} entry from {path}"))
            return True
        bak = _backup_file(path)
        path.write_text("\n".join(kept).rstrip("\n") + ("\n" if kept else ""), encoding="utf-8")
        try:
            path.chmod(0o600)
        except OSError:
            pass
        ok(f"stored credential for {host} removed" + (f" (backup: {bak.name})" if bak else ""))
        return True
    if kind == "add":
        if not user or not token:
            die("user and token are required")
        if dry:
            print(dim(f"  [dry-run] store {scheme}://{user}:***@{host} in {path}"))
            return True
        bak = _backup_file(path)
        kept.append(f"{scheme}://{user}:{token}@{host}")
        path.write_text("\n".join(kept).rstrip("\n") + "\n", encoding="utf-8")
        try:
            path.chmod(0o600)
        except OSError:
            pass
        ok(f"credential stored for {user}@{host} ({scheme})"
           + (f" (backup: {bak.name})" if bak else ""))
        return True
    die(f"unknown gitcred action: {kind}")


def access_edit_host(alias: str, *, hostname: str = "", user: str = "", identity: str = "",
                     port: str = "", dry: bool = False) -> bool:
    """Update an existing Host block in ~/.ssh/config in place."""
    cfg = _ssh_config_path()
    if not cfg.exists():
        die("no ~/.ssh/config to edit")
    if not alias:
        die("alias is required")
    lines = cfg.read_text(encoding="utf-8", errors="replace").splitlines()
    out: list[str] = []
    inside = False
    found = False
    keys = {"hostname": hostname, "user": user, "identityfile": identity, "port": port}
    caps = {"hostname": "HostName", "user": "User", "identityfile": "IdentityFile", "port": "Port"}
    written: set[str] = set()
    for line in lines:
        s = line.strip()
        if s.lower().startswith("host "):
            if inside and found:
                for k, val_ in keys.items():
                    if val_ and k not in written:
                        out.append(f"    {caps[k]} {val_}")
                        written.add(k)
            inside = alias in s.split(None, 1)[1].split()
            found = found or inside
            out.append(line)
            continue
        if inside:
            low = s.lower()
            matched = next((k for k in keys if low.startswith(k + " ")), None)
            if matched:
                if keys[matched]:
                    out.append(f"    {caps[matched]} {keys[matched]}")
                    written.add(matched)
                continue
        out.append(line)
    if inside and found:
        for k, val_ in keys.items():
            if val_ and k not in written:
                out.append(f"    {caps[k]} {val_}")
    if not found:
        die(f"host '{alias}' not found in ~/.ssh/config (add it with: {PROG} access new-host)")
    if dry:
        print(dim(f"  [dry-run] update host {alias} in {cfg}"))
        return True
    bak = _backup_file(cfg)
    cfg.write_text("\n".join(out).rstrip("\n") + "\n", encoding="utf-8")
    ok(f"host '{alias}' updated" + (f" (backup: {bak.name})" if bak else ""))
    return True


def print_git_report(rep: dict):
    lines: list[str] = []
    if not rep["repo"]:
        lines.append(amber(rep["msg"] or "no repository"))
        if rep["workdir"]:
            lines.append(dim(f"workdir: {rep['workdir']}"))
        lines += ["", f"create one:  {PROG} git {rep['project']} init",
                  f"set workdir: {PROG} -C {rep['project']} <path>"]
        print_frame(f"git · {rep['project']}", lines, color=amber, width=min(term_width(), 96))
        return
    lines += [
        f"repository : {rep['root']}",
        f"branch     : {(rep['branch'] or '(no commits yet)')}"
        + (f"   ahead {rep['ahead']} / behind {rep['behind']}" if rep["ahead"] is not None else ""),
        f"changes    : {rep['dirty']} file(s) not committed",
        f"last commit: {rep['last_commit'] or '-'}",
        f"git user   : {rep['user_name'] or '(unset)'} <{rep['user_email'] or '-'}>",
        f"helper     : {rep['helper'] or '(unset)'}",
    ]
    if rep.get("remotes"):
        for r in rep["remotes"]:
            lines.append(f"remote     : {r['name']} → {r['url']}")
    else:
        lines.append("remote     : (none)")
    print_frame(f"git · {rep['project']}", lines, color=blue, width=min(term_width(), 96))


def print_access_report(rep: dict):
    w = min(term_width(), 104)
    keys = [f"{k['name']:<34} {'set' if k['set'] else 'empty'}" for k in rep["api_keys"]] or \
        [dim("no .env in this project (keys may come from the shell environment)")]
    for e in rep.get("engine_keys") or []:
        keys.append(f"{e['name']:<34} {e['source']}  {e['masked']}")
    print_frame(f"api keys · {rep['project']}", keys, color=green, width=w)

    ssh_lines = []
    for k in rep["ssh_keys"]:
        loaded = any(a["fingerprint"] == k["fingerprint"] for a in rep["agent"])
        ssh_lines.append(f"{k['name']:<22} {k['bits']:<4} {k['fingerprint']}  {k['perm']}"
                         + (green("  [in agent]") if loaded else ""))
    print()
    print_frame("ssh keys on this machine",
                ssh_lines or [dim("no private keys found in ~/.ssh")], color=blue, width=w)

    print()
    print_frame("ssh-agent identities",
                [f"{a['bits']:<4} {a['fingerprint']}  {a['comment']}" for a in rep["agent"]]
                or [dim("agent empty or not reachable")], color=blue, width=w)

    print()
    print_frame("hosts in ~/.ssh/config",
                [f"{h['alias']:<18} {h['hostname'] or '-':<26} user={h['user'] or '-'}"
                 f"  identity={h['identity'] or '-'}" for h in rep["hosts"]]
                or [dim("no host entries")] + [dim(f"known_hosts entries: {rep['known_hosts']}")],
                color=blue, width=w)

    git_lines = [f"helper    : {rep['git']['helper'] or '(unset)'}"]
    for c in rep["git"]["credentials"]:
        git_lines.append(f"stored    : {c['host']:<28} user={c['user']} ({c['scheme']})")
    gr = rep["git_report"]
    if gr["repo"]:
        git_lines.append(f"workdir   : {gr['root']}  [{gr['branch'] or 'no commits yet'}]")
        git_lines.append(f"remote    : {gr['remote'] or '-'}")
    else:
        git_lines.append(dim(f"workdir   : {gr['msg']}"))
    print()
    print_frame("git credentials", git_lines, color=violet if False else blue, width=w)

    print()
    print_frame("live ssh connections", rep["connections"] or [dim("none")],
                color=amber, width=w)

    print()
    print_frame("Access commands", [
        f"revoke : {PROG} access revoke-agent <key> | revoke-key <key> | revoke-host <alias>",
        f"         {PROG} access unset-env <project> <VAR> | gitcred-rm <host>",
        f"create : {PROG} access new-key <label> | new-host --alias a --hostname h",
        f"         {PROG} access set-env <project> <VAR> | gitcred-add <host> <user>",
        f"change : {PROG} access edit-host <alias> [--hostname h] [--user u]",
        "files are backed up before any edit; secrets are never printed back",
    ], color=cyan, width=w)


