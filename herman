        def _stream_action(self, q, method: str = "GET"):
            def only(key: str, default: str = "") -> str:
                return q.get(key, [default])[0]

            action = only("action")
            name = only("name")
            cwd = only("cwd")
            flags = [k for k in ("--clone", "--clone-all", "--no-skills") if k in q]
            tail = ["--plain"]

            # Values from the query end up in the argv of a child hermes/herman process, so a value
            # that looks like a flag could turn "delete matching" into "delete all". Shapes live in
            # SHAPE_RULES (each one carries the sentence shown on a mismatch), secrets are exempt
            # (they travel through the environment).
            free = ("value", "token", "password")     # secrets never reach argv
            for key, values in q.items():
                if key in ("t", "action", "confirm") or key.startswith("--") or key in free:
                    continue
                for raw in values:
                    value = "" if raw is None else str(raw)
                    if len(value) > 400 or any(ord(ch) < 32 for ch in value):
                        self._json({"error": f"parameter '{key}' is too long or carries control "
                                             f"characters: 400 characters at most, and no control "
                                             f"characters at all"}, 400)
                        return
                    if value.startswith("-"):
                        self._json({"error": f"parameter '{key}' may not start with a dash: the child "
                                             f"process would read it as a command line flag and could "
                                             f"change what the command does (a dash inside the value "
                                             f"is fine)"}, 400)
                        return
                    rule = SHAPE_RULES.get(key)
                    if value and rule and not re.fullmatch(rule["re"], value):
                        self._json({"error": shape_error(key, value, rule)}, 400)
                        return

            # Reading actions may stream over GET; anything that writes state must be POST, so a
            # prefetch, an <img> tag or a stray link can never mutate the machine.
            mutating = {
                "create", "remove", "backup", "backup-all", "tidy", "tidy-all", "sync", "kill",
                "kill-session", "history-delete-message", "history-delete-session",
                "history-delete-matching", "history-delete-all", "cwd", "git-init",
                "git-set-workdir", "git-set-user", "git-set-remote", "git-rm-remote",
                "git-set-helper", "access-set-env", "access-unset-env", "access-new-key",
                "access-revoke-key", "access-add-agent", "access-revoke-agent",
                "access-gitcred-add", "access-gitcred-rm", "model-set-endpoint",
                "rename", "config-set", "config-remove",
            }
            if action in mutating and method != "POST":
                self._json({"error": f"'{action}' changes state: send it with POST"}, 405)
                return

            mapping = {
                "info": lambda: ["-i", name] + tail,
                "backup": lambda: (["-b", name] if name else ["-b", "--all"]) + tail,
                "backup-all": lambda: ["-b", "--all"] + tail,
                "tidy": lambda: ["--tidy", name or "--all"] + tail,
                "tidy-all": lambda: ["--tidy", "--all"] + tail,
                "usage": lambda: (["--usage", name] if name else ["--usage"]) + tail,
                "logs": lambda: ["--logs", name, "-n", "60"] + tail,
                "audit": lambda: (["--audit", name] if name else ["--audit"]) + tail,
                "doctor": lambda: (["-d", name] if name else ["-d", "--all"]) + tail,
                "doctor-all": lambda: ["-d", "--all"] + tail,
                "remove": lambda: ["-r", name, "-y"] + tail,
                "create": lambda: ["-p", name] + flags + tail,
                "rename": lambda: ["--rename", name, only("new_name")] + tail,
                "list": lambda: ["-l"] + tail,
                "cwd": lambda: ["-C", name] + ([cwd] if cwd else []) + tail,
                "model": lambda: ["model", name] + tail,
                "model-set": lambda: (["model", name, "--set", only("model")] + tail),
                "model-set-endpoint": lambda: (["model", name, "--endpoint", only("target")]
                                               + (["--provider", only("provider")]
                                                  if only("provider") else []) + tail),
                "model-probe": lambda: (["model", name, "--probe", only("target")] + tail),
                "git": lambda: ["git", name] + tail,
                "access": lambda: ["access", name] + tail,
                "sync": lambda: ["sync", "--fix"] + tail,
                "kill": lambda: ["kill", name, "-y"] + tail,
                "kill-session": lambda: ["kill", name, "--session", only("session"), "-y"] + tail,
                "history-stats": lambda: ["history", name, "--stats"] + tail,
                "history-delete-message": lambda: ["history", name, "--delete-message", only("id"), "-y"] + tail,
                "history-delete-session": lambda: ["history", name, "--delete-session", only("session"), "-y"] + tail,
                "history-delete-matching": lambda: ["history", name, "--delete-matching", only("q"), "-y"] + tail,
                "history-delete-all": lambda: ["history", name, "--delete-all", "-y"] + tail,
                "access-revoke-agent": lambda: ["access", "revoke-agent", only("key")] + tail,
                "access-revoke-key": lambda: ["access", "revoke-key", only("key"), "-y"] + tail,
                "access-unset-env": lambda: ["access", "unset-env", name, only("var")] + tail,
                "access-new-key": lambda: ["access", "new-key", only("label"), "-y"] + tail,
                "access-set-env": lambda: ["access", "set-env", name, only("var")] + tail,
                "access-gitcred-add": lambda: ["access", "gitcred-add", only("host"), only("user")] + tail,
                "access-gitcred-rm": lambda: ["access", "gitcred-rm", only("host"), "-y"] + tail,
                "git-init": lambda: ["git", name, "init"] + tail,
                "git-set-workdir": lambda: ["git", name, "set-workdir", "--path", only("path")] + tail,
                "git-set-user": lambda: ["git", name, "set-user", "--name", only("user_name"),
                                         "--email", only("user_email")] + tail,
                "git-set-remote": lambda: ["git", name, "set-remote", "--remote", only("remote_name"),
                                           "--url", only("url")] + tail,
                "git-rm-remote": lambda: ["git", name, "rm-remote", "--remote", only("remote_name")] + tail,
                "git-set-helper": lambda: ["git", name, "set-helper", "--helper", only("helper")] + tail,
                # The configure board writes one setting per call, into the focus project's own
                # config.yaml / .env. The panel never edits a file itself: it builds the same
                # `herman config` command a person would type, and the CLI does the writing.
                "config": lambda: (["config", name] if name else ["config"]) + tail,
                "config-set": lambda: (["config", name, only("area")]
                                       + ([only("subject")] if only("area") == "chat"
                                          and only("subject") else [])
                                       + ([only("sub")] if only("area") == "mcp"
                                          and only("sub") else [])
                                       + ([only("subject")] if only("area") == "mcp"
                                          and only("subject") else [])
                                       + (["--enable"] if only("state") == "on"
                                          else (["--disable"] if only("state") == "off" else []))
                                       + (["--set", only("set")] if only("set") else [])
                                       + (["--token"] if only("area") == "chat"
                                          and ("token" in q or "value" in q) else [])
                                       + (["--key", only("var")] if only("area") == "web"
                                          and only("var") else [])
                                       + (["--url", only("mcp_url")] if only("mcp_url") else [])
                                       + (["--command", only("mcp_command")] if only("mcp_command") else [])
                                       + (["--args", only("mcp_args")] if only("mcp_args") else [])
                                       + tail),
                "config-remove": lambda: (["config", name, only("area")]
                                          + ([only("sub")] if only("area") == "mcp"
                                             and only("sub") else [])
                                          + ([only("subject")] if only("area") == "mcp"
                                             and only("subject") else [])
                                          + ([only("subject")] if only("area") == "chat"
                                             and only("subject") else [])
                                          + (["--clear-token"] if only("area") == "chat" else [])
                                          + (["--unset-key", only("var")] if only("var") else [])
                                          + ["-y"] + tail),
            }
            # Secrets (API keys, tokens) reach the CLI through HERMAN_SECRET, never argv.
            secret_actions = ("access-set-env", "access-gitcred-add", "config-set")
            if not name and action in ("git-init", "git-set-workdir", "git-set-user", "git-set-remote",
                                       "git-rm-remote", "git-set-helper", "access-set-env",
                                       "model-set", "model-set-endpoint", "model-probe",
                                       "config-set", "config-remove"):
                self._json({"error": "this action requires a project name"}, 400)
                return
            confirm_targets = {
                "access-revoke-key": os.path.basename(only("key")),
                "access-unset-env": only("var"),
                "access-new-key": only("label"),
                "git-rm-remote": only("remote_name"),
                "access-gitcred-rm": only("host"),
                # A rename moves the profile directory, stops its gateway and replaces its wrapper
                # command, so the new name is typed back: a mistyped or prefetched request cannot
                # move a project by accident.
                "rename": only("new_name"),
                # Dropping an MCP server or a stored key changes what the engine will load: the name
                # of what goes is typed back, exactly as the CLI asks for it on a terminal.
                "config-remove": only("subject") or only("var"),
            }
            if action in confirm_targets:
                want = confirm_targets[action]
                if not want:
                    self._json({"error": "target required"}, 400)
                    return
                if only("confirm") != want:
                    self._json({"error": f"confirmation mismatch: type '{want}' to confirm"}, 400)
                    return
            self.send_response(200)
            self.send_header("Content-Type", "text/event-stream; charset=utf-8")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Connection", "close")
            self.end_headers()

            def emit(line: str):
                try:
                    self.wfile.write(f"data: {json.dumps({'line': line})}\n\n".encode())
                    self.wfile.flush()
                except (BrokenPipeError, ConnectionResetError, ConnectionAbortedError):
                    raise SystemExit     # page reloaded: stop streaming quietly

            if action not in mapping:
                # The panel keeps its action table in memory: a panel started before the CLI was
                # updated would otherwise fail with an opaque error instead of telling the operator
                # to restart. Say so plainly and emit it as a normal stream line.
                self._json({"error": f"unknown action '{action}': this panel predates it, "
                                     f"restart with '{PROG} web --stop' then '{PROG} web'"},
                           400)
                return
            args = mapping[action]()
            cmd = [sys.executable, str(THIS_FILE)] + args
            emit("$ " + PROG + " " + " ".join(("'%s'" % a) if " " in a else a for a in args))
            child_env = None
            if action in secret_actions:
                child_env = os.environ.copy()
                child_env["HERMAN_SECRET"] = only("value") or only("token")
            try:
                proc = subprocess.Popen(cmd, stdout=subprocess.PIPE,
                                        stderr=subprocess.STDOUT, text=True, bufsize=1,
                                        env=child_env)
                for line in proc.stdout:            # type: ignore[union-attr]
                    emit(line.rstrip("\n"))
                proc.wait()
                emit(f"[done] exit code {proc.returncode}")
            except Exception as exc:                # pragma: no cover
                emit(f"[failed] {exc}")
            try:
                self.wfile.write(b"event: end\ndata: {}\n\n")
                self.wfile.flush()
            except (BrokenPipeError, ConnectionResetError, ConnectionAbortedError):
                pass

    class PanelServer(ThreadingHTTPServer):
        address_family = socket.AF_INET6 if ":" in host else socket.AF_INET
        daemon_threads = True

        def handle_error(self, request, client_address):
            exc = sys.exc_info()[1]
            if isinstance(exc, (BrokenPipeError, ConnectionResetError, ConnectionAbortedError,
                                SystemExit)):
                return                # client went away (reload/close): expected, keep quiet
            super().handle_error(request, client_address)

    try:
        srv = PanelServer((host, port), Handler)
    except OSError as exc:
        if getattr(exc, "errno", None) == 98:      # EADDRINUSE
            live = [x for x in list_panels() if x["port"] == port]
            if live:
                print(amber(f"a panel is already running on port {port} (pid {live[0]['pid']})"))
                print_panel_url(live[0])
                if open_browser:
                    try:
                        webbrowser.open(panel_url(live[0]))
                    except Exception:
                        pass
                return
            print(amber(f"port {port} is already in use by something else"))
            print(dim(f"  pick another port: {PROG} web --port {port + 1}"))
            sys.exit(1)
        die(f"could not start the panel on {host}:{port}: {exc}")
    allowed_hosts = {"127.0.0.1", "localhost", "[::1]", "::1"}
    if host not in ("", "0.0.0.0", "::"):
        allowed_hosts.add(host)
    srv.allowed_hosts = allowed_hosts
    srv.allowed_origins = ({f"http://{h}:{port}" for h in allowed_hosts}
                           | {f"http://{h}" for h in allowed_hosts})
    HERMAN_CACHE.mkdir(parents=True, exist_ok=True)
    pid_file = pid_file_for(port)
    pid_file.write_text(json.dumps({"pid": os.getpid(), "port": port,
                                    "host": display_host(host), "bind": host}),
                        encoding="utf-8")
    chmod_quiet(pid_file)
    url = f"http://{url_host(display_host(host))}:{port}/?t={token}"
    print_panel_ready({"pid": os.getpid(), "port": port, "host": display_host(host),
                       "url": f"http://{url_host(display_host(host))}:{port}/", "file": pid_file})
    sys.stdout.flush()
    if open_browser:
        try:
            webbrowser.open(url)
        except Exception:
            pass
    def _on_term(_signum, _frame):        # systemd stop / kill: clean shutdown
        raise KeyboardInterrupt

    try:
        signal.signal(signal.SIGTERM, _on_term)
    except (ValueError, OSError):
        pass
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print()
    finally:
        srv.server_close()
        pid_file.unlink(missing_ok=True)
        print(dim("web panel stopped"))


def open_terminal(name: str) -> bool:
    """Open a project session in a new terminal window (panel button).

    The window is started *outside* herman's own cgroup whenever the user manager allows it: the
    panel normally runs as a systemd unit (herman-web.service) with the default KillMode=control-group,
    and that kill mode takes down every process in the cgroup. `start_new_session=True` only detaches
    the session and the process group, NOT the cgroup, so a plain Popen child dies together with the
    panel - restarting the panel closed the session window the user was typing in. A transient
    `systemd-run --user --scope` gives the window its own scope, which a panel restart leaves alone.
    """
    cmd = hermes_cmd([], name)
    candidates = [
        ("terminator", ["terminator", "-x"] + cmd),
        ("gnome-terminal", ["gnome-terminal", "--"] + cmd),
        ("konsole", ["konsole", "-e"] + cmd),
        ("kitty", ["kitty"] + cmd),
        ("alacritty", ["alacritty", "-e"] + cmd),
        ("xterm", ["xterm", "-e"] + cmd),
    ]
    for binary, argv in candidates:
        if shutil.which(binary):
            try:
                subprocess.Popen(_scope_launcher() + argv, stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL, start_new_session=True)
                return True
            except OSError:
                continue
    return False


_SCOPE_OK: bool | None = None


def _scope_launcher() -> list[str]:
    """Argv prefix that puts a child in its own systemd scope, or [] when that is not possible.

    Probed once per process: `systemd-run --user --scope` needs a user manager and XDG_RUNTIME_DIR,
    and a container or a bare session has neither. An empty list keeps the old behaviour instead of
    failing to open the window at all.
    """
    global _SCOPE_OK
    if _SCOPE_OK is None:
        _SCOPE_OK = False
        if shutil.which("systemd-run") and os.environ.get("XDG_RUNTIME_DIR"):
            try:
                probe = subprocess.run(["systemd-run", "--user", "--scope", "--collect", "--quiet",
                                        "/bin/true"],
                                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                       timeout=5)
                _SCOPE_OK = probe.returncode == 0
            except (OSError, subprocess.SubprocessError):
                _SCOPE_OK = False
    return ["systemd-run", "--user", "--scope", "--collect", "--quiet"] if _SCOPE_OK else []


